<UserControl x:Class="Bakery.WPF.Views.ReportDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:loc="clr-namespace:Bakery.Shared.Helpers;assembly=Bakery.Shared"
             Background="#F8FAFC"
             FlowDirection="RightToLeft">
    
    <UserControl.Resources>
        <!-- Conversion of ReportCategoryType to string representation for Breadcrumbs -->
        <Style TargetType="TextBlock" x:Key="BreadcrumbReportTypeStyle">
            <Setter Property="Text" Value="تفاصيل التقرير"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding CategoryType}" Value="Sales">
                    <Setter Property="Text" Value="تقرير المبيعات"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CategoryType}" Value="Production">
                    <Setter Property="Text" Value="تقرير الإنتاج"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CategoryType}" Value="Inventory">
                    <Setter Property="Text" Value="تقرير المخزون"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CategoryType}" Value="Accounts">
                    <Setter Property="Text" Value="تقرير الحسابات"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <!-- ================================================================= -->
        <!-- STATE A: Sub-reports Catalog (Visible when IsCatalogVisible=True)  -->
        <!-- ================================================================= -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCatalogVisible}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Catalog Header -->
                <RowDefinition Height="*"/>    <!-- Catalog Cards Grid -->
            </Grid.RowDefinitions>

            <!-- Catalog Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                <!-- Breadcrumbs & Title -->
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="الرئيسية" FontSize="12" Foreground="#8B5E4C" FontWeight="SemiBold" Cursor="Hand"/>
                        <materialDesign:PackIcon Kind="ChevronLeft" Width="14" Height="14" Foreground="#94A3B8" Margin="6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="التقارير" FontSize="12" Foreground="#8B5E4C" FontWeight="SemiBold" Cursor="Hand"/>
                        <materialDesign:PackIcon Kind="ChevronLeft" Width="14" Height="14" Foreground="#94A3B8" Margin="6,0" VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource BreadcrumbReportTypeStyle}" FontSize="12" Foreground="#94A3B8" FontWeight="SemiBold"/>
                    </StackPanel>
                    
                    <TextBlock Text="{Binding Title}" Style="{StaticResource InventoryPageTitleStyle}"/>
                    <TextBlock Text="اختر التقرير التفصيلي أو الحركة التحليلية التي ترغب في استعراضها."
                               Style="{StaticResource InventoryPageSubtitleStyle}"/>
                </StackPanel>

                <!-- Back button to main directory -->
                <Button DockPanel.Dock="Left" Command="{Binding BackCommand}"
                        Style="{StaticResource InventoryBackButtonStyle}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ArrowRight" Width="18" Height="18" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="رجوع" VerticalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </DockPanel>

            <!-- Cards Catalog Area -->
            <Grid Grid.Row="1">
                <!-- 1. ACCOUNTS CATALOG -->
                <UniformGrid Columns="2" VerticalAlignment="Top">
                    <UniformGrid.Style>
                        <Style TargetType="UniformGrid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CategoryType}" Value="Accounts">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </UniformGrid.Style>

                    <!-- Card 1: Customer Statement -->
                    <Button Command="{Binding NavigateToCustomerStatementCommand}" Style="{StaticResource MaterialDesignFlatButton}" Padding="0" Margin="0,0,24,24" Height="150" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <Border CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Background="White">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Color="#0F172A" Opacity="0.03" ShadowDepth="2" Direction="270"/>
                            </Border.Effect>
                            <Grid>
                                <Border Width="6" HorizontalAlignment="Right" Background="#2563EB" CornerRadius="0,16,16,0"/>
                                <Grid Margin="0,0,6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="54" Height="54" CornerRadius="27" Background="#EFF6FF" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="AccountBoxOutline" Width="28" Height="28" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                        <TextBlock Text="كشف حساب العملاء" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
                                        <TextBlock Text="مراجعة وتصدير حركة الحسابات التفصيلية للعملاء والتحصيل والمدفوعات." FontSize="13" Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <materialDesign:PackIcon Grid.Column="2" Kind="ChevronLeft" Width="22" Height="22" Foreground="#94A3B8" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Button>

                    <!-- Card 2: Supplier Statement -->
                    <Button Command="{Binding NavigateToSupplierStatementCommand}" Style="{StaticResource MaterialDesignFlatButton}" Padding="0" Margin="0,0,24,24" Height="150" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <Border CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Background="White">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Color="#0F172A" Opacity="0.03" ShadowDepth="2" Direction="270"/>
                            </Border.Effect>
                            <Grid>
                                <Border Width="6" HorizontalAlignment="Right" Background="#D97706" CornerRadius="0,16,16,0"/>
                                <Grid Margin="0,0,6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="54" Height="54" CornerRadius="27" Background="#FEF3C7" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="TruckDeliveryOutline" Width="28" Height="28" Foreground="#D97706" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                        <TextBlock Text="كشف حساب الموردين" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
                                        <TextBlock Text="مراجعة حركة فواتير المشتريات ومستحقات الموردين ومواعيد السداد." FontSize="13" Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <materialDesign:PackIcon Grid.Column="2" Kind="ChevronLeft" Width="22" Height="22" Foreground="#94A3B8" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Button>

                    <!-- Card 3: Employee Statement -->
                    <Button Command="{Binding NavigateToEmployeeStatementCommand}" Style="{StaticResource MaterialDesignFlatButton}" Padding="0" Margin="0,0,24,24" Height="150" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <Border CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Background="White">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Color="#0F172A" Opacity="0.03" ShadowDepth="2" Direction="270"/>
                            </Border.Effect>
                            <Grid>
                                <Border Width="6" HorizontalAlignment="Right" Background="#10B981" CornerRadius="0,16,16,0"/>
                                <Grid Margin="0,0,6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="54" Height="54" CornerRadius="27" Background="#D1FAE5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="AccountTieOutline" Width="28" Height="28" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                        <TextBlock Text="كشوف مرتبات وسلف الموظفين" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
                                        <TextBlock Text="تحليل كشوف حسابات الموظفين والرواتب الشهرية والعهد والسلف." FontSize="13" Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <materialDesign:PackIcon Grid.Column="2" Kind="ChevronLeft" Width="22" Height="22" Foreground="#94A3B8" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Button>

                    <!-- Card 4: Generic Trial Balance -->
                    <Button Command="{Binding ShowGenericReportCommand}" Style="{StaticResource MaterialDesignFlatButton}" Padding="0" Margin="0,0,24,24" Height="150" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <Border CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Background="White">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Color="#0F172A" Opacity="0.03" ShadowDepth="2" Direction="270"/>
                            </Border.Effect>
                            <Grid>
                                <Border Width="6" HorizontalAlignment="Right" Background="#8B5E4C" CornerRadius="0,16,16,0"/>
                                <Grid Margin="0,0,6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="54" Height="54" CornerRadius="27" Background="#F5EBE6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="ScaleBalance" Width="28" Height="28" Foreground="#8B5E4C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                        <TextBlock Text="ميزان المراجعة العام" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
                                        <TextBlock Text="استعراض ميزان الحسابات العام والأرصدة الختامية لكافة الدفاتر والعملاء." FontSize="13" Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <materialDesign:PackIcon Grid.Column="2" Kind="ChevronLeft" Width="22" Height="22" Foreground="#94A3B8" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Button>
                </UniformGrid>

                <!-- 2. INVENTORY CATALOG -->
                <UniformGrid Columns="2" VerticalAlignment="Top">
                    <UniformGrid.Style>
                        <Style TargetType="UniformGrid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CategoryType}" Value="Inventory">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </UniformGrid.Style>

                    <!-- Card 1: Inventory Movements -->
                    <Button Command="{Binding NavigateToInventoryMovementsCommand}" Style="{StaticResource MaterialDesignFlatButton}" Padding="0" Margin="0,0,24,24" Height="150" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <Border CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Background="White">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Color="#0F172A" Opacity="0.03" ShadowDepth="2" Direction="270"/>
                            </Border.Effect>
                            <Grid>
                                <Border Width="6" HorizontalAlignment="Right" Background="#3B82F6" CornerRadius="0,16,16,0"/>
                                <Grid Margin="0,0,6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="54" Height="54" CornerRadius="27" Background="#DBEAFE" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="SwapHorizontal" Width="28" Height="28" Foreground="#3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                        <TextBlock Text="حركة الأصناف التفصيلية" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
                                        <TextBlock Text="تتبع حركات الوارد والمنصرف والتالف للمنتجات والمواد الأولية بالمخزن." FontSize="13" Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <materialDesign:PackIcon Grid.Column="2" Kind="ChevronLeft" Width="22" Height="22" Foreground="#94A3B8" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Button>

                    <!-- Card 2: Stock Take -->
                    <Button Command="{Binding NavigateToStockCountCommand}" Style="{StaticResource MaterialDesignFlatButton}" Padding="0" Margin="0,0,24,24" Height="150" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <Border CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Background="White">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Color="#0F172A" Opacity="0.03" ShadowDepth="2" Direction="270"/>
                            </Border.Effect>
                            <Grid>
                                <Border Width="6" HorizontalAlignment="Right" Background="#10B981" CornerRadius="0,16,16,0"/>
                                <Grid Margin="0,0,6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="54" Height="54" CornerRadius="27" Background="#D1FAE5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="ClipboardCheckOutline" Width="28" Height="28" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                        <TextBlock Text="جرد المخزون الفعلي" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
                                        <TextBlock Text="مراجعة وتدوين كشوفات الجرد الفعلي السنوية والدورية ومطابقتها دفترياً." FontSize="13" Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <materialDesign:PackIcon Grid.Column="2" Kind="ChevronLeft" Width="22" Height="22" Foreground="#94A3B8" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Button>

                    <!-- Card 3: Generic Products List -->
                    <Button Command="{Binding ShowGenericReportCommand}" Style="{StaticResource MaterialDesignFlatButton}" Padding="0" Margin="0,0,24,24" Height="150" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <Border CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Background="White">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Color="#0F172A" Opacity="0.03" ShadowDepth="2" Direction="270"/>
                            </Border.Effect>
                            <Grid>
                                <Border Width="6" HorizontalAlignment="Right" Background="#8B5E4C" CornerRadius="0,16,16,0"/>
                                <Grid Margin="0,0,6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="54" Height="54" CornerRadius="27" Background="#F5EBE6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="PackageVariant" Width="28" Height="28" Foreground="#8B5E4C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                        <TextBlock Text="أرصدة وقيمة المخزون الحالي" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
                                        <TextBlock Text="جدول تفصيلي بكميات الأصناف المتوفرة بالفرع وقيمتها المالية الإجمالية." FontSize="13" Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <materialDesign:PackIcon Grid.Column="2" Kind="ChevronLeft" Width="22" Height="22" Foreground="#94A3B8" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Button>
                </UniformGrid>

                <!-- 3. SALES CATALOG -->
                <UniformGrid Columns="2" VerticalAlignment="Top">
                    <UniformGrid.Style>
                        <Style TargetType="UniformGrid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CategoryType}" Value="Sales">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </UniformGrid.Style>

                    <!-- Card 1: Sales Workspace -->
                    <Button Command="{Binding NavigateToSalesWorkspaceCommand}" Style="{StaticResource MaterialDesignFlatButton}" Padding="0" Margin="0,0,24,24" Height="150" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <Border CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Background="White">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Color="#0F172A" Opacity="0.03" ShadowDepth="2" Direction="270"/>
                            </Border.Effect>
                            <Grid>
                                <Border Width="6" HorizontalAlignment="Right" Background="#3B82F6" CornerRadius="0,16,16,0"/>
                                <Grid Margin="0,0,6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="54" Height="54" CornerRadius="27" Background="#DBEAFE" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="MonitorDashboard" Width="28" Height="28" Foreground="#3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                        <TextBlock Text="لوحة المبيعات والفواتير" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
                                        <TextBlock Text="شاشة متكاملة لإصدار ومراجعة فواتير المبيعات والمشتريات وحركة الفروع." FontSize="13" Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <materialDesign:PackIcon Grid.Column="2" Kind="ChevronLeft" Width="22" Height="22" Foreground="#94A3B8" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Button>

                    <!-- Card 2: Generic Sales Register -->
                    <Button Command="{Binding ShowGenericReportCommand}" Style="{StaticResource MaterialDesignFlatButton}" Padding="0" Margin="0,0,24,24" Height="150" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <Border CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Background="White">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Color="#0F172A" Opacity="0.03" ShadowDepth="2" Direction="270"/>
                            </Border.Effect>
                            <Grid>
                                <Border Width="6" HorizontalAlignment="Right" Background="#8B5E4C" CornerRadius="0,16,16,0"/>
                                <Grid Margin="0,0,6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="54" Height="54" CornerRadius="27" Background="#F5EBE6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="ReceiptTextOutline" Width="28" Height="28" Foreground="#8B5E4C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                        <TextBlock Text="حركة فواتير المبيعات التفصيلية" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
                                        <TextBlock Text="سجل تحليلي بحركة المبيعات والمردودات والعملاء والمبالغ الآجلة." FontSize="13" Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <materialDesign:PackIcon Grid.Column="2" Kind="ChevronLeft" Width="22" Height="22" Foreground="#94A3B8" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Button>
                </UniformGrid>

                <!-- 4. PRODUCTION CATALOG -->
                <UniformGrid Columns="2" VerticalAlignment="Top">
                    <UniformGrid.Style>
                        <Style TargetType="UniformGrid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CategoryType}" Value="Production">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </UniformGrid.Style>

                    <!-- Card 1: Production Orders Workspace -->
                    <Button Command="{Binding NavigateToProductionWorkspaceCommand}" Style="{StaticResource MaterialDesignFlatButton}" Padding="0" Margin="0,0,24,24" Height="150" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <Border CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Background="White">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Color="#0F172A" Opacity="0.03" ShadowDepth="2" Direction="270"/>
                            </Border.Effect>
                            <Grid>
                                <Border Width="6" HorizontalAlignment="Right" Background="#10B981" CornerRadius="0,16,16,0"/>
                                <Grid Margin="0,0,6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="54" Height="54" CornerRadius="27" Background="#D1FAE5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Factory" Width="28" Height="28" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                        <TextBlock Text="لوحة أوامر الإنتاج" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
                                        <TextBlock Text="إدارة ومراجعة تشغيل خطوط الإنتاج والكميات والوصفات والمستهلك." FontSize="13" Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <materialDesign:PackIcon Grid.Column="2" Kind="ChevronLeft" Width="22" Height="22" Foreground="#94A3B8" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Button>

                    <!-- Card 2: Generic Production History -->
                    <Button Command="{Binding ShowGenericReportCommand}" Style="{StaticResource MaterialDesignFlatButton}" Padding="0" Margin="0,0,24,24" Height="150" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <Border CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Background="White">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Color="#0F172A" Opacity="0.03" ShadowDepth="2" Direction="270"/>
                            </Border.Effect>
                            <Grid>
                                <Border Width="6" HorizontalAlignment="Right" Background="#8B5E4C" CornerRadius="0,16,16,0"/>
                                <Grid Margin="0,0,6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="54" Height="54" CornerRadius="27" Background="#F5EBE6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="History" Width="28" Height="28" Foreground="#8B5E4C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                        <TextBlock Text="حركة سجل الإنتاج اليومي" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
                                        <TextBlock Text="تقارير تحليلية بالكميات المنتجة ونسب الهدر والمواد المستهلكة." FontSize="13" Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <materialDesign:PackIcon Grid.Column="2" Kind="ChevronLeft" Width="22" Height="22" Foreground="#94A3B8" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Button>
                </UniformGrid>
            </Grid>
        </Grid>

        <!-- ================================================================= -->
        <!-- STATE B: Generic Details Grid (Visible when IsCatalogVisible=False) -->
        <!-- ================================================================= -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCatalogVisible}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Generic Header -->
                <RowDefinition Height="Auto"/> <!-- Validation Banner -->
                <RowDefinition Height="Auto"/> <!-- Filters Card -->
                <RowDefinition Height="Auto"/> <!-- KPI Metrics -->
                <RowDefinition Height="*"/>    <!-- DataGrid or Empty State -->
            </Grid.RowDefinitions>

            <!-- Generic Header Area -->
            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="الرئيسية" FontSize="12" Foreground="#8B5E4C" FontWeight="SemiBold" Cursor="Hand"/>
                        <materialDesign:PackIcon Kind="ChevronLeft" Width="14" Height="14" Foreground="#94A3B8" Margin="6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="التقارير" FontSize="12" Foreground="#8B5E4C" FontWeight="SemiBold" Cursor="Hand"/>
                        <materialDesign:PackIcon Kind="ChevronLeft" Width="14" Height="14" Foreground="#94A3B8" Margin="6,0" VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource BreadcrumbReportTypeStyle}" FontSize="12" Foreground="#8B5E4C" FontWeight="SemiBold" Cursor="Hand"/>
                        <materialDesign:PackIcon Kind="ChevronLeft" Width="14" Height="14" Foreground="#94A3B8" Margin="6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="الكشف التفصيلي" FontSize="12" Foreground="#94A3B8" FontWeight="SemiBold"/>
                    </StackPanel>
                    
                    <TextBlock Text="{Binding Title}" Style="{StaticResource InventoryPageTitleStyle}"/>
                    <TextBlock Text="جدول البيانات العام لتقرير ميزان المراجعة وحركة السجلات."
                               Style="{StaticResource InventoryPageSubtitleStyle}"/>
                </StackPanel>

                <!-- Back button to sub-catalog -->
                <Button DockPanel.Dock="Left" Command="{Binding BackToCatalogCommand}"
                        Style="{StaticResource InventoryBackButtonStyle}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ArrowRight" Width="18" Height="18" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="رجوع" VerticalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </DockPanel>

            <!-- Validation Warning Banner -->
            <Border Grid.Row="1" Visibility="{Binding ValidationMessage, Converter={StaticResource NullToVisibilityConverter}}"
                    Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AlertCircleOutline" Foreground="#D97706" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding ValidationMessage}" Foreground="#92400E" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Filters Card -->
            <Border Grid.Row="2" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowDateFilter}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <materialDesign:PackIcon Kind="CalendarSearch" Width="20" Height="20" Foreground="#8B5E4C" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="تصفية البيانات حسب الفترة:" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="#334155" Margin="0,0,20,0"/>

                        <DatePicker materialDesign:HintAssist.Hint="من تاريخ"
                                    SelectedDate="{Binding StartDate}"
                                    Style="{StaticResource ReportFilterDatePickerStyle}"
                                    Width="180" Margin="0,0,16,0"/>

                        <DatePicker materialDesign:HintAssist.Hint="إلى تاريخ"
                                    SelectedDate="{Binding EndDate}"
                                    Style="{StaticResource ReportFilterDatePickerStyle}"
                                    Width="180"/>
                    </StackPanel>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowDateFilter}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <materialDesign:PackIcon Kind="DatabaseCheckOutline" Width="22" Height="22" Foreground="#8B5E4C" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="كشف متكامل لكافة قيود وبيانات النظام الفعالة حالياً دون شروط زمنية." 
                                   FontSize="14" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="1" Command="{Binding RefreshCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#8B5E4C" BorderBrush="#8B5E4C" Height="40" Padding="24,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="تطبيق الفلتر" VerticalAlignment="Center" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- KPI Cards Row -->
            <Grid Grid.Row="3" Margin="0,0,0,12">
                <UniformGrid Columns="3">
                    <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20" Margin="0,0,24,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="التقرير النشط" FontSize="13" Foreground="#64748B" FontWeight="Bold"/>
                                <TextBlock Text="{Binding ReportName}" FontSize="24" FontWeight="Black" Foreground="#0F172A" Margin="0,8,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="44" Height="44" CornerRadius="22" Background="#F1F5F9" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="FileDocumentOutline" Width="22" Height="22" Foreground="#8B5E4C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20" Margin="0,0,24,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="عدد القيود" FontSize="13" Foreground="#64748B" FontWeight="Bold"/>
                                <TextBlock Text="{Binding GridRows.Count}" FontSize="24" FontWeight="Black" Foreground="#0F172A" Margin="0,8,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="44" Height="44" CornerRadius="22" Background="#F1F5F9" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Database" Width="22" Height="22" Foreground="#0F172A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="الحالة" FontSize="13" Foreground="#64748B" FontWeight="Bold"/>
                                <TextBlock Text="عرض البيانات" FontSize="24" FontWeight="Black" Foreground="#10B981" Margin="0,8,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="44" Height="44" CornerRadius="22" Background="#ECFDF5" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="CheckCircleOutline" Width="22" Height="22" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </UniformGrid>
            </Grid>

            <!-- DataGrid / Empty State Content -->
            <Grid Grid.Row="4">
                <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding GridRows.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <DataGrid ItemsSource="{Binding GridRows}"
                              AutoGenerateColumns="True" 
                              IsReadOnly="True"
                              Background="White" 
                              BorderThickness="0"
                              GridLinesVisibility="All" 
                              VerticalGridLinesBrush="#F1F5F9"
                              HorizontalGridLinesBrush="#E2E8F0"
                              RowHeight="44" 
                              ColumnHeaderHeight="48"
                              EnableRowVirtualization="True"
                              Style="{StaticResource MaterialDesignDataGrid}">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="16,0"/>
                                <Setter Property="Foreground" Value="#334155"/>
                            </Style>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                                <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                <Setter Property="BorderBrush" Value="#F1F5F9"/>
                                <Setter Property="Padding" Value="16,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#EFF6FF"/>
                                        <Setter Property="Foreground" Value="#1D4ED8"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                                <Setter Property="Background" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="AlternationIndex" Value="1">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F1F5F9"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </Border>

                <!-- Empty State -->
                <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,64">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding GridRows.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="96" Height="96" CornerRadius="48" Background="#F1F5F9" HorizontalAlignment="Center" Margin="0,0,0,20">
                            <materialDesign:PackIcon Kind="FolderOpenOutline" Width="44" Height="44" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="لا توجد بيانات لعرضها" FontSize="20" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center"/>
                        <TextBlock Text="لم نعثر على أي سجلات في النطاق الزمني المحدد. يرجى تعديل الفترة الزمنية والضغط على زر تحديث التقرير." 
                                   FontSize="14" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,10,0,0" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="400" LineHeight="20"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>

</UserControl>
