<UserControl x:Class="Bakery.WPF.Views.HealthMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:loc="clr-namespace:Bakery.Shared.Helpers;assembly=Bakery.Shared"
             Background="{DynamicResource MaterialDesignPaper}">
    <StackPanel Margin="20">
        <TextBlock Text="{x:Static loc:Loc.OfflineHealthMonitor}" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
        
        <md:Card Margin="0,0,0,10" Padding="15">
            <StackPanel>
                <TextBlock Text="{x:Static loc:Loc.DatabaseStatus}" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                <TextBlock Text="{Binding DatabaseStatus}" FontSize="16"/>
            </StackPanel>
        </md:Card>

        <md:Card Margin="0,0,0,10" Padding="15">
            <StackPanel>
                <TextBlock Text="{x:Static loc:Loc.LastBackup}" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                <TextBlock Text="{Binding LastBackupDate}" FontSize="16"/>
            </StackPanel>
        </md:Card>

        <md:Card Margin="0,0,0,10" Padding="15">
            <StackPanel>
                <TextBlock Text="{x:Static loc:Loc.PendingRecoveries}" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                <TextBlock Text="{Binding PendingRecoveries}" FontSize="16"/>
            </StackPanel>
        </md:Card>

        <md:Card Margin="0,0,0,10" Padding="15">
            <StackPanel>
                <TextBlock Text="{x:Static loc:Loc.DiskSpace}" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                <TextBlock Text="{Binding DiskSpace}" FontSize="16"/>
            </StackPanel>
        </md:Card>

        <Button Command="{Binding RefreshCommand}" Content="{x:Static loc:Loc.RefreshStatus}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
    </StackPanel>
</UserControl>
