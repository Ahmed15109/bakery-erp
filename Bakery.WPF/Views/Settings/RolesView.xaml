<UserControl x:Class="Bakery.WPF.Views.RolesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#FBF9F7" FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="الأدوار الوظيفية والصلاحيات" FontSize="26" FontWeight="Bold" Foreground="#2D2422"/>
                <TextBlock Text="أنشئ أدواراً قابلة لإعادة الاستخدام وامنح المستخدمين الصلاحيات المناسبة." FontSize="13" Foreground="#8B7E7A" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Command="{Binding AddCommand}" Height="44" Padding="18,0"
                    Style="{StaticResource MaterialDesignRaisedButton}" Background="#8B5E4C" BorderBrush="#8B5E4C"
                    md:ButtonAssist.CornerRadius="10">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="ShieldAccount" Width="19" Height="19" Margin="0,0,7,0"/>
                    <TextBlock Text="إضافة دور" FontWeight="Bold"/>
                </StackPanel>
            </Button>
        </Grid>

        <md:Card Grid.Row="1" UniformCornerRadius="12" Background="White" Padding="14" Margin="0,0,0,16">
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     md:HintAssist.Hint="البحث باسم الدور أو الوصف..." md:TextFieldAssist.HasClearButton="True"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
        </md:Card>

        <md:Card Grid.Row="2" UniformCornerRadius="12" Background="White" Padding="0" md:ElevationAssist.Elevation="Dp2">
            <DataGrid ItemsSource="{Binding Roles}" AutoGenerateColumns="False" CanUserAddRows="False"
                      Style="{StaticResource MaterialDesignDataGrid}" RowHeight="58" Background="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="اسم الدور" Binding="{Binding Name}" Width="220" FontWeight="Bold"/>
                    <DataGridTextColumn Header="الوصف" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="المستخدمون" Binding="{Binding UserCount}" Width="100"/>
                    <DataGridTextColumn Header="الصلاحيات" Binding="{Binding PermissionCount}" Width="100"/>
                    <DataGridTemplateColumn Header="النوع" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="مخصص"/>
                                            <Setter Property="Foreground" Value="#6B625F"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSystem}" Value="True">
                                                    <Setter Property="Text" Value="دور نظام"/>
                                                    <Setter Property="Foreground" Value="#8B5E4C"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="الإجراءات" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" Style="{StaticResource MaterialDesignFlatButton}" Width="36" Height="36" Padding="0" ToolTip="تعديل">
                                        <md:PackIcon Kind="Pencil" Foreground="#8B5E4C"/>
                                    </Button>
                                    <Button Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" Style="{StaticResource MaterialDesignFlatButton}" Width="36" Height="36" Padding="0" ToolTip="حذف">
                                        <md:PackIcon Kind="Delete" Foreground="#D32F2F"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </md:Card>
    </Grid>
</UserControl>
