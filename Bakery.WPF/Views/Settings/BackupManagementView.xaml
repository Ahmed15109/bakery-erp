<UserControl x:Class="Bakery.WPF.Views.BackupManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:auth="clr-namespace:Bakery.WPF.Authorization"
             FlowDirection="RightToLeft"
             Background="#F8F8F8">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#F7EEE8" CornerRadius="14" Padding="18" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="DatabaseCheckOutline" Width="28" Height="28" Foreground="#8B5E3C" VerticalAlignment="Center"/>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="النسخ الاحتياطي واستعادة البيانات" FontSize="22" FontWeight="Bold" Foreground="#2F2925"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#6B625D" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
                <ProgressBar Grid.Column="1" Width="120" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </Border>

        <WrapPanel Grid.Row="1" Margin="0,0,0,16">
            <Button Content="إنشاء نسخة يدوية" Command="{Binding CreateManualCommand}" Margin="0,0,8,8"
                    auth:PermissionAssist.Required="Backup.CreateManual" Style="{StaticResource MaterialDesignRaisedButton}"/>
            <Button Content="استعادة المحدد" Command="{Binding RestoreCommand}" Margin="0,0,8,8"
                    auth:PermissionAssist.Required="Backup.Restore" Style="{StaticResource MaterialDesignOutlinedButton}"/>
            <Button Content="استعادة من ملف" Command="{Binding RestoreFromFileCommand}" Margin="0,0,8,8"
                    auth:PermissionAssist.Required="Backup.Restore" Style="{StaticResource MaterialDesignOutlinedButton}"/>
            <Button Content="حذف النسخة المحلية" Command="{Binding DeleteCommand}" Margin="0,0,8,8"
                    auth:PermissionAssist.Required="Backup.Delete" Style="{StaticResource MaterialDesignOutlinedButton}"/>
            <Button Content="إعادة محاولة الرفع" Command="{Binding RetryUploadCommand}" Margin="0,0,8,8"
                    auth:PermissionAssist.Required="Backup.ConnectGoogleDrive" Style="{StaticResource MaterialDesignOutlinedButton}"/>
            <Button Content="تنزيل من Google Drive" Command="{Binding DownloadCommand}" Margin="0,0,8,8"
                    auth:PermissionAssist.Required="Backup.Restore" Style="{StaticResource MaterialDesignOutlinedButton}"/>
        </WrapPanel>

        <DataGrid x:Name="BackupHistoryGrid" Grid.Row="2" ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  HeadersVisibility="Column" CanUserAddRows="False" Margin="0,0,0,16">
            <DataGrid.Columns>
                <DataGridTextColumn Header="تاريخ الإنشاء" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="150"/>
                <DataGridTextColumn Header="النوع" Binding="{Binding BackupType, Converter={StaticResource EnumToLocConverter}}" Width="110"/>
                <DataGridTextColumn Header="يوم العمل" Binding="{Binding WorkingDayDate}" Width="110"/>
                <DataGridTextColumn Header="الحجم" Binding="{Binding SizeBytes, Converter={StaticResource FileSizeConverter}}" Width="90"/>
                <DataGridTextColumn Header="الحالة المحلية" Binding="{Binding Status, Converter={StaticResource EnumToLocConverter}}" Width="120"/>
                <DataGridTextColumn Header="الحالة السحابية" Binding="{Binding CloudStatus, Converter={StaticResource EnumToLocConverter}}" Width="130"/>
                <DataGridCheckBoxColumn Header="متاح محلياً" Binding="{Binding LocalFileAvailable, Mode=OneWay}" Width="95"/>
                <DataGridCheckBoxColumn Header="متاح سحابياً" Binding="{Binding GoogleDriveAvailable, Mode=OneWay}" Width="95"/>
                <DataGridTextColumn Header="ملخص الخطأ" Binding="{Binding ErrorSummary}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="16"
                auth:PermissionAssist.Required="Backup.ManageSettings">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="إعدادات النسخ الاحتياطي" FontWeight="Bold" FontSize="17"/>
                    <TextBlock Text="{Binding BackupDirectory}" Foreground="#6B625D" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                    <TextBlock Text="يفضل استخدام قرص آخر أو وحدة خارجية." Foreground="#C67C00" Margin="0,4,0,0"
                               Visibility="{Binding IsSameDriveWarning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding GoogleDriveStatus, StringFormat=Google Drive: {0}}" Foreground="#6B625D" Margin="0,4,0,0"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button Content="فتح المجلد" Command="{Binding OpenFolderCommand}" Margin="4"/>
                    <Button Content="تغيير المجلد" Command="{Binding SelectFolderCommand}" Margin="4"/>
                    <Button Content="الافتراضي" Command="{Binding ResetFolderCommand}" Margin="4"/>
                    <Button Content="ربط Google Drive" Command="{Binding ConnectGoogleDriveCommand}" Margin="4"
                            auth:PermissionAssist.Required="Backup.ConnectGoogleDrive"/>
                    <Button Content="فصل Google Drive" Command="{Binding DisconnectGoogleDriveCommand}" Margin="4"
                            auth:PermissionAssist.Required="Backup.DisconnectGoogleDrive"/>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
