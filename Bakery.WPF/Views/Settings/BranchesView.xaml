<UserControl x:Class="Bakery.WPF.Views.BranchesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:loc="clr-namespace:Bakery.Shared.Helpers;assembly=Bakery.Shared"
             Background="#FBF9F7"
             FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="{x:Static loc:Loc.BranchesModule}" FontSize="26" FontWeight="Black" Foreground="#2D2422"/>
                <TextBlock Text="إدارة فروع المؤسسة وتهيئتها" FontSize="13" Foreground="#8B7E7A" Margin="0,2,0,0"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Command="{Binding AddBranchCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#8B5E4C"
                    BorderBrush="#8B5E4C"
                    Height="44"
                    md:ButtonAssist.CornerRadius="10"
                    VerticalAlignment="Bottom">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="DomainPlus" Margin="0,0,6,0" VerticalAlignment="Center" Width="18" Height="18"/>
                    <TextBlock Text="{x:Static loc:Loc.AddBranch}" FontWeight="Bold" FontSize="14"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Metrics/Search Section -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="180" />
            </Grid.ColumnDefinitions>

            <md:Card Grid.Column="0" UniformCornerRadius="12" md:ElevationAssist.Elevation="Dp1" Background="White" Padding="14" Margin="0,0,10,0">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         md:HintAssist.Hint="البحث بالاسم أو الكود..."
                         md:TextFieldAssist.HasClearButton="True"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" />
            </md:Card>

            <md:Card Grid.Column="1" UniformCornerRadius="12" Margin="10,0" md:ElevationAssist.Elevation="Dp1">
                <StackPanel Margin="18,10">
                    <TextBlock Text="إجمالي الفروع" FontSize="11" Foreground="#8B7E7A" FontWeight="Bold"/>
                    <TextBlock Text="{Binding TotalBranches}" FontSize="24" FontWeight="Black" Foreground="#2D2422"/>
                </StackPanel>
            </md:Card>

            <md:Card Grid.Column="2" UniformCornerRadius="12" Margin="10,0,0,0" md:ElevationAssist.Elevation="Dp1">
                <StackPanel Margin="18,10">
                    <TextBlock Text="الفروع النشطة" FontSize="11" Foreground="#8B7E7A" FontWeight="Bold"/>
                    <TextBlock Text="{Binding ActiveBranches}" FontSize="24" FontWeight="Black" Foreground="#2E7D32"/>
                </StackPanel>
            </md:Card>
        </Grid>

        <!-- Branches Grid -->
        <md:Card Grid.Row="2" UniformCornerRadius="12" md:ElevationAssist.Elevation="Dp2" Background="White" Padding="0">
            <DataGrid ItemsSource="{Binding Branches}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      Style="{StaticResource MaterialDesignDataGrid}"
                      Background="Transparent"
                      RowHeight="58"
                      AlternatingRowBackground="#FDFBFA">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{x:Static loc:Loc.CodeLabel}" Binding="{Binding Code}" Width="150" FontWeight="Bold"/>
                    <DataGridTextColumn Header="{x:Static loc:Loc.NameLabel}" Binding="{Binding Name}" Width="*" FontWeight="Bold"/>
                    <DataGridTextColumn Header="{x:Static loc:Loc.NotesLabel}" Binding="{Binding Notes}" Width="2*"/>

                    <DataGridTemplateColumn Header="{x:Static loc:Loc.ColStatus}" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#E8F5E9"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                    <Setter Property="Background" Value="#F5F5F5"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="10" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{x:Static loc:Loc.Active}"/>
                                                <Setter Property="Foreground" Value="#2E7D32"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                        <Setter Property="Text" Value="{x:Static loc:Loc.Inactive}"/>
                                                        <Setter Property="Foreground" Value="#757575"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{x:Static loc:Loc.ColActions}" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <!-- Edit Button -->
                                    <Button Command="{Binding DataContext.EditBranchCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Width="32" Height="32" Padding="0" Margin="2,0"
                                            ToolTip="{x:Static loc:Loc.EditTooltip}">
                                        <md:PackIcon Kind="Pencil" Width="18" Height="18" Foreground="#8B5E4C"/>
                                    </Button>

                                    <!-- Toggle Active Button -->
                                    <Button Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Width="32" Height="32" Padding="0" Margin="2,0"
                                            ToolTip="{x:Static loc:Loc.ToggleActiveTooltip}">
                                        <md:PackIcon Width="18" Height="18" Foreground="#1976D2">
                                            <md:PackIcon.Style>
                                                <Style TargetType="md:PackIcon">
                                                    <Setter Property="Kind" Value="EyeOff"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Kind" Value="Eye"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </md:PackIcon.Style>
                                        </md:PackIcon>
                                    </Button>

                                    <!-- Delete Button -->
                                    <Button Command="{Binding DataContext.DeleteBranchCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Width="32" Height="32" Padding="0" Margin="2,0"
                                            ToolTip="{x:Static loc:Loc.DeleteTooltip}">
                                        <md:PackIcon Kind="Delete" Width="18" Height="18" Foreground="#D32F2F"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </md:Card>
    </Grid>
</UserControl>
