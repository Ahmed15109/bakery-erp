<UserControl x:Class="Bakery.WPF.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:loc="clr-namespace:Bakery.Shared.Helpers;assembly=Bakery.Shared"
             xmlns:auth="clr-namespace:Bakery.WPF.Authorization"
             Background="#F8F8F8"
             FontFamily="Cairo, Segoe UI"
             FlowDirection="RightToLeft"
             Opacity="0">

    <UserControl.Resources>
        <Style x:Key="DashboardCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18"
                                      ShadowDepth="2"
                                      Direction="270"
                                      Opacity="0.08"
                                      Color="#60483B"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryKpiCard" TargetType="Border" BasedOn="{StaticResource DashboardCard}">
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="MinHeight" Value="192"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.56"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QuickActionButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Height" Value="64"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#3A2C25"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="14"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF7F2"/>
                    <Setter Property="Foreground" Value="#8B5E3C"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#F7E8DE"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2F2925"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#7A716C"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="PrimaryMetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2F2925"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Binding.TargetUpdated">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0.35" To="1" Duration="0:0:0.24"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.30"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
        <Grid Margin="24,16,24,32"
              MinWidth="880"
              MaxWidth="1560"
              HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Spacious horizontal dashboard header. -->
            <Border Grid.Row="0"
                    Style="{StaticResource DashboardCard}"
                    Padding="16"
                    MinHeight="112">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="2.4*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{x:Static loc:Loc.Dashboard}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#2F2925"/>
                        <Border Background="#F7EEE8"
                                CornerRadius="12"
                                Padding="8,4"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#D32F2F"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasOpenDay}" Value="True">
                                                    <Setter Property="Fill" Value="#2E7D32"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding CurrentDayStatus}"
                                           FontSize="13"
                                           Foreground="#6D5548"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <UniformGrid Grid.Column="2" Columns="3" Margin="-8,0">
                        <Border Background="#FCFBFA" CornerRadius="12" Padding="8" Margin="8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="40" Height="40" CornerRadius="10" Background="#F3E7DF">
                                    <materialDesign:PackIcon Kind="CalendarTodayOutline"
                                                             Width="20" Height="20"
                                                             Foreground="#8B5E3C"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static loc:Loc.ActiveBusinessDay}" FontSize="12" Foreground="#8A817C"/>
                                    <TextBlock Text="{Binding ActiveBusinessDay}" FontSize="16" FontWeight="Bold" Foreground="#2F2925"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="#FCFBFA" CornerRadius="12" Padding="8" Margin="8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="40" Height="40" CornerRadius="10" Background="#FFF0E6">
                                    <materialDesign:PackIcon Kind="StoreOutline"
                                                             Width="20" Height="20"
                                                             Foreground="#C67C4E"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static loc:Loc.CurrentBranch}" FontSize="12" Foreground="#8A817C"/>
                                    <TextBlock Text="{Binding CurrentBranchName}"
                                               FontSize="16" FontWeight="Bold" Foreground="#2F2925"
                                               MaxWidth="160" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="#F8FBF8" CornerRadius="12" Padding="8" Margin="8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="40" Height="40" CornerRadius="10" Background="#E8F5E9">
                                    <materialDesign:PackIcon Kind="SafeSquareOutline"
                                                             Width="20" Height="20"
                                                             Foreground="#2E7D32"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static loc:Loc.TreasuryBalance}" FontSize="12" Foreground="#8A817C"/>
                                    <TextBlock Text="{Binding TreasuryBalanceText}"
                                               FontSize="16" FontWeight="Bold" Foreground="#2E7D32"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- Four large primary KPIs. -->
            <StackPanel Grid.Row="1" Margin="0,24,0,0">
                <TextBlock Text="{x:Static loc:Loc.TodaysIndicators}" Style="{StaticResource SectionTitle}"/>
                <ItemsControl ItemsSource="{Binding PrimaryMetrics}" Margin="-8,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource PrimaryKpiCard}" IsEnabled="{Binding IsEnabled}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Width="64" Height="64"
                                            CornerRadius="14"
                                            Background="{Binding IconBackground}"
                                            VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="{Binding IconKind}"
                                                                 Width="32" Height="32"
                                                                 Foreground="{Binding IconColor}"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource MetricLabel}"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="#8A817C" Margin="0,2,0,0"
                                                   Visibility="{Binding Subtitle, Converter={StaticResource NullToVisibilityConverter}}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Value, NotifyOnTargetUpdated=True}"
                                                   Style="{StaticResource PrimaryMetricValue}"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Large premium quick actions. -->
            <StackPanel Grid.Row="2" Margin="0,24,0,0">
                <TextBlock Text="{x:Static loc:Loc.QuickActions}" Style="{StaticResource SectionTitle}"/>
                <UniformGrid Columns="4" Margin="-8,0">
                    <Button Style="{StaticResource QuickActionButton}"
                            auth:PermissionAssist.Required="Sales.Create"
                            Command="{Binding NewSaleCommand}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border Width="40" Height="40" CornerRadius="12" Background="#E8F5E9">
                                <materialDesign:PackIcon Kind="CartPlus" Width="22" Height="22" Foreground="#2E7D32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{x:Static loc:Loc.NewSale}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource QuickActionButton}"
                            auth:PermissionAssist.Required="Production.Create"
                            Command="{Binding NewProductionCommand}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border Width="40" Height="40" CornerRadius="12" Background="#FFF0E6">
                                <materialDesign:PackIcon Kind="Factory" Width="22" Height="22" Foreground="#C67C4E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{x:Static loc:Loc.NewProduction}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource QuickActionButton}"
                            auth:PermissionAssist.Required="Treasury.View"
                            Command="{Binding ManageTreasuryCommand}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border Width="40" Height="40" CornerRadius="12" Background="#F3E7DF">
                                <materialDesign:PackIcon Kind="SafeSquareOutline" Width="22" Height="22" Foreground="#8B5E3C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{x:Static loc:Loc.TreasuryAction}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Grid Margin="8">
                        <Button Style="{StaticResource QuickActionButton}"
                                Margin="0"
                                Visibility="{Binding HasOpenDay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                auth:PermissionAssist.Required="WorkingDay.Close"
                                Command="{Binding EndDayCommand}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Width="40" Height="40" CornerRadius="12" Background="#FDECEC">
                                    <materialDesign:PackIcon Kind="CalendarCheckOutline" Width="22" Height="22" Foreground="#D32F2F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{x:Static loc:Loc.EndDay}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource QuickActionButton}"
                                Margin="0"
                                Visibility="{Binding CanOpenDay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                auth:PermissionAssist.Required="WorkingDay.Open"
                                Command="{Binding OpenDayCommand}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Width="40" Height="40" CornerRadius="12" Background="#E8F5E9">
                                    <materialDesign:PackIcon Kind="CalendarPlus" Width="22" Height="22" Foreground="#2E7D32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{x:Static loc:Loc.OpenDay}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </UniformGrid>
            </StackPanel>

            <!-- Both charts are always given a full half-width card. -->
            <StackPanel Grid.Row="3" Margin="0,24,0,0">
                <TextBlock Text="{x:Static loc:Loc.PerformanceTrends}" Style="{StaticResource SectionTitle}"/>
                <Grid Height="416" FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Physical left: Production. -->
                    <Border Grid.Column="0"
                            Style="{StaticResource DashboardCard}"
                            Padding="24"
                            FlowDirection="RightToLeft">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Border Width="40" Height="40" CornerRadius="12" Background="#FFF0E6">
                                        <materialDesign:PackIcon Kind="Factory" Width="22" Height="22" Foreground="#C67C4E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Static loc:Loc.ProductionChart}" FontSize="19" FontWeight="SemiBold" Foreground="#2F2925"/>
                                        <TextBlock Text="{x:Static loc:Loc.ProductionQuantity}" FontSize="13" Foreground="#8A817C" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                            <lvc:CartesianChart Grid.Row="1"
                                                FlowDirection="LeftToRight"
                                                Series="{Binding ProductionSeries}"
                                                XAxes="{Binding ProductionXAxes}"
                                                YAxes="{Binding ProductionYAxes}"
                                                LegendPosition="Hidden"
                                                TooltipPosition="Top"
                                                TooltipTextSize="14"
                                                TooltipTextPaint="#2F2925"
                                                TooltipBackgroundPaint="#FFFFFF"
                                                Visibility="{Binding ShowProductionChart, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                    </Border>

                    <!-- Physical right: Sales. -->
                    <Border Grid.Column="2"
                            Style="{StaticResource DashboardCard}"
                            Padding="24"
                            FlowDirection="RightToLeft">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Border Width="40" Height="40" CornerRadius="12" Background="#F3E7DF">
                                        <materialDesign:PackIcon Kind="ChartLine" Width="22" Height="22" Foreground="#8B5E3C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Static loc:Loc.SalesChart}" FontSize="19" FontWeight="SemiBold" Foreground="#2F2925"/>
                                        <TextBlock Text="{x:Static loc:Loc.SalesValue}" FontSize="13" Foreground="#8A817C" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                            <lvc:CartesianChart Grid.Row="1"
                                                FlowDirection="LeftToRight"
                                                Series="{Binding SalesSeries}"
                                                XAxes="{Binding SalesXAxes}"
                                                YAxes="{Binding SalesYAxes}"
                                                LegendPosition="Hidden"
                                                TooltipPosition="Top"
                                                TooltipTextSize="14"
                                                TooltipTextPaint="#2F2925"
                                                TooltipBackgroundPaint="#FFFFFF"
                                                Visibility="{Binding ShowSalesChart, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>

            <Border Grid.Row="4" Margin="0,24,0,0" Padding="20"
                    Style="{StaticResource DashboardCard}"
                    Visibility="{Binding CanViewBackupStatus, Converter={StaticResource BooleanToVisibilityConverter}}"
                    auth:PermissionAssist.Required="Backup.ViewStatus">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="12" Background="#F3E7DF">
                        <materialDesign:PackIcon Kind="DatabaseCheckOutline" Width="25" Height="25" Foreground="#8B5E3C"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="حالة النسخ الاحتياطي" FontSize="17" FontWeight="SemiBold" Foreground="#2F2925"/>
                        <WrapPanel Margin="0,4,0,0">
                            <TextBlock Text="{Binding BackupHealthText}" Foreground="{Binding BackupHealthColor}" FontWeight="SemiBold"/>
                            <TextBlock Text="  •  آخر نسخة: " Foreground="#8A817C"/>
                            <TextBlock Text="{Binding LastBackupText}" Foreground="#6B625D"/>
                            <TextBlock Text="  •  " Foreground="#8A817C"/>
                            <TextBlock Text="{Binding BackupCloudText}" Foreground="#6B625D"/>
                            <TextBlock Text="  •  رفع معلق: " Foreground="#8A817C"/>
                            <TextBlock Text="{Binding PendingBackupUploads}" Foreground="#6B625D"/>
                        </WrapPanel>
                    </StackPanel>
                    <Button Grid.Column="2" Content="إدارة النسخ" Command="{Binding ManageBackupsCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
