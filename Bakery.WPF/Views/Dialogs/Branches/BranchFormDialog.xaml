<Window x:Class="Bakery.WPF.Views.BranchFormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:loc="clr-namespace:Bakery.Shared.Helpers;assembly=Bakery.Shared"
        Title="{Binding DialogTitle}"
        Height="450"
        Width="500"
        MinHeight="400"
        MinWidth="450"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource MaterialDesignWindow}"
        Background="{StaticResource SurfaceBrush}"
        FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding DialogTitle}" FontSize="24" FontWeight="Black" Foreground="#2D2422"/>
                <TextBlock Text="بيانات الفرع وملاحظاته" FontSize="12" Foreground="#8B7E7A"/>
            </StackPanel>
            <CheckBox Grid.Column="1"
                      Content="{x:Static loc:Loc.Active}"
                      IsChecked="{Binding IsActive}"
                      Style="{StaticResource MaterialDesignCheckBox}"
                      VerticalAlignment="Center"/>
        </Grid>

        <!-- Fields -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="White" CornerRadius="12" Padding="18">
                    <StackPanel>
                        <!-- Code -->
                        <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                                 md:HintAssist.Hint="كود الفرع (مثال: GIZA)"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,0,16"/>

                        <!-- Name -->
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 md:HintAssist.Hint="اسم الفرع (مثال: فرع الجيزة)"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,0,16"/>

                        <!-- Notes -->
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 md:HintAssist.Hint="ملاحظات اختيارية..."
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Height="100"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,0,8"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{x:Static loc:Loc.DialogCancel}" IsCancel="True" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,10,0" />
            <Button Command="{Binding SaveCommand}"
                    Content="{x:Static loc:Loc.Save}"
                    Width="130"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#8B5E4C"
                    BorderBrush="#8B5E4C"/>
        </StackPanel>
    </Grid>
</Window>
