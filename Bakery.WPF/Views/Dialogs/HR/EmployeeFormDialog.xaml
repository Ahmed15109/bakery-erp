<Window x:Class="Bakery.WPF.Views.EmployeeFormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:conv="clr-namespace:Bakery.WPF.Converters"
        Title="بيانات الموظف" Height="600" Width="450"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource MaterialDesignWindow}"
        Background="{StaticResource SurfaceBrush}"
        FlowDirection="RightToLeft">
    
    <Window.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="بيانات الموظف" FontSize="20" FontWeight="Bold" Margin="0,0,0,24" Foreground="#2D2422"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Employee Code with Validation -->
                <StackPanel Margin="0,0,0,16">
                    <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" 
                             md:HintAssist.Hint="كود الموظف" 
                             md:TextFieldAssist.HasClearButton="True">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCodeValid}" Value="False">
                                        <Setter Property="BorderBrush" Value="#D32F2F"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCodeValid}" Value="True">
                                        <Setter Property="BorderBrush" Value="#2E7D32"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <TextBlock Text="{Binding CodeValidationMessage}" FontSize="10" Margin="4,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#6B7280"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCodeValid}" Value="False">
                                        <Setter Property="Foreground" Value="#D32F2F"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCodeValid}" Value="True">
                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <TextBox Text="{Binding Name}" md:HintAssist.Hint="اسم الموظف بالكامل" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,16" />
                <TextBox Text="{Binding Phone}" md:HintAssist.Hint="رقم الهاتف" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,16" />
                <TextBox Text="{Binding NationalId}" md:HintAssist.Hint="الرقم القومي" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,16" />
                <TextBox Text="{Binding Address}" md:HintAssist.Hint="العنوان" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,16" />

                <!-- Job Role Selection -->
                <ComboBox ItemsSource="{Binding JobRoles}" 
                          SelectedItem="{Binding SelectedJobRole}"
                          DisplayMemberPath="Name"
                          md:HintAssist.Hint="الوظيفة / الدور"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,16" />

                <!-- Wage Section -->
                <Border Background="#F5F1EF" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="بيانات الأجر" FontWeight="Bold" FontSize="13" Foreground="#5A4A44" Margin="0,0,0,10"/>

                        <ComboBox ItemsSource="{Binding WageTypes}"
                                  SelectedItem="{Binding WageType}"
                                  md:HintAssist.Hint="نوع الأجر"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Margin="0,0,0,12">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumToLocConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Monthly Salary (shown only when WageType = Monthly) -->
                        <TextBox Text="{Binding MonthlySalary, UpdateSourceTrigger=PropertyChanged}"
                                 md:HintAssist.Hint="الراتب الشهري"
                                 Margin="0,0,0,12">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMonthlyWage}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!-- Daily Rate (shown only when WageType = Daily) -->
                        <TextBox Text="{Binding DailyRate, UpdateSourceTrigger=PropertyChanged}"
                                 md:HintAssist.Hint="الأجر اليومي"
                                 Margin="0,0,0,12">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDailyWage}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!-- Production Rate (shown only when WageType = Production) -->
                        <TextBox Text="{Binding ProductionRate, UpdateSourceTrigger=PropertyChanged}"
                                 md:HintAssist.Hint="معدل الإنتاج (للوحدة)"
                                 Margin="0,0,0,12">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProductionWage}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!-- Effective From -->
                        <DatePicker SelectedDate="{Binding WageEffectiveFrom, Converter={StaticResource DateOnlyToDateTimeConverter}}"
                                    md:HintAssist.Hint="تاريخ سريان الأجر"
                                    Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                    Margin="0,0,0,0"/>
                    </StackPanel>
                </Border>

                <DatePicker SelectedDate="{Binding HireDate, Converter={StaticResource DateOnlyToDateTimeConverter}}" md:HintAssist.Hint="تاريخ التعيين" Style="{StaticResource MaterialDesignOutlinedDatePicker}" Margin="0,0,0,16" />
                <TextBox Text="{Binding Notes}" md:HintAssist.Hint="ملاحظات إضافية" md:TextFieldAssist.HasClearButton="True" Style="{StaticResource MaterialDesignOutlinedTextBox}" AcceptsReturn="True" Height="80" Margin="0,0,0,16" />
                
                <CheckBox IsChecked="{Binding IsActive}" Content="الموظف نشط حالياً" Style="{StaticResource MaterialDesignCheckBox}" Margin="0,0,0,16" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="إلغاء" IsCancel="True" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,12,0" />
            <Button Content="حفظ البيانات" IsDefault="True" Click="Save_Click" Width="120" IsEnabled="{Binding CanSave}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                        <Setter Property="Background" Value="#8B5E4C"/>
                        <Setter Property="BorderBrush" Value="#8B5E4C"/>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
