<Window x:Class="Bakery.WPF.Views.JobRoleFormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="بيانات الوظيفة" Height="500" Width="400"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource MaterialDesignWindow}"
        Background="{StaticResource SurfaceBrush}"
        FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="إدارة بيانات الوظيفة" FontSize="20" FontWeight="Bold" Margin="0,0,0,24" Foreground="#2D2422"/>

        <StackPanel Grid.Row="1">
            <!-- Job Name with Validation -->
            <StackPanel Margin="0,0,0,16">
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                         md:HintAssist.Hint="اسم الوظيفة (مثلاً: خباز، سائق...)" 
                         md:TextFieldAssist.HasClearButton="True">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNameValid}" Value="False">
                                    <Setter Property="BorderBrush" Value="#D32F2F"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsNameValid}" Value="True">
                                    <Setter Property="BorderBrush" Value="#2E7D32"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <TextBlock Text="{Binding NameValidationMessage}" FontSize="10" Margin="4,2,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#6B7280"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNameValid}" Value="False">
                                    <Setter Property="Foreground" Value="#D32F2F"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsNameValid}" Value="True">
                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
            
            <ComboBox ItemsSource="{Binding WageTypes}" 
                      SelectedItem="{Binding WageType}"
                      md:HintAssist.Hint="نظام احتساب الأجر"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,16">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource EnumToLocConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBox Text="{Binding MonthlySalary}" md:HintAssist.Hint="الراتب الشهري" Margin="0,0,0,16">
                <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WageType}" Value="Monthly">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <TextBox Text="{Binding DailyRate}" md:HintAssist.Hint="اليومية (لليوم الواحد)" Margin="0,0,0,16">
                <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WageType}" Value="Daily">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <TextBox Text="{Binding ProductionRate}" md:HintAssist.Hint="سعر الوحدة للإنتاج" Margin="0,0,0,16">
                <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WageType}" Value="Production">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
            
            <TextBox Text="{Binding Notes}" md:HintAssist.Hint="ملاحظات" md:TextFieldAssist.HasClearButton="True" Style="{StaticResource MaterialDesignOutlinedTextBox}" AcceptsReturn="True" Height="80" Margin="0,0,0,16" />
            
            <CheckBox IsChecked="{Binding IsActive}" Content="الوظيفة متاحة حالياً" Style="{StaticResource MaterialDesignCheckBox}" Margin="0,0,0,16" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="إلغاء" IsCancel="True" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,12,0" />
            <Button Content="حفظ الوظيفة" IsDefault="True" Click="Save_Click" Width="120">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                        <Setter Property="Background" Value="#8B5E4C"/>
                        <Setter Property="BorderBrush" Value="#8B5E4C"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNameValid}" Value="False">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
