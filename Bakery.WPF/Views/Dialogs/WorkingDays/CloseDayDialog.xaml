<Window x:Class="Bakery.WPF.CloseDayDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="إنهاء اليوم"
        Width="760"
        Height="820"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="#F6F3EF"
        FlowDirection="RightToLeft"
        FontFamily="Cairo, Segoe UI">
    <Window.Resources>
        <Style x:Key="CloseMetricCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E8DED7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Sticky Header -->
            <RowDefinition Height="Auto"/>
            <!-- Scrollable Modal Body -->
            <RowDefinition Height="*"/>
            <!-- Sticky Footer Action Buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Sticky Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="إنهاء اليوم" FontSize="28" FontWeight="Bold" Foreground="#2B211D"/>
            <TextBlock Text="مراجعة النقد والترحيل للخزنة الرئيسية قبل إغلاق يوم التشغيل." Foreground="#6B625D" FontSize="14" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Scrollable Modal Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
            <StackPanel>
                <!-- Metric Cards -->
                <UniformGrid Columns="3" Margin="0,0,0,12">
                    <Border Style="{StaticResource CloseMetricCard}">
                        <StackPanel>
                            <TextBlock Text="إجمالي المبيعات" Foreground="#6B625D" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Summary.TotalSales, StringFormat='N2'}" FontSize="24" FontWeight="Bold" Foreground="#2F6F4E" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CloseMetricCard}">
                        <StackPanel>
                            <TextBlock Text="المشتريات" Foreground="#6B625D" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Summary.TotalPurchases, StringFormat='N2'}" FontSize="20" FontWeight="Bold" Foreground="#A13D2D" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CloseMetricCard}">
                        <StackPanel>
                            <TextBlock Text="أوامر الإنتاج المكتملة" Foreground="#6B625D" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Summary.ProductionCount}" FontSize="20" FontWeight="Bold" Foreground="#7057A3" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CloseMetricCard}">
                        <StackPanel>
                            <TextBlock Text="إجمالي المصروفات" Foreground="#6B625D" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalExpenses, StringFormat='N2'}" FontSize="20" FontWeight="Bold" Foreground="#A13D2D" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CloseMetricCard}">
                        <StackPanel>
                            <TextBlock Text="الإيرادات الأخرى" Foreground="#6B625D" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Summary.TotalIncome, StringFormat='N2'}" FontSize="20" FontWeight="Bold" Foreground="#2F6F4E" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CloseMetricCard}">
                        <StackPanel>
                            <TextBlock Text="النقد المتوقع" Foreground="#6B625D" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Summary.ExpectedCash, StringFormat='N2'}" FontSize="20" FontWeight="Bold" Foreground="#2F2A27" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CloseMetricCard}" Background="#FFF8E1" BorderBrush="#F0D99B">
                        <StackPanel>
                            <TextBlock Text="رصيد خزنة اليوم" Foreground="#7A4D06" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Summary.DailySafeBalance, StringFormat='N2'}" FontSize="20" FontWeight="Bold" Foreground="#B36B00" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CloseMetricCard}">
                        <StackPanel>
                            <TextBlock Text="عدد حركات الخزنة" Foreground="#6B625D" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Summary.TransactionCount}" FontSize="20" FontWeight="Bold" Foreground="#2F2A27" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CloseMetricCard}">
                        <StackPanel>
                            <TextBlock Text="عدد الفواتير" Foreground="#6B625D" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Summary.InvoiceCount}" FontSize="20" FontWeight="Bold" Foreground="#2F2A27" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Background="#FFF4E5"
                        BorderBrush="#E8B66B"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,16"
                        Visibility="{Binding HasBlockers, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding BlockersMessage}"
                                   FontWeight="Bold"
                                   Foreground="#7A4D06"
                                   Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding Blockers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Message, StringFormat='- {0}'}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   Foreground="#5D4037"/>
                                        <Button Grid.Column="1"
                                                Content="{Binding ActionLabel}"
                                                Command="{Binding DataContext.OpenBlockerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding ActionLabel, Converter={StaticResource NullToVisibilityConverter}}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Padding="10,4"
                                                Margin="10,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Input Controls -->
                <StackPanel Margin="0,4,0,0">
                    <TextBox materialDesign:HintAssist.Hint="النقد الحالي"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding CurrentCash, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="True"
                             Margin="0,0,0,14"
                             FontSize="18"/>

                    <TextBox materialDesign:HintAssist.Hint="المبلغ المرحل للخزنة الرئيسية"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding TransferredToMainSafe, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,14"
                             FontSize="18"/>

                    <TextBox materialDesign:HintAssist.Hint="ملاحظات"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding Notes}"
                             Margin="0,0,0,14"
                             Height="86"
                             AcceptsReturn="True"
                             VerticalContentAlignment="Top"/>

                    <Border Background="#FDF2F2"
                            BorderBrush="#F0CCCC"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14"
                            Visibility="{Binding CanOverrideCloseBlockers, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <CheckBox Content="تجاوز إداري" IsChecked="{Binding AdminOverride}" Margin="0,0,0,10"/>
                            <TextBox materialDesign:HintAssist.Hint="سبب التجاوز"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Text="{Binding OverrideReason}"
                                     IsEnabled="{Binding AdminOverride}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Sticky Footer Action Buttons -->
        <Border Grid.Row="2" BorderBrush="#E8DED7" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Command="{Binding CloseDayCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="#8B5E4C"
                        BorderBrush="#8B5E4C"
                        Padding="24,10">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CheckCircle" Width="22" Height="22" Margin="0,0,8,0"/>
                        <ProgressBar Width="22"
                                     Height="4"
                                     IsIndeterminate="True"
                                     Margin="0,0,8,0"
                                     Visibility="{Binding IsSubmitting, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding SubmitButtonText}"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding CancelCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Padding="22,10"
                        Margin="12,0,0,0">
                    <TextBlock Text="إلغاء"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
