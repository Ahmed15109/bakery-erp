<Window x:Class="Bakery.WPF.Views.OwnerResetCodeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="رمز مالك النظام"
        Width="500" Height="350"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F6F3EF"
        FontFamily="Cairo, Segoe UI"
        FlowDirection="RightToLeft"
        ShowInTaskbar="False">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <md:PackIcon Kind="ShieldKeyOutline" Width="30" Height="30" Foreground="#C62828"/>
            <TextBlock Text="تحقق مالك النظام" FontSize="21" FontWeight="Bold"
                       Foreground="#C62828" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Text="هذه العملية غير قابلة للتراجع. أدخل رمز المالك الثابت للمتابعة."
                   TextWrapping="Wrap" Foreground="#5D4037" FontSize="14" Margin="0,0,0,16"/>

        <PasswordBox x:Name="OwnerCodeBox" Grid.Row="2" Height="48" FontSize="18"
                     MaxLength="32" Padding="12" PasswordChar="●"
                     md:HintAssist.Hint="رمز المالك"/>

        <TextBlock x:Name="AttemptMessage" Grid.Row="3" Margin="0,10,0,0"
                   Foreground="#C62828" FontWeight="SemiBold" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,24,0,0">
            <Button Content="إلغاء" Click="Cancel_Click" Width="100" Height="42"
                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
            <Button Content="تحقق ومتابعة" Click="Verify_Click" Width="150" Height="42" Margin="12,0,0,0"
                    Background="#C62828" BorderBrush="#C62828"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
        </StackPanel>
    </Grid>
</Window>
