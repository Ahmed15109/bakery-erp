<Window x:Class="Bakery.WPF.SaleInvoiceDialog" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:loc="clr-namespace:Bakery.Shared.Helpers;assembly=Bakery.Shared"
        Title="{x:Static loc:Loc.SaleInvoiceTitle}" Width="760" Height="760" WindowStartupLocation="CenterOwner" 
        Background="{StaticResource SurfaceBrush}"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource ArabicFont}">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <UniformGrid Columns="3">
            <ComboBox Margin="0,0,10,12" ItemsSource="{Binding Parties}" SelectedValue="{Binding SelectedPartyId}" SelectedValuePath="Id" DisplayMemberPath="Name" materialDesign:HintAssist.Hint="{x:Static loc:Loc.HintCustomer}"/>
            <ComboBox Margin="10,0,10,12" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" DisplayMemberPath="Name" materialDesign:HintAssist.Hint="{x:Static loc:Loc.HintItemBarcode}"/>
            <TextBox Margin="10,0,0,12" Text="{Binding Quantity}" materialDesign:HintAssist.Hint="{x:Static loc:Loc.HintQty}"/>
        </UniformGrid>
        <DockPanel Grid.Row="1">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                <Button Command="{Binding AddLineCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Content="{x:Static loc:Loc.AddLine}" Margin="0,0,8,0"/>
                <Button Command="{Binding QuickBreadCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Content="{x:Static loc:Loc.QuickBread}"/>
            </StackPanel>
            <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False"
                      ColumnHeaderStyle="{StaticResource RtlDataGridColumnHeaderStyle}"
                      CellStyle="{StaticResource RtlDataGridCellStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{x:Static loc:Loc.ColItem}" Binding="{Binding ItemName}" Width="*"/>
                    <DataGridTextColumn Header="{x:Static loc:Loc.ColQty}" Binding="{Binding Quantity}" Width="100"/>
                    <DataGridTextColumn Header="{x:Static loc:Loc.ColPrice}" Binding="{Binding UnitPrice}" Width="100"/>
                    <DataGridTextColumn Header="{x:Static loc:Loc.ColTotal}" Binding="{Binding Total}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
        <StackPanel Grid.Row="2">
            <UniformGrid Columns="3">
                <TextBox Margin="0,0,10,0" Text="{Binding PaidAmount}" materialDesign:HintAssist.Hint="{x:Static loc:Loc.HintPaid}"/>
                <TextBox Margin="10,0,10,0" Text="{Binding Notes}" materialDesign:HintAssist.Hint="{x:Static loc:Loc.HintNotes}"/>
                <TextBlock Text="{Binding Total, StringFormat=الإجمالي: {0:0.00}}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            </UniformGrid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Command="{Binding CancelCommand}" Content="{x:Static loc:Loc.Cancel}" Margin="0,0,12,0"/>
                <Button Command="{Binding SaveAndPostCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Content="{x:Static loc:Loc.SaveAndPost}" Padding="24,8"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
