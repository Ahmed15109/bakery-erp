<Window x:Class="Bakery.WPF.PurchaseInvoiceDialog" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:loc="clr-namespace:Bakery.Shared.Helpers;assembly=Bakery.Shared"
        Title="{x:Static loc:Loc.PurchaseInvoiceTitle}" Width="760" Height="760" WindowStartupLocation="CenterOwner" 
        Background="{StaticResource SurfaceBrush}"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource ArabicFont}">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <UniformGrid Columns="3">
            <ComboBox Margin="0,0,10,12" ItemsSource="{Binding Parties}" SelectedValue="{Binding SelectedPartyId}" SelectedValuePath="Id" DisplayMemberPath="Name" materialDesign:HintAssist.Hint="{x:Static loc:Loc.HintSupplier}"/>
            <ComboBox Margin="10,0,10,12" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" DisplayMemberPath="Name" materialDesign:HintAssist.Hint="{x:Static loc:Loc.HintItem}"/>
            <TextBox Margin="10,0,0,12" Text="{Binding Quantity}" materialDesign:HintAssist.Hint="{x:Static loc:Loc.HintQty}"/>
        </UniformGrid>
        <DockPanel Grid.Row="1">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                <Button Command="{Binding AddLineCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Content="{x:Static loc:Loc.AddLine}"/>
            </StackPanel>
            <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False"
                      ColumnHeaderStyle="{StaticResource RtlDataGridColumnHeaderStyle}"
                      CellStyle="{StaticResource RtlDataGridCellStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{x:Static loc:Loc.ColItem}" Binding="{Binding ItemName}" Width="*"/>
                    <DataGridTextColumn Header="{x:Static loc:Loc.ColQty}" Binding="{Binding Quantity}" Width="100"/>
                    <DataGridTextColumn Header="{x:Static loc:Loc.ColPrice}" Binding="{Binding UnitPrice}" Width="100"/>
                    <DataGridTextColumn Header="{x:Static loc:Loc.ColTotal}" Binding="{Binding Total}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
        <StackPanel Grid.Row="2">
            <Grid Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="رصيد الخزنة المتاح: " Foreground="#6D4C41" FontSize="12"/>
                    <TextBlock Text="{Binding CurrentSafeBalance, StringFormat={}{0:N2} ج.م}" FontWeight="Bold" Foreground="#2B211D" FontSize="12"/>
                </StackPanel>
            </Grid>
            <UniformGrid Columns="3">
                <StackPanel Margin="0,0,10,0">
                    <TextBox Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="{x:Static loc:Loc.HintPaid}"/>
                    <TextBlock Text="{Binding BalanceWarning}" Foreground="#D32F2F" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="{Binding IsInsufficientFunds, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
                <TextBox Margin="10,0,10,0" Text="{Binding Notes}" materialDesign:HintAssist.Hint="{x:Static loc:Loc.HintNotes}"/>
                <TextBlock Text="{Binding Total, StringFormat=الإجمالي: {0:0.00}}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            </UniformGrid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Command="{Binding CancelCommand}" Content="{x:Static loc:Loc.Cancel}" Margin="0,0,12,0"/>
                <Button Command="{Binding SaveAndPostCommand}" 
                        Style="{StaticResource MaterialDesignRaisedButton}" 
                        Content="{x:Static loc:Loc.SaveAndPost}" 
                        Padding="24,8"
                        IsEnabled="{Binding IsInsufficientFunds, Converter={StaticResource InverseBooleanConverter}}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
