<Window x:Class="Bakery.WPF.InventoryAdjustmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:loc="clr-namespace:Bakery.Shared.Helpers;assembly=Bakery.Shared"
        Title="{x:Static loc:Loc.AdjustmentTitle}" Width="520" Height="520" WindowStartupLocation="CenterOwner" 
        Background="{StaticResource SurfaceBrush}"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource ArabicFont}">
    <Grid Margin="30">
        <StackPanel>
            <TextBlock Text="{x:Static loc:Loc.AdjustmentTitle}" FontSize="28" FontWeight="Bold"/>
            <ComboBox Margin="0,22,0,12" ItemsSource="{Binding Items}" SelectedValue="{Binding SelectedItemId}" SelectedValuePath="Id" DisplayMemberPath="Name" materialDesign:HintAssist.Hint="{x:Static loc:Loc.HintItem}"/>
            <ComboBox Margin="0,0,0,12" ItemsSource="{Binding Units}" SelectedValue="{Binding SelectedUnitId}" SelectedValuePath="UnitId" DisplayMemberPath="UnitName" materialDesign:HintAssist.Hint="{x:Static loc:Loc.HintUnit}"/>
            <TextBox Margin="0,0,0,12" Text="{Binding Quantity}" materialDesign:HintAssist.Hint="{x:Static loc:Loc.HintQuantity}"/>
            <CheckBox Margin="0,0,0,12" Content="{x:Static loc:Loc.HintIncreaseStock}" IsChecked="{Binding IsIncrease}"/>
            <TextBox Text="{Binding Reason}" Height="80" TextWrapping="Wrap" materialDesign:HintAssist.Hint="{x:Static loc:Loc.HintReason}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Command="{Binding CancelCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,12,0" Content="{x:Static loc:Loc.Cancel}"/>
                <Button Command="{Binding SaveCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Content="{x:Static loc:Loc.Save}" Padding="24,8"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
