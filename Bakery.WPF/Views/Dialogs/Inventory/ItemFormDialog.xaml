<Window x:Class="Bakery.WPF.ItemFormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:loc="clr-namespace:Bakery.Shared.Helpers;assembly=Bakery.Shared"
        xmlns:conv="clr-namespace:Bakery.WPF.Converters"
        Title="{x:Static loc:Loc.ItemFormTitle}" 
        WindowState="Maximized"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        FontFamily="Cairo, Segoe UI">

    <Window.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <!-- Overlay Background (Dimmed) -->
        <Border Background="#4D000000" MouseDown="Overlay_MouseDown"/>

        <!-- Dialog Card -->
        <materialDesign:Card Width="600" VerticalAlignment="Center" HorizontalAlignment="Center" 
                             UniformCornerRadius="20" Background="White"
                             materialDesign:ElevationAssist.Elevation="Dp24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Content -->
                    <RowDefinition Height="Auto"/> <!-- Footer -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="#F9FAFB" CornerRadius="20,20,0,0" Padding="24,16">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" 
                                Command="{Binding CancelCommand}" 
                                Style="{StaticResource MaterialDesignIconButton}" 
                                Width="32" Height="32">
                            <materialDesign:PackIcon Kind="Close" Foreground="#9CA3AF"/>
                        </Button>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="بيانات الصنف" FontSize="20" FontWeight="Black" Foreground="#2B211D"/>
                            <TextBlock Text="إضافة أو تعديل معلومات الصنف في المخزون" FontSize="11" Foreground="#6B7280" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Content -->
                <ScrollViewer Grid.Row="1" MaxHeight="600" VerticalScrollBarVisibility="Auto">
                    <Border Padding="24,16">
                        <StackPanel>
                        <!-- Basic Info Section -->
                        <TextBlock Text="المعلومات الأساسية" FontWeight="Bold" Foreground="#8B5E4C" Margin="0,0,0,12"/>
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,10,16">
                                <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" 
                                         materialDesign:HintAssist.Hint="الكود"
                                         materialDesign:TextFieldAssist.HasClearButton="True">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCodeValid}" Value="False">
                                                    <Setter Property="BorderBrush" Value="#D32F2F"/>
                                                    <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="#D32F2F"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCodeValid}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#2E7D32"/>
                                                    <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="#2E7D32"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <TextBlock Text="{Binding CodeValidationMessage}" FontSize="10" Margin="4,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#6B7280"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCodeValid}" Value="False">
                                                    <Setter Property="Foreground" Value="#D32F2F"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCodeValid}" Value="True">
                                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            
                            <StackPanel Margin="10,0,0,16">
                                <TextBox Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" 
                                         materialDesign:HintAssist.Hint="الباركود"
                                         materialDesign:TextFieldAssist.HasClearButton="True">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBarcodeValid}" Value="False">
                                                    <Setter Property="BorderBrush" Value="#D32F2F"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsBarcodeValid}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#2E7D32"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <TextBlock Text="{Binding BarcodeValidationMessage}" FontSize="10" Margin="4,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#6B7280"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBarcodeValid}" Value="False">
                                                    <Setter Property="Foreground" Value="#D32F2F"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsBarcodeValid}" Value="True">
                                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </UniformGrid>

                        <TextBox Margin="0,0,0,16" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="اسم الصنف"
                                 materialDesign:TextFieldAssist.HasClearButton="True"/>

                        <UniformGrid Columns="2">
                            <!-- Item Type -->
                            <ComboBox Margin="0,0,10,16" ItemsSource="{Binding ItemTypes}" 
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      SelectedItem="{Binding SelectedType}" 
                                      materialDesign:HintAssist.Hint="النوع">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumToLocConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            
                            <!-- Base Unit -->
                            <ComboBox Margin="10,0,0,16" ItemsSource="{Binding Units}" 
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      SelectedValue="{Binding SelectedUnitId}" 
                                      SelectedValuePath="Id" 
                                      DisplayMemberPath="Name" 
                                      materialDesign:HintAssist.Hint="الوحدة الافتراضية">
                            </ComboBox>
                        </UniformGrid>

                        <Separator Margin="0,8,0,20" Background="#F3F4F6"/>

                        <!-- Pricing Section -->
                        <TextBlock Text="الأسعار والمخزون" FontWeight="Bold" Foreground="#8B5E4C" Margin="0,0,0,12"/>
                        <UniformGrid Columns="2">
                            <TextBox Margin="0,0,10,16" 
                                     Text="{Binding PurchasePrice, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDecimalConverter}}" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="سعر الشراء"
                                     materialDesign:TextFieldAssist.PrefixText="ج.م "/>
                            
                            <TextBox Margin="10,0,0,16" 
                                     Text="{Binding SalePrice, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDecimalConverter}}" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="سعر البيع"
                                     materialDesign:TextFieldAssist.PrefixText="ج.م "/>
                            
                            <TextBox Margin="0,0,10,16" 
                                     Text="{Binding MinStockLevel, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDecimalConverter}}" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="الحد الأدنى"/>
                            
                            <TextBox Margin="10,0,0,16" 
                                     Text="{Binding ReorderLevel, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDecimalConverter}}" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="حد إعادة الطلب"/>
                        </UniformGrid>

                        <CheckBox Margin="0,4,0,16" Content="الصنف نشط متاح للاستخدام" 
                                  IsChecked="{Binding IsActive}" 
                                  Style="{StaticResource MaterialDesignSecondaryCheckBox}"/>

                        <TextBox Text="{Binding Notes}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" 
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 VerticalContentAlignment="Top"
                                 materialDesign:HintAssist.Hint="ملاحظات..."
                                 Margin="0,0,0,0"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <!-- Footer -->
                <Border Grid.Row="2" Background="#F9FAFB" CornerRadius="0,0,20,20" Padding="24,16">
                    <DockPanel LastChildFill="False">
                        <Button DockPanel.Dock="Left" 
                                Command="{Binding CancelCommand}" 
                                Style="{StaticResource MaterialDesignOutlinedButton}" 
                                IsCancel="True"
                                Content="إلغاء" Width="120"
                                materialDesign:ButtonAssist.CornerRadius="10"/>
                        
                        <Button DockPanel.Dock="Right" 
                                Command="{Binding SaveCommand}" 
                                Style="{StaticResource MaterialDesignRaisedButton}" 
                                Background="#8B5E4C" BorderBrush="#8B5E4C"
                                Content="حفظ البيانات" Width="160"
                                materialDesign:ButtonAssist.CornerRadius="10"
                                FontWeight="Bold"/>
                    </DockPanel>
                </Border>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Window>
