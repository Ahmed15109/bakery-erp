<Window x:Class="Bakery.WPF.Views.ResetPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:loc="clr-namespace:Bakery.Shared.Helpers;assembly=Bakery.Shared"
        Title="{x:Static loc:Loc.ResetPasswordTitle}"
        Height="390"
        Width="430"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource MaterialDesignWindow}"
        Background="{StaticResource SurfaceBrush}"
        FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="{x:Static loc:Loc.ResetPasswordTitle}" FontSize="22" FontWeight="Black" Foreground="#2D2422"/>
            <TextBlock Text="{Binding Username}" FontSize="13" Foreground="#8B7E7A"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <PasswordBox x:Name="PasswordInput"
                         md:HintAssist.Hint="{x:Static loc:Loc.NewPassword}"
                         Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                         PasswordChanged="PasswordInput_OnPasswordChanged"
                         Margin="0,0,0,14"/>

            <PasswordBox x:Name="ConfirmPasswordInput"
                         md:HintAssist.Hint="{x:Static loc:Loc.ConfirmNewPassword}"
                         Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                         PasswordChanged="ConfirmPasswordInput_OnPasswordChanged"/>

            <TextBlock Text="{x:Static loc:Loc.PasswordRequirements}"
                       FontSize="11"
                       Foreground="#8B7E7A"
                       Margin="2,8,0,0"/>

        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{x:Static loc:Loc.DialogCancel}" IsCancel="True" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,10,0"/>
            <Button Command="{Binding SaveCommand}"
                    Content="{x:Static loc:Loc.ResetButton}"
                    Width="110"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#8B5E4C"
                    BorderBrush="#8B5E4C"/>
        </StackPanel>
    </Grid>
</Window>
