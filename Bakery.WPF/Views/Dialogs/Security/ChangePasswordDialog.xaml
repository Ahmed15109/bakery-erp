<Window x:Class="Bakery.WPF.Views.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="تغيير كلمة المرور"
        Height="390" Width="460"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource MaterialDesignWindow}"
        Background="{StaticResource SurfaceBrush}"
        FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="تغيير كلمة المرور" FontSize="22" FontWeight="Bold" Foreground="#2D2422"/>
            <TextBlock Text="يلزم تعيين كلمة مرور جديدة قبل متابعة تسجيل الدخول." FontSize="13" Foreground="#8B7E7A" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding Username}" FontSize="13" FontWeight="SemiBold" Foreground="#8B5E4C" Margin="0,6,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <PasswordBox x:Name="NewPasswordInput"
                         md:HintAssist.Hint="كلمة المرور الجديدة"
                         Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                         PasswordChanged="NewPasswordInput_OnPasswordChanged"
                         Margin="0,0,0,14"/>
            <PasswordBox x:Name="ConfirmPasswordInput"
                         md:HintAssist.Hint="تأكيد كلمة المرور الجديدة"
                         Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                         PasswordChanged="ConfirmPasswordInput_OnPasswordChanged"/>
            <TextBlock Text="استخدم 12 حرفاً على الأقل، وتجنب كلمات المرور المتوقعة." FontSize="11" Foreground="#8B7E7A" Margin="2,8,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="إلغاء" IsCancel="True" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,10,0"/>
            <Button Command="{Binding SaveCommand}" Content="حفظ ومتابعة" Width="130"
                    Style="{StaticResource MaterialDesignRaisedButton}" Background="#8B5E4C" BorderBrush="#8B5E4C"/>
        </StackPanel>
    </Grid>
</Window>
