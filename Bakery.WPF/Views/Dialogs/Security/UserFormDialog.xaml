<Window x:Class="Bakery.WPF.Views.UserFormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:loc="clr-namespace:Bakery.Shared.Helpers;assembly=Bakery.Shared"
        Title="{Binding DialogTitle}"
        Height="760"
        Width="900"
        MinHeight="680"
        MinWidth="780"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource MaterialDesignWindow}"
        Background="{StaticResource SurfaceBrush}"
        FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding DialogTitle}" FontSize="24" FontWeight="Black" Foreground="#2D2422"/>
                <TextBlock Text="{x:Static loc:Loc.BasicInfoSubtitle}" FontSize="12" Foreground="#8B7E7A"/>
            </StackPanel>
            <CheckBox Grid.Column="1"
                      Content="{x:Static loc:Loc.Active}"
                      IsChecked="{Binding IsActive}"
                      Style="{StaticResource MaterialDesignCheckBox}"
                      VerticalAlignment="Center"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{x:Static loc:Loc.BasicInformation}" FontSize="16" FontWeight="Bold" Foreground="#2D2422" Margin="0,0,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBox Grid.Row="0" Grid.Column="0"
                                     Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                                     md:HintAssist.Hint="{x:Static loc:Loc.FullNameLabel}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Margin="0,0,8,14"/>

                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                     md:HintAssist.Hint="{x:Static loc:Loc.HintUsername}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Margin="8,0,0,14"/>

                            <PasswordBox x:Name="PasswordInput"
                                         Grid.Row="1"
                                         Grid.Column="0"
                                         md:HintAssist.Hint="{x:Static loc:Loc.HintPassword}"
                                         PasswordChanged="PasswordInput_OnPasswordChanged"
                                         Margin="0,0,8,14">
                                <PasswordBox.Style>
                                    <Style TargetType="PasswordBox" BasedOn="{StaticResource MaterialDesignOutlinedPasswordBox}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </PasswordBox.Style>
                            </PasswordBox>

                            <PasswordBox x:Name="ConfirmPasswordInput"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         md:HintAssist.Hint="{x:Static loc:Loc.ConfirmNewPassword}"
                                         PasswordChanged="ConfirmPasswordInput_OnPasswordChanged"
                                         Margin="8,0,0,14">
                                <PasswordBox.Style>
                                    <Style TargetType="PasswordBox" BasedOn="{StaticResource MaterialDesignOutlinedPasswordBox}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </PasswordBox.Style>
                            </PasswordBox>

                        </Grid>
                        
                        <!-- User-Branch Assignment -->
                        <TextBlock Text="{x:Static loc:Loc.UserBranchesLabel}" FontSize="14" FontWeight="Bold" Foreground="#2D2422" Margin="0,16,0,10"
                                   Visibility="{Binding CanManageSecurity, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <ItemsControl ItemsSource="{Binding Branches}" Margin="0,0,0,8"
                                      Visibility="{Binding CanManageSecurity, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemWidth="200" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Margin="0,0,16,8"
                                              Style="{StaticResource MaterialDesignCheckBox}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Margin="0,12,0,0"
                                    Visibility="{Binding CanManageRoles, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="الأدوار الوظيفية" FontSize="14" FontWeight="Bold" Foreground="#2D2422"/>
                            <TextBlock Text="اختر دوراً جاهزاً، ويمكن إضافة صلاحيات فردية عند الحاجة." FontSize="11" Foreground="#8B7E7A" Margin="0,2,0,10"/>
                            <ItemsControl ItemsSource="{Binding Roles}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel ItemWidth="240"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,16,10"
                                                  Style="{StaticResource MaterialDesignCheckBox}" ToolTip="{Binding Description}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#8B7E7A" TextTrimming="CharacterEllipsis" MaxWidth="210"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="12" Padding="18"
                        Visibility="{Binding CanManageSecurity, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="{x:Static loc:Loc.Permissions}" FontSize="16" FontWeight="Bold" Foreground="#2D2422"/>
                                <TextBlock Text="{x:Static loc:Loc.PermissionsSubtitle}" FontSize="12" Foreground="#8B7E7A"/>
                                <TextBlock Text="الصلاحيات المباشرة اختيارية؛ يمكن الحفظ بالدور الوظيفي فقط." FontSize="11" Foreground="#8B7E7A"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Command="{Binding SelectAllCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Height="34"
                                        Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <md:PackIcon Kind="CheckAll" Width="16" Height="16" Margin="0,0,4,0"/>
                                        <TextBlock Text="{x:Static loc:Loc.SelectAll}"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding UnselectAllCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Height="34">
                                    <StackPanel Orientation="Horizontal">
                                        <md:PackIcon Kind="CloseBoxMultipleOutline" Width="16" Height="16" Margin="0,0,4,0"/>
                                        <TextBlock Text="{x:Static loc:Loc.UnselectAll}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <TextBox Grid.Row="1"
                                 Text="{Binding PermissionSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 md:HintAssist.Hint="{x:Static loc:Loc.SearchPermissions}"
                                 md:TextFieldAssist.HasClearButton="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,0,12"/>

                        <ItemsControl Grid.Row="2" ItemsSource="{Binding PermissionCategories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Margin="0,0,0,8" IsExpanded="True">
                                        <Expander.Style>
                                            <Style TargetType="Expander" BasedOn="{StaticResource MaterialDesignExpander}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Expander.Style>
                                        <Expander.Header>
                                            <Grid HorizontalAlignment="Stretch" Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContentPresenter}, Path=ActualWidth}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="#2D2422" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,32,0" VerticalAlignment="Center">
                                                    <Button Content="تحديد الكل" 
                                                            Command="{Binding SelectAllCategoryCommand}" 
                                                            Style="{StaticResource MaterialDesignFlatButton}" 
                                                            Foreground="#8B5E4C"
                                                            FontSize="11" 
                                                            Height="24"
                                                            Padding="4,0" 
                                                            Margin="0,0,8,0"/>
                                                    <Button Content="إلغاء الكل" 
                                                            Command="{Binding ClearAllCategoryCommand}" 
                                                            Style="{StaticResource MaterialDesignFlatButton}" 
                                                            Foreground="#8B7E7A"
                                                            FontSize="11" 
                                                            Height="24"
                                                            Padding="4,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Expander.Header>
                                        <ItemsControl ItemsSource="{Binding Permissions}" Margin="8,8,8,4">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel ItemWidth="230" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              IsEnabled="{Binding IsEnabled}"
                                                              ToolTip="{Binding Description}"
                                                              Margin="0,0,16,8">
                                                        <CheckBox.Style>
                                                            <Style TargetType="CheckBox" BasedOn="{StaticResource MaterialDesignCheckBox}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Setter Property="Foreground" Value="#2D2422"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsDangerous}" Value="True">
                                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </CheckBox.Style>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <md:PackIcon Kind="AlertCircleOutline" 
                                                                         Width="14" Height="14" 
                                                                         Foreground="#DC2626" 
                                                                         Margin="0,0,4,0" 
                                                                         VerticalAlignment="Center" 
                                                                         Visibility="{Binding IsDangerous, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Border Background="White" CornerRadius="12" Padding="18" Margin="0,16,0,0"
                        Visibility="{Binding CanManageSecurity, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="صلاحيات الخزائن" FontSize="16" FontWeight="Bold" Foreground="#2D2422" Margin="0,0,0,10"/>
                        <TextBlock Text="حدد صلاحيات الوصول للعمليات المالية لكل خزنة بشكل منفصل." FontSize="12" Foreground="#8B7E7A" Margin="0,0,0,14"/>
                        <DataGrid ItemsSource="{Binding SafePermissions}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  Background="Transparent"
                                  RowHeight="36"
                                  GridLinesVisibility="Horizontal"
                                  AlternatingRowBackground="#F9FAFB"
                                  HorizontalGridLinesBrush="#E5E7EB">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الخزنة" Binding="{Binding SafeName}" IsReadOnly="True" Width="*" />
                                <DataGridTemplateColumn Header="الوصول" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding CanAccess, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="عرض الرصيد" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding CanViewBalance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="عرض كشف الحساب" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding CanViewLedger, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="إيداع" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding CanCashIn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="سحب" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding CanCashOut, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="تحويل منه" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding CanTransferFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="تحويل إليه" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding CanReceiveTransfer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#FEF2F2"
                    BorderBrush="#FCA5A5"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8"
                    Margin="0,0,16,0"
                    Visibility="{Binding HasValidationErrors, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="لا يمكن الحفظ حتى تكتمل البيانات التالية:"
                               FontWeight="Bold"
                               Foreground="#991B1B"
                               Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding ValidationMessages}" MaxHeight="110">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat=• {0}}"
                                           Foreground="#B91C1C"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Content="{x:Static loc:Loc.DialogCancel}" IsCancel="True" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,10,0" />
                <Button Command="{Binding SaveCommand}"
                        Content="{x:Static loc:Loc.SaveUser}"
                        Width="130"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="#8B5E4C"
                        BorderBrush="#8B5E4C"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
