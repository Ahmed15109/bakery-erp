<Window x:Class="Bakery.WPF.Views.SafeMismatchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="تنبيه تعارض الخزنة" Height="300" Width="480"
        WindowStartupLocation="CenterOwner"
        Background="#F6F3EF"
        FontFamily="Cairo, Segoe UI"
        FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <materialDesign:PackIcon Kind="Alert" Width="28" Height="28" Foreground="#D32F2F" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="تنبيه تعارض الخزنة" FontSize="20" FontWeight="Bold" Foreground="#D32F2F" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock Grid.Row="1" FontSize="14" TextWrapping="Wrap" Foreground="#2B211D" LineHeight="24">
            <Run Text="تنبيه: هذه الفاتورة تمت من خلال الخزنة الأصلية ("/>
            <Run Text="{Binding OriginalSafeName}" FontWeight="Bold" Foreground="#8B5E4C"/>
            <Run Text=")، بينما الخزنة النشطة الحالية هي ("/>
            <Run Text="{Binding CurrentSafeName}" FontWeight="Bold" Foreground="#8B5E4C"/>
            <Run Text=")."/>
            <LineBreak/><LineBreak/>
            <Run Text="هل ترغب في إتمام هذه العملية من الخزنة النشطة الحالية؟ أو التبديل إلى الخزنة الأصلية؟"/>
        </TextBlock>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <!-- Option 3: Cancel -->
            <Button Content="إلغاء" Style="{StaticResource MaterialDesignFlatButton}" Command="{Binding AbortCommand}" Margin="0,0,8,0"/>
            
            <!-- Option 2: Switch to original safe -->
            <Button Content="التبديل إلى الخزنة الأصلية" 
                    Style="{StaticResource MaterialDesignOutlinedButton}" 
                    Command="{Binding SwitchToOriginalCommand}" 
                    IsEnabled="{Binding CanSwitchToOriginal}"
                    BorderBrush="#8B5E4C" Foreground="#8B5E4C"
                    Margin="0,0,8,0"/>

            <!-- Option 1: Continue with current -->
            <Button Content="متابعة بالخزنة الحالية" 
                    Style="{StaticResource MaterialDesignRaisedButton}" 
                    Command="{Binding ContinueWithCurrentCommand}" 
                    Background="#8B5E4C" BorderBrush="#8B5E4C"/>
        </StackPanel>
    </Grid>
</Window>
