<Window x:Class="Bakery.WPF.SafeFormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{Binding Title}" Height="300" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="#F6F3EF"
        FontFamily="Cairo, Segoe UI"
        FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold" Foreground="#2B211D" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <TextBox materialDesign:HintAssist.Hint="نوع الخزنة"
                      Style="{StaticResource MaterialDesignOutlinedTextBox}"
                      Text="{Binding TypeDisplayName, Mode=OneWay}"
                      IsEnabled="False"
                      Margin="0,0,0,16"/>

            <TextBox materialDesign:HintAssist.Hint="اسم الخزنة"
                      Style="{StaticResource MaterialDesignOutlinedTextBox}"
                      Text="{Binding ArabicName, UpdateSourceTrigger=PropertyChanged}"
                      Margin="0,0,0,16"/>

            <CheckBox Content="نشطة"
                       IsChecked="{Binding IsActive}"
                       IsEnabled="{Binding IsSystem, Converter={StaticResource InverseBooleanConverter}}"
                       Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                       Margin="4,0,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="إلغاء" Style="{StaticResource MaterialDesignFlatButton}" Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
            <Button Content="حفظ" 
                    Style="{StaticResource MaterialDesignRaisedButton}" 
                    Command="{Binding SaveCommand}" 
                    Width="100" 
                    Background="#8B5E4C" 
                    BorderBrush="#8B5E4C"/>
        </StackPanel>
    </Grid>
</Window>
