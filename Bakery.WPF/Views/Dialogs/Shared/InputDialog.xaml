<Window x:Class="Bakery.WPF.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{Binding Title}" Height="250" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="#F1F2F6">
    <Grid Margin="24">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Prompt}" FontSize="16" Margin="0,0,0,16" Foreground="#2D3436"/>
            <TextBox x:Name="InputTextBox" Text="{Binding InputValue, UpdateSourceTrigger=PropertyChanged}" 
                     md:HintAssist.Hint="أدخل القيمة هنا..."
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Margin="0,0,0,24"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="إلغاء" IsCancel="True" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,12,0"/>
                <Button Content="موافق" IsDefault="True" Click="OkButton_Click" 
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="#2D3436" BorderBrush="#2D3436"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
