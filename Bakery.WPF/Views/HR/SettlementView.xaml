<UserControl x:Class="Bakery.WPF.Views.SettlementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:Bakery.WPF.Converters"
             xmlns:auth="clr-namespace:Bakery.WPF.Authorization"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <conv:BalanceToBrushConverter x:Key="BalanceBrushConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- Main Form -->
        <Border Grid.Column="0" Background="White" CornerRadius="16" Margin="0,0,16,0" Padding="24">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Opacity="0.05" ShadowDepth="2"/>
            </Border.Effect>
            
            <StackPanel>
                <TextBlock Text="تسوية مستحقات الموظف" FontSize="24" FontWeight="Bold" Margin="0,0,0,24" Foreground="#2C3E50"/>

                <!-- Selection Section -->
                <Grid Margin="0,0,0,32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="الموظف" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#57606F"/>
                        <ComboBox ItemsSource="{Binding Employees}" 
                                  SelectedItem="{Binding SelectedEmployee}"
                                  DisplayMemberPath="Name"
                                  md:HintAssist.Hint="اختر الموظف"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="التاريخ" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#57606F"/>
                        <DatePicker SelectedDate="{Binding SettlementDate}"
                                    Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,0,0,8">
                            <TextBlock Text="الخزينة" FontWeight="SemiBold" Foreground="#57606F"/>
                            <TextBlock Text="{Binding CurrentSafeBalance, StringFormat='(المتاح: {0:N2})'}" 
                                       FontSize="10" Margin="8,0,0,0" VerticalAlignment="Bottom"
                                       Foreground="{Binding IsInsufficientFunds, Converter={StaticResource BalanceBrushConverter}}"/>
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding Safes}" 
                                  SelectedItem="{Binding SelectedSafe}"
                                  DisplayMemberPath="DisplayName"
                                  IsEnabled="{Binding CanChangeSafe}"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,0,0,32" Background="#F0F2F5"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Calculations -->
                    <StackPanel Grid.Column="0" Margin="0,0,24,0" IsEnabled="{Binding HasSalariesPermission}">
                        <TextBlock Text="بيانات احتساب الاستحقاق" FontSize="16" FontWeight="Bold" Foreground="#8B5E4C" Margin="0,0,0,20"/>
                        
                        <!-- Production Type -->
                        <StackPanel Visibility="{Binding IsProductionType, Converter={StaticResource BoolToVis}}">
                            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDecimalConverter}}" 
                                     md:HintAssist.Hint="الكمية المنتجة (عدد الأكياس / الصواني)" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,16"/>
                            <TextBox Text="{Binding Rate, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDecimalConverter}}" 
                                     md:HintAssist.Hint="سعر إنتاج الوحدة" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,16"/>
                        </StackPanel>

                        <!-- Daily Type -->
                        <StackPanel Visibility="{Binding IsDailyType, Converter={StaticResource BoolToVis}}">
                            <TextBox Text="{Binding AttendanceCount, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDecimalConverter}}" 
                                     md:HintAssist.Hint="عدد أيام العمل" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,16"/>
                            <TextBox Text="{Binding DailyRate, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDecimalConverter}}" 
                                     md:HintAssist.Hint="اليومية المقررة" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,16"/>
                        </StackPanel>

                        <!-- Monthly Type -->
                        <StackPanel Visibility="{Binding IsMonthlyType, Converter={StaticResource BoolToVis}}">
                            <TextBox Text="{Binding MonthlySalary, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDecimalConverter}}" 
                                     md:HintAssist.Hint="الراتب الشهري المستحق" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,16"/>
                        </StackPanel>

                        <Border Background="#F8F9FB" CornerRadius="12" Padding="20" Margin="0,8,0,0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock Text="إجمالي الاستحقاق:" FontSize="14" Foreground="#7F8C8D"/>
                                    <TextBlock Text="{Binding GrossAmount, Converter={StaticResource CurrencyConverter}}" 
                                               HorizontalAlignment="Right" FontSize="22" FontWeight="Bold" Foreground="#2C3E50"/>
                                </DockPanel>
                                <Separator Background="#EBEDF0" Margin="0,4"/>
                                <DockPanel Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="الرصيد بعد العملية:" FontSize="13" Foreground="#7F8C8D"/>
                                        <TextBlock Text="(Live update)" FontSize="9" Foreground="#BDC3C7"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding RemainingBalance, Converter={StaticResource CurrencyConverter}}" 
                                               HorizontalAlignment="Right" FontSize="26" FontWeight="Black" 
                                               Foreground="{Binding RemainingBalance, Converter={StaticResource BalanceBrushConverter}}"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right Column: Adjustments -->
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="تعديلات وصرف نقدية" FontSize="16" FontWeight="Bold" Foreground="#8B5E4C" Margin="0,0,0,20"/>
                        
                        <Grid Margin="0,0,0,16" IsEnabled="{Binding HasSalariesPermission}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Bonus, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDecimalConverter}}" 
                                     md:HintAssist.Hint="مكافأة (+)" Margin="0,0,8,0"
                                     Foreground="#27AE60" FontWeight="SemiBold"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                            <TextBox Grid.Column="1" Text="{Binding Deduction, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDecimalConverter}}" 
                                     md:HintAssist.Hint="خصم (-)" 
                                     Foreground="#E74C3C" FontWeight="SemiBold"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        </Grid>
 
                        <TextBox Text="{Binding Advance, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FlexibleDecimalConverter}}" 
                                 md:HintAssist.Hint="صرف نقدية من الخزينة الآن" 
                                 Foreground="#E74C3C" FontWeight="Black" FontSize="18"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,16"
                                 IsEnabled="{Binding HasAdvancesPermission}"/>

                        <TextBox Text="{Binding Notes}" md:HintAssist.Hint="ملاحظات إضافية..." 
                                 AcceptsReturn="True" Height="80"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                        <!-- Balance Warning -->
                        <Border Background="#FDEDEC" CornerRadius="8" Padding="12" Margin="0,16,0,0" 
                                Visibility="{Binding IsInsufficientFunds, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="AlertCircle" Foreground="#E74C3C" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding BalanceWarning}" Foreground="#E74C3C" FontWeight="Bold" TextWrapping="Wrap" MaxWidth="300"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Button Command="{Binding SaveSettlementCommand}"
                        Content="اعتماد العملية وترحيل الحساب"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="#2D3436" BorderBrush="#2D3436"
                        Height="56" FontSize="18" FontWeight="Bold"
                        Margin="0,40,0,0" md:ButtonAssist.CornerRadius="12"
                        IsEnabled="{Binding IsInsufficientFunds, Converter={StaticResource InverseBooleanConverter}}"
                        auth:PermissionAssist.Required="Employees.Salaries,Employees.Advances">
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="15" Opacity="0.2" ShadowDepth="5" Color="Black"/>
                    </Button.Effect>
                </Button>
            </StackPanel>
        </Border>

        <!-- Side Panel -->
        <Border Grid.Column="1" Background="#F8F9FA" CornerRadius="16" Padding="20">
            <StackPanel>
                <TextBlock Text="كشف سريع" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" Foreground="#2C3E50"/>

                <md:Card Background="White" UniformCornerRadius="12" Padding="16" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="الرصيد الحالي" FontSize="12" Foreground="#7F8C8D"/>
                        <TextBlock Text="{Binding CurrentBalance, Converter={StaticResource CurrencyConverter}}" 
                                   FontSize="28" FontWeight="Black" 
                                   Foreground="{Binding CurrentBalance, Converter={StaticResource BalanceBrushConverter}}"
                                   Margin="0,4,0,0"/>
                        <TextBlock Text="مستحق للموظف" FontSize="11" Foreground="#95A5A6" Visibility="{Binding CurrentBalance, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </md:Card>

                <TextBlock Text="آخر 5 عمليات" FontSize="14" FontWeight="Bold" Margin="0,0,0,12" Foreground="#57606F"/>
                
                <ItemsControl ItemsSource="{Binding LastTransactions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="0,0,0,1" BorderBrush="#EBEDF0" Padding="0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Type, Converter={StaticResource EnumToLocConverter}}" FontSize="12" FontWeight="SemiBold" Foreground="#2C3E50"/>
                                        <TextBlock Text="{Binding Date, StringFormat=d}" FontSize="10" Foreground="#95A5A6"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Amount, StringFormat=N0}" 
                                               FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Foreground="#34495E"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                
                <Button Command="{Binding ShowLedgerCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}" 
                        Content="فتح كشف الحساب الكامل" 
                        Margin="0,20,0,0" FontSize="13" FontWeight="SemiBold" Foreground="#8B5E4C"
                        auth:PermissionAssist.Required="Employees.View"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
