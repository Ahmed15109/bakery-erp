<UserControl x:Class="Bakery.WPF.Views.EmployeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:loc="clr-namespace:Bakery.Shared.Helpers;assembly=Bakery.Shared"
             xmlns:auth="clr-namespace:Bakery.WPF.Authorization"
             Background="#FBF9F7"
             FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header & Search -->
            <RowDefinition Height="Auto" /> <!-- Statistics -->
            <RowDefinition Height="*" />    <!-- Main Data Table -->
        </Grid.RowDefinitions>

        <!-- 1. HEADER & SEARCH -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="إدارة الموظفين" FontSize="26" FontWeight="Black" Foreground="#2D2422"/>
                <TextBlock Text="بيانات العاملين، الرواتب والإنتاج" FontSize="13" Foreground="#8B7E7A" Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Command="{Binding NavigateToJobRolesCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="#8B5E4C"
                        Height="44" Margin="0,0,12,0" md:ButtonAssist.CornerRadius="10"
                        auth:PermissionAssist.Required="Employees.View">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="BriefcaseAccount" Margin="0,0,6,0" VerticalAlignment="Center" Width="18" Height="18"/>
                        <TextBlock Text="إدارة الوظائف" FontWeight="Bold" FontSize="14"/>
                    </StackPanel>
                </Button>

                <md:Card UniformCornerRadius="10" Padding="4" md:ElevationAssist.Elevation="Dp1" Margin="0,0,12,0" Background="White">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Search" Width="18" Height="18" VerticalAlignment="Center" Margin="10,0,6,0" Foreground="#A39490"/>
                        <TextBox Width="300" 
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 md:HintAssist.Hint="بحث سريع..."
                                 BorderThickness="0"
                                 VerticalAlignment="Center"
                                 FontSize="13"
                                 Padding="0,6"/>
                    </StackPanel>
                </md:Card>

                <Button Command="{Binding AddEmployeeCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="#8B5E4C" BorderBrush="#8B5E4C"
                        Height="44" md:ButtonAssist.CornerRadius="10"
                        md:ElevationAssist.Elevation="Dp2"
                        auth:PermissionAssist.Required="Employees.Add">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="AccountPlus" Margin="0,0,6,0" VerticalAlignment="Center" Width="18" Height="18"/>
                        <TextBlock Text="إضافة موظف" FontWeight="Bold" FontSize="14"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. STATISTICS CARDS -->
        <Grid Grid.Row="1" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <md:Card Grid.Column="0" UniformCornerRadius="12" Margin="0,0,12,0" md:ElevationAssist.Elevation="Dp1" Background="White">
                <Border Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="48" Height="48" CornerRadius="10" Background="#FDF4F1" VerticalAlignment="Center">
                            <md:PackIcon Kind="AccountGroup" Foreground="#E67E22" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="إجمالي الموظفين" FontSize="12" Foreground="#8B7E7A" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalEmployees}" FontSize="24" FontWeight="Black" Foreground="#2D2422" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </md:Card>

            <md:Card Grid.Column="1" UniformCornerRadius="12" Margin="0,0,12,0" md:ElevationAssist.Elevation="Dp1" Background="White">
                <Border Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="48" Height="48" CornerRadius="10" Background="#E9F7EF" VerticalAlignment="Center">
                            <md:PackIcon Kind="AccountCheck" Foreground="#27AE60" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="الموظفين النشطين" FontSize="12" Foreground="#8B7E7A" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ActiveEmployees}" FontSize="24" FontWeight="Black" Foreground="#2D2422" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </md:Card>

            <md:Card Grid.Column="2" UniformCornerRadius="12" Margin="0,0,12,0" md:ElevationAssist.Elevation="Dp1" Background="White">
                <Border Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="48" Height="48" CornerRadius="10" Background="#FEF9E7" VerticalAlignment="Center">
                            <md:PackIcon Kind="CurrencyUsd" Foreground="#F1C40F" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="إجمالي الرواتب" FontSize="12" Foreground="#8B7E7A" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalWagesText}" FontSize="24" FontWeight="Black" Foreground="#2D2422" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </md:Card>

            <md:Card Grid.Column="3" UniformCornerRadius="12" md:ElevationAssist.Elevation="Dp1" Background="White">
                <Border Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="48" Height="48" CornerRadius="10" Background="#EBF5FB" VerticalAlignment="Center">
                            <md:PackIcon Kind="ChartLine" Foreground="#3498DB" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="متوسط الأداء" FontSize="12" Foreground="#8B7E7A" FontWeight="SemiBold"/>
                            <TextBlock Text="94%" FontSize="24" FontWeight="Black" Foreground="#2D2422" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </md:Card>
        </Grid>

        <!-- 3. EMPLOYEES DATAGRID -->
        <md:Card Grid.Row="2" UniformCornerRadius="16" md:ElevationAssist.Elevation="Dp2" Background="White" Padding="0">
            <DataGrid ItemsSource="{Binding Employees}"
                      SelectedItem="{Binding SelectedEmployee}"
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False"
                      Style="{StaticResource MaterialDesignDataGrid}"
                      Background="Transparent"
                      RowHeight="64"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F0EDE9"
                      BorderThickness="0"
                      SelectionUnit="FullRow"
                      EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      md:DataGridAssist.CellPadding="16,8">
                
                <DataGrid.Resources>
                    <!-- Header Style -->
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                        <Setter Property="Background" Value="#F8F6F4"/>
                        <Setter Property="Foreground" Value="#5D4B46"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Height" Value="48"/>
                        <Setter Property="Padding" Value="16,0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#E5E1DA"/>
                    </Style>

                    <!-- Professional Zebra Row Style -->
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                        <Style.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                <Setter Property="Background" Value="#FDFBFA"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F5F1EF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <!-- Employee Profile Column -->
                    <DataGridTemplateColumn Header="الموظف" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="40" Height="40" CornerRadius="20" Background="#E5E1DA" BorderBrush="White" BorderThickness="2">
                                        <TextBlock Text="{Binding Name, Converter={StaticResource StringToInitialConverter}}" 
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" 
                                                   FontWeight="Bold" Foreground="#8B7E7A" FontSize="14"/>
                                    </Border>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#2D2422" FontSize="13"/>
                                        <TextBlock Text="{Binding JobRole.Name}" FontSize="11" Foreground="#8B7E7A" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="رقم الهاتف" Binding="{Binding Phone}" Width="140" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#5D4B46"/>
                                <Setter Property="FontSize" Value="12"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Status Badge -->
                    <DataGridTemplateColumn Header="الحالة" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Padding="8,4" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FDEDEC"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background" Value="#E9F7EF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding IsActive, Converter={StaticResource BooleanToStatusConverter}}" FontSize="10" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#E74C3C"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Foreground" Value="#27AE60"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Employee Wage Info -->
                    <DataGridTemplateColumn Header="نظام الأجر" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding WageType, Converter={StaticResource EnumToLocConverter}}" 
                                           VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11" Foreground="#5D4B46"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="قيمة الأجر" Binding="{Binding CurrentWageAmount, StringFormat='N2'}" Width="120" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#8B5E4C"/>
                                <Setter Property="FontSize" Value="13"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Professional Action Buttons -->
                    <DataGridTemplateColumn Header="الإجراءات" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignIconButton}" 
                                            Width="32" Height="32" Padding="0" Margin="4,0"
                                            ToolTip="تنشيط / تعطيل الموظف"
                                            auth:PermissionAssist.Required="Employees.Edit">
                                        <md:PackIcon Kind="{Binding IsActive, Converter={StaticResource BooleanToActiveIconConverter}}" Width="20" Height="20" Foreground="#78909C"/>
                                    </Button>

                                    <Button Command="{Binding DataContext.EditEmployeeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignIconButton}"
                                            Width="32" Height="32" Padding="0" Margin="4,0"
                                            ToolTip="تعديل بيانات الموظف"
                                            auth:PermissionAssist.Required="Employees.Edit">
                                        <md:PackIcon Kind="PencilOutline" Width="20" Height="20" Foreground="#78909C"/>
                                    </Button>

                                    <Button Command="{Binding DataContext.DeleteEmployeeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignIconButton}"
                                            Width="32" Height="32" Padding="0" Margin="4,0"
                                            ToolTip="حذف الموظف"
                                            Foreground="#EF5350"
                                            auth:PermissionAssist.Required="Employees.Delete">
                                        <md:PackIcon Kind="DeleteOutline" Width="20" Height="20"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </md:Card>
    </Grid>
</UserControl>
