<UserControl x:Class="Bakery.WPF.Views.EmployeeStatementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             FlowDirection="RightToLeft">
    <Grid>
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="#F8F9FA" Padding="16" BorderThickness="0,0,0,1" BorderBrush="#E0E0E0">
                <DockPanel>
                    <TextBlock Text="كشف حساب الموظف" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <DatePicker md:HintAssist.Hint="من" Width="160" Margin="0,0,12,0"
                                    Style="{StaticResource ReportFilterDatePickerStyle}"/>
                        <DatePicker md:HintAssist.Hint="إلى" Width="160" Margin="0,0,12,0"
                                    Style="{StaticResource ReportFilterDatePickerStyle}"/>
                        <Button Content="تحديث" Style="{StaticResource MaterialDesignRaisedButton}" Background="#8B5E4C" BorderBrush="#8B5E4C"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <DataGrid ItemsSource="{Binding LastTransactions}" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      Background="White"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F0F0F0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=d}" Width="120"/>
                    <DataGridTextColumn Header="البيان" Binding="{Binding Notes}" Width="*"/>
                    <DataGridTemplateColumn Header="مدين (سحب)" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Amount, StringFormat=N2}" Foreground="#E74C3C" FontWeight="Bold" 
                                           Visibility="{Binding Type, Converter={StaticResource InverseTransactionTypeToVisibilityConverter}, ConverterParameter=Earned}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="دائن (استحقاق)" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Amount, StringFormat=N2}" Foreground="#27AE60" FontWeight="Bold" 
                                           Visibility="{Binding Type, Converter={StaticResource TransactionTypeToVisibilityConverter}, ConverterParameter=Earned}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
