<Window x:Class="Bakery.WPF.Views.EmployeeLedgerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:conv="clr-namespace:Bakery.WPF.Converters"
        Title="كشف حساب الموظف" Height="800" Width="1000"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft" Background="#F1F2F6">
    
    <Window.Resources>
        <conv:BalanceToBrushConverter x:Key="BalanceBrushConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <DockPanel Margin="24">
            <!-- Header: Employee Info & Quick Actions -->
            <Border DockPanel.Dock="Top" Background="White" CornerRadius="16" Padding="24" Margin="0,0,0,20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Opacity="0.08" ShadowDepth="3"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding Employee.Name}" FontSize="28" FontWeight="Black" Foreground="#2D3436"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <md:Chip Content="{Binding Employee.JobRole.Name}" Background="#DFE6E9" Foreground="#636E72" Margin="0,0,10,0"/>
                            <md:Chip Content="{Binding Employee.WageType, Converter={StaticResource EnumToLocConverter}}" Background="#FFEAA7" Foreground="#D6A317"/>
                            <TextBlock Text="تاريخ البدء:" VerticalAlignment="Center" Margin="16,0,8,0" Foreground="#B2BEC3" FontSize="12"/>
                            <TextBlock Text="{Binding Employee.HireDate}" VerticalAlignment="Center" Foreground="#636E72" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="صافي الرصيد المستحق" FontSize="12" Foreground="#B2BEC3" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding CurrentBalance, Converter={StaticResource CurrencyConverter}}" 
                                   FontSize="36" FontWeight="Black" 
                                   Foreground="{Binding CurrentBalance, Converter={StaticResource BalanceBrushConverter}}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Action Toolbar -->
            <Border DockPanel.Dock="Top" Background="#2D3436" CornerRadius="12" Padding="12" Margin="0,0,0,20">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding PayEmployeeCommand}" 
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#00B894" BorderBrush="#00B894"
                                Foreground="White" Margin="0,0,12,0" md:ButtonAssist.CornerRadius="8">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Cash" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="صرف مستحقات" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding AddAdvanceCommand}" 
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#E17055" BorderBrush="#E17055"
                                Foreground="White" Margin="0,0,12,0" md:ButtonAssist.CornerRadius="8">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="HandCoin" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="سحب مقدم" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding AddBonusCommand}" 
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="#55EFC4" BorderBrush="#55EFC4"
                                Margin="0,0,12,0" md:ButtonAssist.CornerRadius="8">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="PlusCircle" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="مكافأة" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding AddDeductionCommand}" 
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="#FAB1A0" BorderBrush="#FAB1A0"
                                Margin="0,0,12,0" md:ButtonAssist.CornerRadius="8">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="MinusCircle" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="خصم" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding LoadLedgerCommand}" Style="{StaticResource MaterialDesignIconButton}" Foreground="White">
                            <md:PackIcon Kind="Refresh" />
                        </Button>
                        <Button Command="{Binding PrintCommand}" Style="{StaticResource MaterialDesignIconButton}" Foreground="White">
                            <md:PackIcon Kind="Printer" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Summary Footer -->
            <Border DockPanel.Dock="Bottom" Background="White" CornerRadius="0,0,16,16" Padding="20" BorderThickness="0,1,0,0" BorderBrush="#F1F2F6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="إجمالي الاستحقاق" FontSize="11" Foreground="#B2BEC3"/>
                        <TextBlock Text="{Binding TotalEarned, StringFormat=N0}" FontSize="18" FontWeight="Bold" Foreground="#2D3436"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="إجمالي المكافآت" FontSize="11" Foreground="#B2BEC3"/>
                        <TextBlock Text="{Binding TotalBonuses, StringFormat=N0}" FontSize="18" FontWeight="Bold" Foreground="#27AE60"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="إجمالي الخصومات" FontSize="11" Foreground="#B2BEC3"/>
                        <TextBlock Text="{Binding TotalDeductions, StringFormat=N0}" FontSize="18" FontWeight="Bold" Foreground="#E74C3C"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <TextBlock Text="إجمالي المدفوع" FontSize="11" Foreground="#B2BEC3"/>
                        <TextBlock Text="{Binding TotalPaid, StringFormat=N0}" FontSize="18" FontWeight="Bold" Foreground="#2980B9"/>
                    </StackPanel>

                    <Button Grid.Column="4" Content="إغلاق الكشف" IsCancel="True" 
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#636E72" BorderBrush="#636E72"
                            md:ButtonAssist.CornerRadius="8"/>
                </Grid>
            </Border>

            <!-- DataGrid Container -->
            <Border Background="White" CornerRadius="16,16,0,0">
                <DataGrid ItemsSource="{Binding LedgerEntries}" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True"
                          Background="Transparent"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F1F2F6"
                          RowHeight="50"
                          AlternatingRowBackground="#FAFAFA"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          HeadersVisibility="Column">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8F9FA"/>
                            <Setter Property="Foreground" Value="#636E72"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="16,12"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#EBEDF0"/>
                        </Style>
                    </DataGrid.Resources>
                    
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=yyyy-MM-dd HH:mm}" Width="150">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="16,0"/>
                                    <Setter Property="Foreground" Value="#636E72"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="النوع" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" Margin="8,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F1F2F6"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RawType}" Value="Earned">
                                                        <Setter Property="Background" Value="#E8F8F5"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RawType}" Value="Bonus">
                                                        <Setter Property="Background" Value="#EBF5FB"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RawType}" Value="Advance">
                                                        <Setter Property="Background" Value="#FDEDEC"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RawType}" Value="Deduction">
                                                        <Setter Property="Background" Value="#FEF9E7"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Type}" FontSize="11" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#57606F"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RawType}" Value="Earned">
                                                            <Setter Property="Foreground" Value="#16A085"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RawType}" Value="Bonus">
                                                            <Setter Property="Foreground" Value="#2980B9"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RawType}" Value="Advance">
                                                            <Setter Property="Foreground" Value="#C0392B"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RawType}" Value="Deduction">
                                                            <Setter Property="Foreground" Value="#D68910"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="البيان والتفاصيل" Binding="{Binding Description}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="Foreground" Value="#2D3436"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="مدين (+)" Binding="{Binding Debit, StringFormat=N0}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#27AE60"/>
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Debit}" Value="0">
                                            <Setter Property="Text" Value="-"/>
                                            <Setter Property="Foreground" Value="#DFE6E9"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="دائن (-)" Binding="{Binding Credit, StringFormat=N0}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#E74C3C"/>
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Credit}" Value="0">
                                            <Setter Property="Text" Value="-"/>
                                            <Setter Property="Foreground" Value="#DFE6E9"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="الرصيد" Binding="{Binding RunningBalance, StringFormat=N0}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Black"/>
                                    <Setter Property="Padding" Value="0,0,16,0"/>
                                    <Setter Property="TextAlignment" Value="Left"/>
                                    <Setter Property="Foreground" Value="{Binding RunningBalance, Converter={StaticResource BalanceBrushConverter}}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>
    </Grid>
</Window>
