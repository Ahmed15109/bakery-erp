<UserControl x:Class="Bakery.WPF.Views.TreasuryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Bakery.WPF.Converters"
             xmlns:enums="clr-namespace:Bakery.Domain.Enums;assembly=Bakery.Domain"
             xmlns:auth="clr-namespace:Bakery.WPF.Authorization"
             Background="#F8F8F8"
             FontFamily="Cairo, Segoe UI"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <converters:EnumToLocConverter x:Key="EnumToLocConverter"/>
        <converters:NullableMovementAmountConverter x:Key="MovementAmountConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Treasury-only compact field styles. The Material Design outlined
             defaults reserve 32px vertically for floating hints, which clips
             Arabic glyphs when a compact field uses the default padding. -->
        <Style x:Key="TreasuryFilterTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource HighContrastFilterTextBox}">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#2F2A27"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="False"/>
            <Setter Property="materialDesign:HintAssist.HintOpacity" Value="0.72"/>
            <Setter Property="materialDesign:HintAssist.Foreground" Value="#7A716C"/>
            <Setter Property="materialDesign:TextFieldAssist.TextBoxViewMargin" Value="0"/>
            <Setter Property="materialDesign:TextFieldAssist.TextBoxViewVerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TreasuryFilterComboBoxStyle"
               TargetType="ComboBox"
               BasedOn="{StaticResource HighContrastFilterComboBox}">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#2F2A27"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="False"/>
            <Setter Property="materialDesign:HintAssist.HintOpacity" Value="0.72"/>
            <Setter Property="materialDesign:HintAssist.Foreground" Value="#7A716C"/>
            <Setter Property="materialDesign:TextFieldAssist.TextBoxViewMargin" Value="0"/>
            <Setter Property="materialDesign:TextFieldAssist.TextBoxViewVerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TreasuryFilterDatePickerStyle"
               TargetType="DatePicker"
               BasedOn="{StaticResource HighContrastFilterDatePicker}">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#2F2A27"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="False"/>
            <Setter Property="materialDesign:HintAssist.HintOpacity" Value="0.72"/>
            <Setter Property="materialDesign:HintAssist.Foreground" Value="#7A716C"/>
            <Setter Property="materialDesign:TextFieldAssist.TextBoxViewMargin" Value="0"/>
            <Setter Property="materialDesign:TextFieldAssist.TextBoxViewVerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TreasuryActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Height" Value="80"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8B5E3C"/>
            <Setter Property="BorderBrush" Value="#D9C8BC"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="12"/>
            <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF3EA"/>
                    <Setter Property="BorderBrush" Value="#C67C4E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ArabicCellTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="8,0"/>
        </Style>

        <Style x:Key="NumericCellTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
            <Setter Property="FontFamily" Value="Cairo, Segoe UI"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24" MinWidth="960">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- KPIs -->
            <RowDefinition Height="Auto"/> <!-- Filters -->
            <RowDefinition Height="*"/>    <!-- Grid -->
        </Grid.RowDefinitions>

        <!-- 1. HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="الخزينة" FontSize="26" FontWeight="Black" Foreground="#2F2A27"/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="{Binding CurrentSafeName}" FontSize="13" FontWeight="SemiBold" Foreground="#7A716C"/>
                    <TextBlock Text="{Binding CurrentTreasurySubtitle}" FontSize="13" Foreground="#7A716C" Margin="8,0,0,0"/>
                    <TextBlock Text="جاري تحديث البيانات..." FontSize="11" Foreground="#8B5E3C" Margin="10,0,0,0"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <TextBlock Text="{Binding LoadError}" Margin="0,2,0,0" FontSize="12" Foreground="#D32F2F"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox ItemsSource="{Binding Safes}"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding SelectedTreasuryId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Width="280" Height="48" Margin="0,0,8,0"
                          Style="{StaticResource TreasuryFilterComboBoxStyle}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}"
                                       Margin="4,0" Padding="0,1"
                                       FontSize="14" FontWeight="SemiBold" Foreground="#2F2A27"
                                       VerticalAlignment="Center" TextAlignment="Right"
                                       TextWrapping="NoWrap"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <StackPanel Orientation="Horizontal" Visibility="{Binding IsInitializationRequired, Converter={StaticResource BoolToVis}}">
                    <DatePicker SelectedDate="{Binding BusinessDate}" Width="125" Height="48" Margin="0,0,8,0"
                                Style="{StaticResource TreasuryFilterDatePickerStyle}"/>
                    <Button Command="{Binding InitializeSystemCommand}" Width="48" Height="48" Padding="0" Margin="0,0,8,0"
                            Style="{StaticResource MaterialDesignOutlinedButton}" ToolTip="فتح يوم العمل"
                            materialDesign:ButtonAssist.CornerRadius="10"
                            auth:PermissionAssist.Required="WorkingDay.Open">
                        <materialDesign:PackIcon Kind="CalendarPlus" Width="19" Height="19"/>
                    </Button>
                </StackPanel>
                <Button Command="{Binding EndDayCommand}" Width="48" Height="48" Margin="0,0,8,0" Padding="0"
                        Style="{StaticResource MaterialDesignOutlinedButton}" ToolTip="إنهاء يوم العمل"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Visibility="{Binding HasOpenDay, Converter={StaticResource BoolToVis}}"
                        auth:PermissionAssist.Required="WorkingDay.Close">
                    <materialDesign:PackIcon Kind="CalendarCheckOutline" Width="19" Height="19" Foreground="#D32F2F"/>
                </Button>
                <Button Command="{Binding PrintReportCommand}" Width="48" Height="48" Margin="0,0,8,0" Padding="0"
                        Style="{StaticResource MaterialDesignOutlinedButton}" ToolTip="طباعة تقرير الخزينة المحددة"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        auth:PermissionAssist.Required="Reports.Financial">
                    <materialDesign:PackIcon Kind="PrinterOutline" Width="19" Height="19"/>
                </Button>
                <Button Command="{Binding ManageSafesCommand}" Width="48" Height="48" Padding="0"
                        Style="{StaticResource MaterialDesignOutlinedButton}" ToolTip="إدارة الخزن"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        auth:PermissionAssist.Required="Treasury.ManageSafes">
                    <materialDesign:PackIcon Kind="CogOutline" Width="19" Height="19"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. KPIs AND COMPACT WORKING-DAY SUMMARY -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*"/>
                    <ColumnDefinition Width="1.25*"/>
                    <ColumnDefinition Width="1.25*"/>
                    <ColumnDefinition Width="0.75*"/>
                    <ColumnDefinition Width="0.75*"/>
                    <ColumnDefinition Width="0.75*"/>
                </Grid.ColumnDefinitions>

                <materialDesign:Card Grid.Column="0" Height="80" UniformCornerRadius="12" Margin="0,0,12,0"
                                     materialDesign:ElevationAssist.Elevation="Dp1" Background="White">
                    <Border Padding="20,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="WalletOutline" Width="26" Height="26" Foreground="#8B5E3C"
                                                     VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="الرصيد الحالي" FontSize="12" Foreground="#6B625D" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding CurrentSafeBalance, StringFormat='{}{0:N2} ج.م'}"
                                           Margin="0,2,0,0" FontSize="24" FontWeight="Black" Foreground="#8B5E3C"
                                           FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </materialDesign:Card>

                <materialDesign:Card Grid.Column="1" Height="80" UniformCornerRadius="12" Margin="0,0,12,0"
                                     materialDesign:ElevationAssist.Elevation="Dp1" Background="White">
                    <Border Padding="20,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="ArrowDownCircleOutline" Width="26" Height="26" Foreground="#2E7D32"
                                                     VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="مقبوضات اليوم" FontSize="12" Foreground="#6B625D" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TodayIncome, StringFormat='{}{0:N2} ج.م'}"
                                           Margin="0,2,0,0" FontSize="24" FontWeight="Black" Foreground="#2E7D32"
                                           FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </materialDesign:Card>

                <materialDesign:Card Grid.Column="2" Height="80" UniformCornerRadius="12" Margin="0,0,12,0"
                                     materialDesign:ElevationAssist.Elevation="Dp1" Background="White">
                    <Border Padding="20,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="ArrowUpCircleOutline" Width="26" Height="26" Foreground="#D32F2F"
                                                     VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="مدفوعات اليوم" FontSize="12" Foreground="#6B625D" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TodayExpenses, StringFormat='{}{0:N2} ج.م'}"
                                           Margin="0,2,0,0" FontSize="24" FontWeight="Black" Foreground="#D32F2F"
                                           FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </materialDesign:Card>

                <Button Grid.Column="3" Command="{Binding TransactionCommand}" CommandParameter="Deposit"
                        Style="{StaticResource TreasuryActionButtonStyle}"
                        auth:PermissionAssist.Required="Cash.Deposit">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="PlusCircleOutline" Width="22" Height="22" HorizontalAlignment="Center"/>
                        <TextBlock Text="إيداع" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="4" Command="{Binding TransactionCommand}" CommandParameter="Withdraw"
                        Style="{StaticResource TreasuryActionButtonStyle}"
                        auth:PermissionAssist.Required="Cash.Withdraw">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="MinusCircleOutline" Width="22" Height="22" HorizontalAlignment="Center"/>
                        <TextBlock Text="سحب" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="5" Command="{Binding TransferCommand}" Height="80" Padding="12,8"
                        FontSize="14" FontWeight="SemiBold" Foreground="#8B5E3C"
                        BorderBrush="#D9C8BC" Background="White"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        materialDesign:ButtonAssist.CornerRadius="12"
                        materialDesign:ElevationAssist.Elevation="Dp1"
                        auth:PermissionAssist.Required="Treasury.Transfer">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="SwapHorizontal" Width="22" Height="22" HorizontalAlignment="Center"/>
                        <TextBlock Text="تحويل" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <materialDesign:Card Grid.Column="0" Height="64" UniformCornerRadius="12" Margin="0,0,10,0"
                                     materialDesign:ElevationAssist.Elevation="Dp1" Background="White">
                    <Border Padding="12,8">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="دورة العمل" FontSize="11" Foreground="#7A716C"/>
                            <TextBlock Text="{Binding DayStatusText}" FontSize="14" FontWeight="SemiBold" Foreground="#8B5E3C" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </materialDesign:Card>
                <materialDesign:Card Grid.Column="1" Height="64" UniformCornerRadius="12" Margin="0,0,10,0"
                                     materialDesign:ElevationAssist.Elevation="Dp1" Background="White">
                    <Border Padding="12,8">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="تاريخ يوم العمل" FontSize="11" Foreground="#7A716C"/>
                            <TextBlock Text="{Binding TreasurySummary.BusinessDate, StringFormat='{}{0:dd/MM/yyyy}'}" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </materialDesign:Card>
                <materialDesign:Card Grid.Column="2" Height="64" UniformCornerRadius="12" Margin="0,0,10,0"
                                     materialDesign:ElevationAssist.Elevation="Dp1" Background="White">
                    <Border Padding="12,8">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="النقد المتوقع" FontSize="11" Foreground="#7A716C"/>
                            <TextBlock Text="{Binding ExpectedCash, StringFormat='{}{0:N2}'}" FontSize="14" FontWeight="SemiBold"
                                       FlowDirection="LeftToRight" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </materialDesign:Card>
                <materialDesign:Card Grid.Column="3" Height="64" UniformCornerRadius="12" Margin="0,0,10,0"
                                     materialDesign:ElevationAssist.Elevation="Dp1" Background="White">
                    <Border Padding="12,8">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="رصيد الافتتاح" FontSize="11" Foreground="#7A716C"/>
                            <TextBlock Text="{Binding OpeningBalance, StringFormat='{}{0:N2}'}" FontSize="14" FontWeight="SemiBold"
                                       FlowDirection="LeftToRight" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </materialDesign:Card>
                <materialDesign:Card Grid.Column="4" Height="64" UniformCornerRadius="12" Margin="0,0,10,0"
                                     materialDesign:ElevationAssist.Elevation="Dp1" Background="White">
                    <Border Padding="12,8">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="مبيعات اليوم" FontSize="11" Foreground="#7A716C"/>
                            <TextBlock Text="{Binding TodaySales, StringFormat='{}{0:N2}'}" FontSize="14" FontWeight="SemiBold" Foreground="#2E7D32"
                                       FlowDirection="LeftToRight" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </materialDesign:Card>
                <materialDesign:Card Grid.Column="5" Height="64" UniformCornerRadius="12"
                                     materialDesign:ElevationAssist.Elevation="Dp1" Background="White">
                    <Border Padding="12,8">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="الرصيد المرحل" FontSize="11" Foreground="#7A716C"/>
                            <TextBlock Text="{Binding CarriedBalance, StringFormat='{}{0:N2}'}" FontSize="14" FontWeight="SemiBold" Foreground="#C67C4E"
                                       FlowDirection="LeftToRight" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </materialDesign:Card>
            </Grid>
        </Grid>

        <!-- 3. FILTERS -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Width="140" Height="48" Margin="0,0,8,0">
                <DatePicker SelectedDate="{Binding LedgerStartDate}"
                            Style="{StaticResource TreasuryFilterDatePickerStyle}"/>
                <TextBlock Text="من تاريخ" Margin="12,0" FontSize="13" Foreground="#7A716C" Opacity="0.72"
                           HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False"
                           Visibility="{Binding LedgerStartDate, Converter={StaticResource NullToVis}, ConverterParameter=Invert}"/>
            </Grid>
            <Grid Grid.Column="1" Width="140" Height="48" Margin="0,0,8,0">
                <DatePicker SelectedDate="{Binding LedgerEndDate}"
                            Style="{StaticResource TreasuryFilterDatePickerStyle}"/>
                <TextBlock Text="إلى تاريخ" Margin="12,0" FontSize="13" Foreground="#7A716C" Opacity="0.72"
                           HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False"
                           Visibility="{Binding LedgerEndDate, Converter={StaticResource NullToVis}, ConverterParameter=Invert}"/>
            </Grid>
            <ComboBox Grid.Column="2" ItemsSource="{Binding MovementTypeFilters}"
                      SelectedItem="{Binding SelectedMovementTypeFilter}" DisplayMemberPath="Label"
                      Width="165" Height="48" Margin="0,0,8,0"
                      Style="{StaticResource TreasuryFilterComboBoxStyle}"/>
            <Grid Grid.Column="3" MinWidth="210" Height="48" Margin="0,0,8,0">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{Binding ActiveDateRangeText}"
                         Style="{StaticResource TreasuryFilterTextBoxStyle}"/>
                <TextBlock Text="بحث بالرقم أو البيان أو المستخدم أو الملاحظات"
                           Margin="12,0" FontSize="13" Foreground="#7A716C" Opacity="0.72"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" IsHitTestVisible="False"
                           Visibility="{Binding SearchText, Converter={StaticResource NullToVis}, ConverterParameter=Invert}"/>
            </Grid>
            <Button Grid.Column="4" Command="{Binding ResetFiltersCommand}" Height="48" Padding="12,0" Margin="0,0,8,0"
                    Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#6B625D" BorderBrush="#DADADA"
                    materialDesign:ButtonAssist.CornerRadius="10">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="FilterRemoveOutline" Width="18" Height="18" Margin="0,0,6,0"/>
                    <TextBlock Text="إعادة تعيين"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="5" Command="{Binding RefreshCommand}" Width="48" Height="48" Padding="0"
                    Style="{StaticResource MaterialDesignOutlinedButton}" ToolTip="تحديث"
                    materialDesign:ButtonAssist.CornerRadius="10">
                <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" Foreground="#8B5E3C"/>
            </Button>
        </Grid>

        <!-- 4. SELECTED TREASURY LEDGER -->
        <materialDesign:Card Grid.Row="3" UniformCornerRadius="12"
                             materialDesign:ElevationAssist.Elevation="Dp2"
                             Background="White" Padding="0">
            <Grid>
                    <DataGrid ItemsSource="{Binding Transactions}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserResizeRows="False"
                              HeadersVisibility="Column"
                              Background="Transparent"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEEEEE"
                              RowHeight="46"
                              ColumnHeaderHeight="44"
                              AlternatingRowBackground="#FCFAF8"
                              AlternationCount="2"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              EnableRowVirtualization="True"
                              Style="{StaticResource MaterialDesignDataGrid}">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                <Setter Property="Background" Value="#FAF8F6"/>
                                <Setter Property="Foreground" Value="#4E4641"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="9,0"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFF3EA"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsReversed}" Value="True">
                                        <Setter Property="Foreground" Value="#8A8A8A"/>
                                        <Setter Property="Background" Value="#F5F5F5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم الحركة" Binding="{Binding DisplayTransactionNumber}" Width="115" MinWidth="105"
                                                ElementStyle="{StaticResource NumericCellTextStyle}"/>
                            <DataGridTextColumn Header="التاريخ والوقت" Binding="{Binding Date, StringFormat='dd/MM/yyyy HH:mm'}" Width="140" MinWidth="130"
                                                ElementStyle="{StaticResource NumericCellTextStyle}"/>
                            <DataGridTextColumn Header="نوع الحركة" Binding="{Binding Type, Converter={StaticResource EnumToLocConverter}}" Width="120" MinWidth="110"
                                                ElementStyle="{StaticResource ArabicCellTextStyle}"/>
                            <DataGridTextColumn Header="البيان" Binding="{Binding Description}" Width="2*" MinWidth="220"
                                                ElementStyle="{StaticResource ArabicCellTextStyle}"/>
                            <DataGridTextColumn Header="وارد" Binding="{Binding Incoming, Converter={StaticResource MovementAmountConverter}}" Width="92" MinWidth="86">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCellTextStyle}">
                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="صادر" Binding="{Binding Outgoing, Converter={StaticResource MovementAmountConverter}}" Width="92" MinWidth="86">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NumericCellTextStyle}">
                                        <Setter Property="Foreground" Value="#D32F2F"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="الرصيد بعد الحركة" Binding="{Binding RunningBalance, StringFormat='N2'}" Width="125" MinWidth="118"
                                                ElementStyle="{StaticResource NumericCellTextStyle}"/>
                            <DataGridTextColumn Header="المستخدم" Binding="{Binding CreatedBy}" Width="110" MinWidth="100"
                                                ElementStyle="{StaticResource ArabicCellTextStyle}"/>
                            <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="1.2*" MinWidth="135"
                                                ElementStyle="{StaticResource ArabicCellTextStyle}"/>
                            <DataGridTemplateColumn Header="" Width="48">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.ReverseCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" Width="30" Height="30" Padding="0"
                                                ToolTip="إلغاء المعاملة النقدية">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Origin}" Value="{x:Static enums:CashMovementOrigin.Manual}"/>
                                                                <Condition Binding="{Binding IsReversed}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <materialDesign:PackIcon Kind="Undo" Width="17" Height="17" Foreground="#D32F2F"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasTransactions}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <materialDesign:PackIcon Kind="ReceiptTextOutline" Width="38" Height="38" Foreground="#C9B9AE" HorizontalAlignment="Center"/>
                        <TextBlock Text="لا توجد حركات لهذه الخزينة خلال الفترة المحددة"
                                   Margin="0,10,0,0" FontSize="14" Foreground="#7A716C"/>
                    </StackPanel>

                    <Border Background="#80FFFFFF" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                        <ProgressBar Width="160" Height="4" IsIndeterminate="True" Foreground="#C67C4E"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
