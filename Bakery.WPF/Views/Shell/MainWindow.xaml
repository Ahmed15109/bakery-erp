<Window x:Class="Bakery.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Bakery.WPF.Views"
        xmlns:viewModels="clr-namespace:Bakery.WPF.ViewModels"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:loc="clr-namespace:Bakery.Shared.Helpers;assembly=Bakery.Shared"
        Title="{x:Static loc:Loc.AppTitle}"
        MinHeight="720"
        MinWidth="1180"
        Height="820"
        Width="1280"
        Background="#F6F3EF"
        FontFamily="Cairo, Segoe UI"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ItemsViewModel}">
            <views:ItemsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:UnitsViewModel}">
            <views:UnitsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:InventoryViewModel}">
            <views:InventoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:InventoryHomeViewModel}">
            <views:InventoryHomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:StockCountViewModel}">
            <views:StockCountView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:InventoryMovementsViewModel}">
            <views:InventoryMovementsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:PartiesViewModel}">
            <views:PartiesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:PartyStatementViewModel}">
            <views:PartyStatementView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SalesViewModel}">
            <views:SalesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:PurchasesViewModel}">
            <views:PurchasesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ProductionViewModel}">
            <views:ProductionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:WasteViewModel}">
            <views:WasteView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:EmployeesViewModel}">
            <views:EmployeesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:EmployeeWagesViewModel}">
            <views:EmployeeWagesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:JobRolesViewModel}">
            <views:JobRolesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SettlementViewModel}">
            <views:SettlementView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:RecipesViewModel}">
            <views:RecipesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ReportsViewModel}">
            <views:ReportsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ReportDetailsViewModel}">
            <views:ReportDetailsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:UsersViewModel}">
            <views:UsersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:RolesViewModel}">
            <views:RolesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:AuditLogViewModel}">
            <views:AuditLogView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:BranchesViewModel}">
            <views:BranchesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:BackupManagementViewModel}">
            <views:BackupManagementView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:TreasuryViewModel}">
            <views:TreasuryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:InvoiceWorkspaceViewModel}">
            <views:InvoiceWorkspaceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ProductionOrderViewModel}">
            <views:ProductionOrdersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ProductionHistoryViewModel}">
            <views:ProductionHistoryView />
        </DataTemplate>
    </Window.Resources>

    <materialDesign:DialogHost Identifier="RootDialog" CloseOnClickAway="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Column 0 is visually on the RIGHT because of RTL FlowDirection -->
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ── Sidebar (RIGHT in RTL) ──────────────────────────────────────── -->
            <Border Grid.Column="0" Background="#2B211D" CornerRadius="0,24,24,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Color="Black" Opacity="0.15" Direction="180" ShadowDepth="4"/>
                </Border.Effect>
                
                <DockPanel LastChildFill="True">
                    <!-- Branding Header -->
                    <StackPanel DockPanel.Dock="Top" Margin="20,32,20,32">
                        <Grid HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Ellipse Width="64" Height="64" Fill="#3D2F29" />
                            <materialDesign:PackIcon Kind="BreadSlice" Width="32" Height="32" 
                                                     Foreground="#8B5E4C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{x:Static loc:Loc.AppTitle}"
                                   Foreground="White"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   TextAlignment="Center"/>
                        <TextBlock Text="{x:Static loc:Loc.SidebarSubtitle}"
                                   Margin="0,4,0,0"
                                   Foreground="#A2938D"
                                   FontSize="11"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Navigation List -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding NavigationItems}" Margin="0,0,0,20">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="{Binding GroupMargin}">
                                        <Button Style="{StaticResource SidebarButtonStyle}"
                                                Command="{Binding NavigateCommand}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Kind="{Binding IconKind}"
                                                                         Width="20" Height="20"
                                                                         VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Title}"
                                                           VerticalAlignment="Center"
                                                           Margin="8,0,0,0"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"/>
                                                <materialDesign:PackIcon Grid.Column="2"
                                                                         Kind="ChevronDown"
                                                                         Width="18" Height="18"
                                                                         VerticalAlignment="Center"
                                                                         Foreground="#A2938D"
                                                                         RenderTransformOrigin="0.5,0.5">
                                                    <materialDesign:PackIcon.RenderTransform>
                                                        <RotateTransform Angle="0" />
                                                    </materialDesign:PackIcon.RenderTransform>
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasSubItems}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                    <Setter Property="Foreground" Value="White" />
                                                                    <DataTrigger.EnterActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                                 To="180" Duration="0:0:0.2">
                                                                                    <DoubleAnimation.EasingFunction>
                                                                                        <QuadraticEase EasingMode="EaseInOut" />
                                                                                    </DoubleAnimation.EasingFunction>
                                                                                </DoubleAnimation>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.EnterActions>
                                                                    <DataTrigger.ExitActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                                 To="0" Duration="0:0:0.2">
                                                                                    <DoubleAnimation.EasingFunction>
                                                                                        <QuadraticEase EasingMode="EaseInOut" />
                                                                                    </DoubleAnimation.EasingFunction>
                                                                                </DoubleAnimation>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.ExitActions>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                            </Grid>
                                        </Button>

                                        <!-- Submenu Items -->
                                        <ItemsControl ItemsSource="{Binding SubItems}" Margin="0,3,0,6">
                                            <ItemsControl.Style>
                                                <Style TargetType="ItemsControl">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.Style>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource SidebarSubItemButtonStyle}"
                                                            Command="{Binding NavigateCommand}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="26" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <materialDesign:PackIcon Kind="{Binding IconKind}"
                                                                                     Width="16" Height="16"
                                                                                     VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Title}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="6,0,0,0"
                                                                       FontSize="13"
                                                                       FontWeight="Medium"/>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ── Main content area (LEFT in RTL) ────────────────────────────── -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="72" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Top bar -->
                <Border Grid.Row="0" Background="Transparent">
                    <Grid Margin="24,0">
                        <Grid.ColumnDefinitions>
                            <!-- In RTL, Column 0 is the visual right, Column 1 is visual left -->
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" 
                                   Text="{Binding Title}"
                                   VerticalAlignment="Center"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#1F1F1F"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,16,0" />

                        <!-- User Tools (Aligned Left/Start in RTL) -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
                            <Border Background="#F7F1EC" CornerRadius="12" Padding="10,5" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CalendarClockOutline" Width="16" Height="16"
                                                             Foreground="#8B5E4C" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding CurrentWorkingDayStatus}" Margin="6,0,0,0"
                                               Foreground="#5D4037" FontSize="12" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <materialDesign:Card UniformCornerRadius="16" Width="32" Height="32" Background="#E8DED7" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Account" Width="20" Height="20" 
                                                         Foreground="#8B5E4C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </materialDesign:Card>
                            
                            <TextBlock Text="{Binding CurrentUserName}"
                                       VerticalAlignment="Center"
                                       Foreground="#1F1F1F"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="12,0,12,0" />

                            <!-- Branch Switch Button -->
                            <Button Command="{Binding SwitchBranchCommand}"
                                    Background="#F0EBE6"
                                    Padding="10,4"
                                    Height="32"
                                    materialDesign:ButtonAssist.CornerRadius="12"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                        <!-- Default states when CanSwitchBranch is True -->
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="ToolTip" Value="{x:Static loc:Loc.SwitchBranch}" />
                                        <Setter Property="IsHitTestVisible" Value="True" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanSwitchBranch}" Value="False">
                                                <Setter Property="Cursor" Value="Arrow" />
                                                <Setter Property="ToolTip" Value="{x:Null}" />
                                                <Setter Property="IsHitTestVisible" Value="False" />
                                                <Setter Property="Focusable" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="StorefrontOutline" Width="16" Height="16" 
                                                             Foreground="#8B5E4C" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding CurrentBranchName}"
                                               VerticalAlignment="Center"
                                               Foreground="#5D4037"
                                               FontSize="13"
                                               FontWeight="SemiBold"/>
                                    <materialDesign:PackIcon Kind="ChevronDown" Width="14" Height="14" 
                                                             Foreground="#8B5E4C" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanSwitchBranch}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </StackPanel>
                            </Button>

                            <!-- Safe Switch Button -->
                            <Button Command="{Binding SwitchSafeCommand}"
                                    Background="#E8F4F8"
                                    Padding="10,4"
                                    Height="32"
                                    materialDesign:ButtonAssist.CornerRadius="12"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                        <!-- Default states when CanSwitchSafe is True -->
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="ToolTip" Value="تبديل الخزنة" />
                                        <Setter Property="IsHitTestVisible" Value="True" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanSwitchSafe}" Value="False">
                                                <Setter Property="Cursor" Value="Arrow" />
                                                <Setter Property="ToolTip" Value="{x:Null}" />
                                                <Setter Property="IsHitTestVisible" Value="False" />
                                                <Setter Property="Focusable" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Safe" Width="16" Height="16" 
                                                             Foreground="#107C41" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding CurrentSafeName}"
                                               VerticalAlignment="Center"
                                               Foreground="#107C41"
                                               FontSize="13"
                                               FontWeight="SemiBold"/>
                                    <materialDesign:PackIcon Kind="ChevronDown" Width="14" Height="14" 
                                                             Foreground="#107C41" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanSwitchSafe}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding LogoutCommand}"
                                    Style="{StaticResource MaterialDesignIconButton}"
                                    Foreground="#D32F2F"
                                    VerticalAlignment="Center"
                                    ToolTip="{x:Static loc:Loc.Logout}">
                                <materialDesign:PackIcon Kind="Logout" Width="20" Height="20" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Page Content -->
                <Border Grid.Row="1" Margin="24,0,24,24" Background="White" CornerRadius="24">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Color="Black" Opacity="0.05" ShadowDepth="2"/>
                    </Border.Effect>
                    <ContentControl Content="{Binding CurrentViewModel}" Margin="24"/>
                </Border>
            </Grid>
        </Grid>
    </materialDesign:DialogHost>
</Window>
