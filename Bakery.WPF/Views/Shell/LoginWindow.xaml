<Window x:Class="Bakery.WPF.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:loc="clr-namespace:Bakery.Shared.Helpers;assembly=Bakery.Shared"
        mc:Ignorable="d"
        Title="{x:Static loc:Loc.AppTitle}" 
        Height="720" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Cairo, Segoe UI"
        FlowDirection="RightToLeft">

    <Border x:Name="MainContainer" 
            Background="#F6F3EF" 
            CornerRadius="24" 
            ClipToBounds="True"
            Margin="20"
            Opacity="1"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" Color="Black" Opacity="0.25" ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="480" /> <!-- Branding Panel (Left in RTL is Col 0) -->
                <ColumnDefinition Width="*" />   <!-- Login Form (Right in RTL is Col 1) -->
            </Grid.ColumnDefinitions>

            <!-- ── Left Branding Panel ──────────────────────────────────────── -->
            <Border Grid.Column="0" CornerRadius="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2B211D" Offset="0" />
                        <GradientStop Color="#42342E" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>

                <Grid Margin="60">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <!-- Large Bakery Icon -->
                        <materialDesign:PackIcon Kind="BreadSlice" 
                                                 Width="120" Height="120" 
                                                 Foreground="#8B5E4C" 
                                                 HorizontalAlignment="Center"/>
                        
                        <TextBlock Text="{x:Static loc:Loc.AppTitle}" 
                                   Foreground="White" 
                                   FontSize="44" 
                                   FontWeight="Bold" 
                                   Margin="0,32,0,8" 
                                   TextAlignment="Center"/>
                        
                        <TextBlock Text="حلول ذكية لإدارة المخابز الحديثة" 
                                   Foreground="#A2938D" 
                                   FontSize="18" 
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>

                        <!-- Decorative Divider -->
                        <Rectangle Height="2" Width="60" Fill="#8B5E4C" Margin="0,40,0,0" />
                    </StackPanel>

                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center">
                        <TextBlock Text="{x:Static loc:Loc.AppVersionInfo}" 
                                   Foreground="#6B5D57" 
                                   FontSize="12" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Right Login Form ────────────────────────────────────────── -->
            <Grid Grid.Column="1" Margin="80,0">
                <StackPanel x:Name="LoginForm"
                            VerticalAlignment="Center"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                            Opacity="1">
                    <StackPanel.RenderTransform>
                        <TranslateTransform Y="0"/>
                    </StackPanel.RenderTransform>

                    <!-- Header -->
                    <TextBlock Text="مرحباً بك" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Foreground="#8B5E4C" 
                               Margin="0,0,0,8"/>
                    
                    <TextBlock Text="{x:Static loc:Loc.AppTitle}" 
                               FontSize="42" 
                               FontWeight="Bold" 
                               Foreground="#1F1F1F" 
                               Margin="0,0,0,12"/>
                    
                    <TextBlock Text="{x:Static loc:Loc.SignInToContinue}" 
                               FontSize="18" 
                               Foreground="#7A7A7A" 
                               Margin="0,0,0,48"
                               TextWrapping="Wrap"/>

                    <!-- Inputs -->
                    <StackPanel Margin="0,0,0,24">
                        <!-- Branch Selector ComboBox -->
                        <materialDesign:Card materialDesign:ElevationAssist.Elevation="Dp2" 
                                             UniformCornerRadius="12" 
                                             Background="White"
                                             Margin="0,0,0,16">
                            <ComboBox x:Name="BranchInput"
                                      materialDesign:HintAssist.Hint="{x:Static loc:Loc.BranchLabel}"
                                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                      FontSize="16"
                                      Padding="16,8"
                                      Height="56"
                                      BorderThickness="0"
                                      ItemsSource="{Binding Branches}"
                                      SelectedItem="{Binding SelectedBranch}"
                                      DisplayMemberPath="Name"/>
                        </materialDesign:Card>

                        <!-- Branch-scoped user selector with built-in incremental search. -->
                        <materialDesign:Card materialDesign:ElevationAssist.Elevation="Dp2" 
                                             UniformCornerRadius="12" 
                                             Background="White"
                                             Margin="0,0,0,16">
                            <ComboBox x:Name="UserInput"
                                      materialDesign:HintAssist.Hint="{x:Static loc:Loc.HintUsername}"
                                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                      FontSize="16"
                                      Padding="16,8"
                                      Height="56"
                                      BorderThickness="0"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      StaysOpenOnEdit="True"
                                      TextSearch.TextPath="Username"
                                      ItemsSource="{Binding Users}"
                                      SelectedItem="{Binding SelectedUser}"
                                      DisplayMemberPath="Username">
                                <ComboBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding LoginCommand}"/>
                                </ComboBox.InputBindings>
                            </ComboBox>
                        </materialDesign:Card>

                        <!-- Password PasswordBox -->
                        <materialDesign:Card materialDesign:ElevationAssist.Elevation="Dp2" 
                                             UniformCornerRadius="12" 
                                             Background="White">
                            <PasswordBox x:Name="PasswordInput"
                                         materialDesign:HintAssist.Hint="{x:Static loc:Loc.HintPassword}"
                                         Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                                         FontSize="16"
                                         Padding="16,8"
                                         Height="56"
                                         BorderThickness="0"
                                         PasswordChanged="PasswordInput_OnPasswordChanged">
                                <PasswordBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding LoginCommand}"/>
                                </PasswordBox.InputBindings>
                            </PasswordBox>
                        </materialDesign:Card>
                    </StackPanel>

                    <!-- Error Message -->
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#D32F2F"
                               FontSize="14"
                               Margin="0,0,0,24"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Login Button -->
                    <Button x:Name="LoginButton"
                            Command="{Binding LoginCommand}"
                            Height="58"
                            materialDesign:ButtonAssist.CornerRadius="16"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#8B5E4C"
                            BorderBrush="#8B5E4C"
                            FontSize="18"
                            FontWeight="Bold">
                        <Grid HorizontalAlignment="Stretch">
                            <TextBlock Text="{x:Static loc:Loc.Login}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <materialDesign:PackIcon Kind="ArrowLeft" 
                                                     Width="24" Height="24" 
                                                     VerticalAlignment="Center" 
                                                     HorizontalAlignment="Left" 
                                                     Margin="-10,0,0,0"/>
                        </Grid>
                    </Button>

                </StackPanel>

                <!-- Window Control (Exit) -->
                <Button VerticalAlignment="Top" 
                        HorizontalAlignment="Left" 
                        Margin="-60,24,0,0"
                        Style="{StaticResource MaterialDesignIconButton}"
                        Foreground="#7A7A7A"
                        Click="ExitButton_Click">
                    <materialDesign:PackIcon Kind="Close" Width="24" Height="24"/>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
