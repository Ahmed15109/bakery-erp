<Window x:Class="Bakery.WPF.FirstRunSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="إعداد مسؤول النظام"
        Width="760"
        Height="720"
        MinWidth="680"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="#F6F3EF"
        FontFamily="Cairo, Segoe UI"
        FlowDirection="RightToLeft">
    <Grid Margin="42">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <materialDesign:PackIcon Kind="ShieldAccount" Width="52" Height="52" Foreground="#8B5E4C"/>
            <TextBlock Text="الإعداد الأول لنظام المخبز"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#2B211D"
                       Margin="0,12,0,6"/>
            <TextBlock Text="أنشئ حساب مسؤول النظام الأول. لن يسمح النظام بإنشاء مسؤول أول آخر بعد إكمال هذه الخطوة."
                       FontSize="16"
                       Foreground="#6B5D57"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
                <TextBox materialDesign:HintAssist.Hint="اسم المستخدم"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="100"
                         Margin="0,0,0,14"/>
                <TextBox materialDesign:HintAssist.Hint="الاسم الكامل"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="150"
                         Margin="0,0,0,14"/>
                <PasswordBox x:Name="PasswordInput"
                             materialDesign:HintAssist.Hint="كلمة المرور"
                             Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                             PasswordChanged="PasswordInput_OnPasswordChanged"
                             Margin="0,0,0,14"/>
                <PasswordBox x:Name="ConfirmPasswordInput"
                             materialDesign:HintAssist.Hint="تأكيد كلمة المرور"
                             Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                             PasswordChanged="ConfirmPasswordInput_OnPasswordChanged"
                             Margin="0,0,0,14">
                    <PasswordBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding CreateAdministratorCommand}"/>
                    </PasswordBox.InputBindings>
                </PasswordBox>
                <TextBlock Text="{Binding PasswordPolicyText}"
                           Foreground="#6B5D57"
                           TextWrapping="Wrap"
                           Margin="0,0,0,14"/>
                <Border Background="#FDECEC"
                        BorderBrush="#E3A5A5"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#A61B1B" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,24,0,0">
            <Button Command="{Binding CreateAdministratorCommand}"
                    Height="54"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#8B5E4C"
                    BorderBrush="#8B5E4C"
                    FontSize="17"
                    FontWeight="SemiBold"
                    Content="إنشاء مسؤول النظام والمتابعة"/>
            <ProgressBar IsIndeterminate="True"
                         Height="4"
                         VerticalAlignment="Bottom"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>
    </Grid>
</Window>
