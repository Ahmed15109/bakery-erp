<UserControl x:Class="Bakery.WPF.Views.PartyStatementView" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:loc="clr-namespace:Bakery.WPF.Helpers">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header & Summaries -->
            <RowDefinition Height="*"/>    <!-- Ledger Grid -->
        </Grid.RowDefinitions>

        <!-- Header and Summary Cards -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <DockPanel Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="كشف حساب طرف" FontSize="28" FontWeight="Black" Foreground="#2D3436"/>
                    <TextBlock Text="{Binding Summary.Name}" FontSize="16" Foreground="#636E72" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Command="{Binding PayCommand}" IsEnabled="{Binding CanPay}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Cash" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="سداد للمورد" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCustomer}" Value="True">
                                                <Setter Property="Text" Value="استلام من العميل" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RefreshCommand}" Style="{StaticResource MaterialDesignIconButton}" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Refresh" Width="24" Height="24"/>
                    </Button>
                </StackPanel>
            </DockPanel>

            <UniformGrid Columns="3">
                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,16,0" BorderBrush="#E8DED7" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{Binding IncreaseHeader}" Foreground="#636E72" FontSize="13"/>
                        <TextBlock Text="{Binding Summary.TotalIncrease, StringFormat='N2'}" FontSize="24" FontWeight="Black" Foreground="#2D3436" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,16,0" BorderBrush="#E8DED7" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{Binding DecreaseHeader}" Foreground="#636E72" FontSize="13"/>
                        <TextBlock Text="{Binding Summary.TotalDecrease, StringFormat='N2'}" FontSize="24" FontWeight="Black" Foreground="#2D3436" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#2D3436" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <TextBlock Text="الرصيد الحالي" Foreground="#B2BEC3" FontSize="13"/>
                        <TextBlock Text="{Binding Summary, Converter={StaticResource PartyBalanceToStringConverter}}" FontSize="24" FontWeight="Black" Foreground="{Binding Summary, Converter={StaticResource PartyBalanceToBrushConverter}}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>

        <!-- Classic Accounting Ledger Grid -->
        <Border Grid.Row="1" Background="White" CornerRadius="0" BorderBrush="#D1D5DB" BorderThickness="1" Padding="0">
            <DataGrid ItemsSource="{Binding Lines}" 
                      SelectedItem="{Binding SelectedLine}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      Background="White" BorderThickness="0"
                      GridLinesVisibility="All" 
                      VerticalGridLinesBrush="#E5E7EB"
                      HorizontalGridLinesBrush="#F3F4F6"
                      RowHeight="34" ColumnHeaderHeight="40"
                      EnableRowVirtualization="True"
                      loc:DataGridPersistence.PersistenceId="PartyStatementGrid"
                      Style="{StaticResource MaterialDesignDataGrid}">
                
                <DataGrid.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenSelectedInvoiceCommand}" />
                </DataGrid.InputBindings>

                <DataGrid.Resources>
                    <!-- Proxy for Header Binding -->
                    <loc:BindingProxy x:Key="Proxy" Data="{Binding}"/>

                    <!-- 1. Strong Classic Header Style -->
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                        <Setter Property="Background" Value="#E5E7EB"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="FontWeight" Value="Black"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="BorderBrush" Value="#D1D5DB"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="Foreground" Value="#374151"/>
                    </Style>

                    <!-- 2. Classic Spreadsheet Cell Style -->
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                        <Setter Property="BorderThickness" Value="0,0,1,0"/>
                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#DBEAFE"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>

                    <!-- 3. Base Financial TextBlock Style -->
                    <Style x:Key="ClassicAccountingText" TargetType="TextBlock">
                        <Setter Property="FontFamily" Value="Consolas"/>
                        <Setter Property="FontSize" Value="12.5"/>
                        <Setter Property="FlowDirection" Value="LeftToRight"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="TextAlignment" Value="Right"/>
                        <Setter Property="HorizontalAlignment" Value="Right"/>
                        <Setter Property="Margin" Value="0,0,12,0"/> 
                    </Style>

                    <!-- Specialized Templates for Spreadsheet Precision -->
                    <DataTemplate x:Key="InvoiceCellTemplate">
                        <TextBlock Text="{Binding Increase, StringFormat='N2'}" 
                                   Style="{StaticResource ClassicAccountingText}" 
                                   FontWeight="Bold" Foreground="#111827"/>
                    </DataTemplate>

                    <DataTemplate x:Key="PaidCellTemplate">
                        <TextBlock Text="{Binding Decrease, StringFormat='N2'}" 
                                   Style="{StaticResource ClassicAccountingText}" 
                                   FontWeight="SemiBold" Foreground="#2563EB"/>
                    </DataTemplate>

                    <DataTemplate x:Key="RemainingCellTemplate">
                        <TextBlock Text="{Binding Remaining, StringFormat='N2'}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ClassicAccountingText}">
                                    <Setter Property="Foreground" Value="#DC2626"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Remaining}" Value="0">
                                            <Setter Property="Foreground" Value="#9CA3AF"/>
                                            <Setter Property="FontWeight" Value="Normal"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>

                    <DataTemplate x:Key="BalanceCellTemplate">
                        <TextBlock Text="{Binding RunningBalance, StringFormat='N2'}" 
                                   Style="{StaticResource ClassicAccountingText}" 
                                   FontWeight="Black" FontSize="13.5" Foreground="#000000"
                                   Margin="0,0,16,0"/>
                    </DataTemplate>
                </DataGrid.Resources>

                <!-- Classic Structured Row Style -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                        <Setter Property="Background" Value="White"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F9FAFB"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding ReferenceType}" Value="SaleInvoice">
                                <Setter Property="Background" Value="#F0FDF4"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ReferenceType}" Value="PurchaseInvoice">
                                <Setter Property="Background" Value="#F0FDF4"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ReferenceType}" Value="Payment">
                                <Setter Property="Background" Value="#EFF6FF"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <!-- Date Column -->
                    <DataGridTextColumn Header="التاريخ" 
                                        Binding="{Binding Date, StringFormat='dd/MM/yyyy hh:mm tt'}" 
                                        Width="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Padding" Value="8,0"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Foreground" Value="#4B5563"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    
                    <!-- Description Column -->
                    <DataGridTextColumn Header="البيان" 
                                        Binding="{Binding Description}" 
                                        Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="Padding" Value="8,0"/>
                                <Setter Property="Foreground" Value="#1F2937"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    
                    <!-- Structured Financial Columns -->
                    <DataGridTemplateColumn Header="{Binding Data.IncreaseHeader, Source={StaticResource Proxy}}" 
                                            CellTemplate="{StaticResource InvoiceCellTemplate}"
                                            Width="120" />
                    
                    <DataGridTemplateColumn Header="المسدد" 
                                            CellTemplate="{StaticResource PaidCellTemplate}"
                                            Width="120" />

                    <DataGridTemplateColumn Header="المتبقي" 
                                            CellTemplate="{StaticResource RemainingCellTemplate}"
                                            Width="120" />

                    <DataGridTemplateColumn Header="الرصيد الجاري" 
                                            CellTemplate="{StaticResource BalanceCellTemplate}"
                                            Width="140" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
