<UserControl x:Class="Bakery.WPF.Views.PartiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:loc="clr-namespace:Bakery.Shared.Helpers;assembly=Bakery.Shared"
             xmlns:auth="clr-namespace:Bakery.WPF.Authorization"
             Background="#FBF9F7"
             FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="Auto" /> <!-- Stats -->
            <RowDefinition Height="Auto" /> <!-- Filters/Toolbar -->
            <RowDefinition Height="*" />    <!-- Main Content -->
        </Grid.RowDefinitions>

        <!-- 1. HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="سجل الأطراف" FontSize="26" FontWeight="Black" Foreground="#2D2422"/>
                <TextBlock Text="إدارة العملاء، الموردين وجهات الاتصال" FontSize="13" Foreground="#8B7E7A" Margin="0,2,0,0"/>
            </StackPanel>

            <Button Grid.Column="1" Command="{Binding AddPartyCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#8B5E4C" BorderBrush="#8B5E4C"
                    Height="44" md:ButtonAssist.CornerRadius="10"
                    md:ElevationAssist.Elevation="Dp2"
                    auth:PermissionAssist.Required="Customers.Add,Purchases.Create,Employees.Add">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="AccountPlus" Margin="0,0,6,0" VerticalAlignment="Center" Width="18" Height="18"/>
                    <TextBlock Text="إضافة طرف جديد" FontWeight="Bold" FontSize="14"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- 2. STATISTICS CARDS -->
        <Grid Grid.Row="1" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <md:Card Grid.Column="0" UniformCornerRadius="12" Margin="0,0,10,0" md:ElevationAssist.Elevation="Dp1" Background="White">
                <Border Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="48" Height="48" CornerRadius="10" Background="#F0FDF4" VerticalAlignment="Center">
                            <md:PackIcon Kind="AccountGroup" Foreground="#16A34A" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="العملاء" FontSize="12" Foreground="#8B7E7A" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Stats.TotalCustomers}" FontSize="24" FontWeight="Black" Foreground="#2D2422" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </md:Card>

            <md:Card Grid.Column="1" UniformCornerRadius="12" Margin="0,0,10,0" md:ElevationAssist.Elevation="Dp1" Background="White">
                <Border Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="48" Height="48" CornerRadius="10" Background="#EFF6FF" VerticalAlignment="Center">
                            <md:PackIcon Kind="TruckDelivery" Foreground="#2563EB" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="الموردين" FontSize="12" Foreground="#8B7E7A" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Stats.TotalSuppliers}" FontSize="24" FontWeight="Black" Foreground="#2D2422" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </md:Card>

            <md:Card Grid.Column="2" UniformCornerRadius="12" Margin="0,0,10,0" md:ElevationAssist.Elevation="Dp1" Background="White">
                <Border Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="48" Height="48" CornerRadius="10" Background="#FDF4FF" VerticalAlignment="Center">
                            <md:PackIcon Kind="AccountTie" Foreground="#A855F7" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="الموظفين" FontSize="12" Foreground="#8B7E7A" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Stats.TotalEmployees}" FontSize="24" FontWeight="Black" Foreground="#2D2422" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </md:Card>

            <md:Card Grid.Column="3" UniformCornerRadius="12" md:ElevationAssist.Elevation="Dp1" Background="White">
                <Border Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="48" Height="48" CornerRadius="10" Background="#FFF7ED" VerticalAlignment="Center">
                            <md:PackIcon Kind="CurrencyUsd" Foreground="#EA580C" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="إجمالي الأرصدة" FontSize="12" Foreground="#8B7E7A" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Stats.NetBalance, StringFormat='N0'}" FontSize="24" FontWeight="Black" Foreground="#2D2422" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </md:Card>
        </Grid>

        <!-- 3. FILTERS & SEARCH -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0" 
                     Style="{StaticResource MaterialDesignChoiceChipPrimaryOutlineListBox}"
                     SelectedIndex="{Binding SelectedTabIndex}"
                     SelectionMode="Single"
                     Background="Transparent">
                <ListBoxItem Content="الكل" />
                <ListBoxItem Content="العملاء" />
                <ListBoxItem Content="الموردين" />
                <ListBoxItem Content="الموظفين" />
            </ListBox>

            <md:Card Grid.Column="2" UniformCornerRadius="10" Padding="4" md:ElevationAssist.Elevation="Dp1" Background="White">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="Search" Width="18" Height="18" VerticalAlignment="Center" Margin="10,0,6,0" Foreground="#A39490"/>
                    <TextBox Width="300" 
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             md:HintAssist.Hint="بحث بالاسم أو الهاتف..."
                             BorderThickness="0"
                             VerticalAlignment="Center"
                             FontSize="13"
                             Padding="0,6"/>
                </StackPanel>
            </md:Card>
        </Grid>

        <!-- 4. MAIN CONTENT -->
        <Grid Grid.Row="3">
            <!-- DataGrid -->
            <md:Card UniformCornerRadius="12" md:ElevationAssist.Elevation="Dp2" Background="White" Padding="0">
                <Grid>
                    <DataGrid ItemsSource="{Binding Parties}"
                               SelectedItem="{Binding SelectedParty}"
                               AutoGenerateColumns="False" CanUserAddRows="False"
                               Style="{StaticResource MaterialDesignDataGrid}"
                               Background="Transparent"
                               RowHeight="64"
                               HeadersVisibility="Column"
                               AlternatingRowBackground="#FDFBFA"
                               GridLinesVisibility="Horizontal"
                               HorizontalGridLinesBrush="#F0EDE9"
                               BorderThickness="0"
                               SelectionUnit="FullRow"
                               EnableRowVirtualization="True"
                               VirtualizingPanel.IsVirtualizing="True"
                               VirtualizingPanel.VirtualizationMode="Recycling"
                               md:DataGridAssist.CellPadding="12,8">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                <Setter Property="Background" Value="#F8F6F4"/>
                                <Setter Property="Foreground" Value="#5D4B46"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Height" Value="44"/>
                                <Setter Property="Padding" Value="12,0"/>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <!-- Party Identity -->
                            <DataGridTemplateColumn Header="الطرف" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="40" Height="40" CornerRadius="20" Background="#E5E1DA">
                                                <TextBlock Text="{Binding Name, Converter={StaticResource StringToInitialConverter}}" 
                                                           VerticalAlignment="Center" HorizontalAlignment="Center" 
                                                           FontWeight="Bold" Foreground="#8B7E7A" FontSize="14"/>
                                            </Border>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#2D2422" FontSize="13"/>
                                                <TextBlock Text="{Binding Type, Converter={StaticResource EnumToLocConverter}}" FontSize="11" Foreground="#8B7E7A" Margin="0,1,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="رقم الهاتف" Binding="{Binding Phone}" Width="140" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#5D4B46"/>
                                        <Setter Property="FontSize" Value="12"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Balance -->
                            <DataGridTemplateColumn Header="الرصيد" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource PartyBalanceToStringConverter}}" 
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                                   FontWeight="Black" FontSize="13"
                                                   Foreground="{Binding Converter={StaticResource PartyBalanceToBrushConverter}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Actions -->
                            <DataGridTemplateColumn Header="الإجراءات" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button Command="{Binding DataContext.ShowStatementCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignIconButton}" 
                                                    Width="32" Height="32" Padding="0" Margin="4,0"
                                                    ToolTip="كشف الحساب"
                                                    auth:PermissionAssist.Required="Customers.View,Purchases.View,Employees.ViewSalary">
                                                <md:PackIcon Kind="FileDocumentOutline" Width="20" Height="20" Foreground="#78909C"/>
                                            </Button>

                                            <Button Command="{Binding DataContext.EditPartyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignIconButton}" 
                                                    Width="32" Height="32" Padding="0" Margin="4,0"
                                                    ToolTip="تعديل البيانات"
                                                    auth:PermissionAssist.Required="Customers.Edit,Purchases.Edit,Employees.Edit">
                                                <md:PackIcon Kind="PencilOutline" Width="20" Height="20" Foreground="#78909C"/>
                                            </Button>

                                            <Button Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignIconButton}" 
                                                    Width="32" Height="32" Padding="0" Margin="4,0"
                                                    ToolTip="تفعيل / تعطيل"
                                                    auth:PermissionAssist.Required="Customers.Edit,Purchases.Edit,Employees.Edit">
                                                <md:PackIcon Kind="{Binding IsActive, Converter={StaticResource BooleanToActiveIconConverter}}" Width="20" Height="20" Foreground="#78909C"/>
                                            </Button>
                                            
                                            <Button Command="{Binding DataContext.DeletePartyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignIconButton}" 
                                                    Width="32" Height="32" Padding="0" Margin="4,0"
                                                    ToolTip="حذف نهائي"
                                                    Foreground="#EF5350"
                                                    auth:PermissionAssist.Required="Customers.Delete,Purchases.Delete,Employees.Delete">
                                                <md:PackIcon Kind="DeleteOutline" Width="20" Height="20"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty State -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" 
                                Visibility="{Binding Parties.Count, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                        <md:PackIcon Kind="AccountSearch" Width="64" Height="64" Foreground="#E5E1DA"/>
                        <TextBlock Text="لا يوجد أطراف تطابق البحث" Margin="0,16,0,0" Foreground="#8B7E7A" FontSize="16" FontWeight="SemiBold"/>
                        <Button Command="{Binding ClearFilterCommand}" Content="مسح الفلتر" Margin="0,12,0,0" Style="{StaticResource MaterialDesignFlatButton}"/>
                    </StackPanel>
                </Grid>
            </md:Card>
        </Grid>
    </Grid>
</UserControl>
