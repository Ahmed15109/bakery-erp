<UserControl x:Class="Bakery.WPF.Views.ProductionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:loc="clr-namespace:Bakery.Shared.Helpers;assembly=Bakery.Shared"
             xmlns:auth="clr-namespace:Bakery.WPF.Authorization"
             Background="{StaticResource SurfaceBrush}"
             FlowDirection="RightToLeft">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Margin="0,0,0,32">
            <TextBlock Text="لوحة التحكم بالإنتاج" FontSize="32" FontWeight="Black" Foreground="{StaticResource SidebarBrush}"/>
            <TextBlock Text="متابعة عمليات التصنيع وإدارة الوصفات" FontSize="16" Foreground="#6B625D" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Summary Cards -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Total Recipes -->
            <md:Card Grid.Column="0" Margin="0,0,16,0" Padding="24" UniformCornerRadius="20" Background="White">
                <StackPanel>
                    <md:PackIcon Kind="ReceiptTextOutline" Width="32" Height="32" Foreground="#8B5E4C" Margin="0,0,0,16"/>
                    <TextBlock Text="عدد الوصفات" Foreground="#6B625D" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TotalRecipes}" FontSize="36" FontWeight="Black" Foreground="{StaticResource SidebarBrush}"/>
                </StackPanel>
            </md:Card>

            <!-- Today's Orders -->
            <md:Card Grid.Column="1" Margin="8,0,8,0" Padding="24" UniformCornerRadius="20" Background="White">
                <StackPanel>
                    <md:PackIcon Kind="PackageVariant" Width="32" Height="32" Foreground="#D97706" Margin="0,0,0,16"/>
                    <TextBlock Text="عمليات اليوم" Foreground="#6B625D" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TodayOrdersCount}" FontSize="36" FontWeight="Black" Foreground="{StaticResource SidebarBrush}"/>
                </StackPanel>
            </md:Card>

            <!-- Production Cost -->
            <md:Card Grid.Column="2" Margin="8,0,8,0" Padding="24" UniformCornerRadius="20" Background="White">
                <StackPanel>
                    <md:PackIcon Kind="CurrencyUsd" Width="32" Height="32" Foreground="#C62828" Margin="0,0,0,16"/>
                    <TextBlock Text="تكلفة إنتاج اليوم" Foreground="#6B625D" FontSize="14" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding TodayProductionCost, StringFormat='N0'}" FontSize="36" FontWeight="Black" Foreground="{StaticResource SidebarBrush}"/>
                        <TextBlock Text="ج.م" FontSize="14" VerticalAlignment="Bottom" Margin="4,0,0,8" Foreground="#6B625D"/>
                    </StackPanel>
                </StackPanel>
            </md:Card>

            <!-- Produced Value -->
            <md:Card Grid.Column="3" Margin="16,0,0,0" Padding="24" UniformCornerRadius="20" Background="#8B5E4C">
                <StackPanel>
                    <md:PackIcon Kind="TrendingUp" Width="32" Height="32" Foreground="White" Margin="0,0,0,16"/>
                    <TextBlock Text="قيمة المنتجات اليوم" Foreground="#D6C8BE" FontSize="14" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding TodayProducedValue, StringFormat='N0'}" FontSize="36" FontWeight="Black" Foreground="White"/>
                        <TextBlock Text="ج.م" FontSize="14" VerticalAlignment="Bottom" Margin="4,0,0,8" Foreground="#D6C8BE"/>
                    </StackPanel>
                </StackPanel>
                <md:Card.Effect>
                    <DropShadowEffect BlurRadius="20" Color="#8B5E4C" Opacity="0.3" ShadowDepth="8"/>
                </md:Card.Effect>
            </md:Card>
        </Grid>

        <!-- Quick Actions -->
        <Grid Grid.Row="2" Margin="0,48,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,32,0">
                <TextBlock Text="إجراءات سريعة" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SidebarBrush}" Margin="0,0,0,24"/>
                
                <Button Command="{Binding NavigateToNewOrderCommand}" 
                        Style="{StaticResource MaterialDesignRaisedButton}" 
                        Background="#8B5E4C" BorderBrush="#8B5E4C"
                        Height="64" Margin="0,0,0,16" md:ButtonAssist.CornerRadius="16"
                        auth:PermissionAssist.Required="Production.Create">
                    <Grid HorizontalAlignment="Stretch">
                        <md:PackIcon Kind="PlusCircle" HorizontalAlignment="Left" VerticalAlignment="Center" Width="24" Height="24"/>
                        <TextBlock Text="أمر إنتاج جديد" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </StackPanel>

            <!-- Decorative Area or Recent Activity (Future) -->
            <md:Card Grid.Column="1" UniformCornerRadius="24" Padding="32" Background="White">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <md:PackIcon Kind="Factory" Width="120" Height="120" Foreground="#F3E8DF" HorizontalAlignment="Center"/>
                        <TextBlock Text="جاهز لبدء العملية الإنتاجية" FontSize="18" Foreground="#8B5E4C" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                        <TextBlock Text="اختر إجراءً من القائمة الجانبية للبدء" Foreground="#6B625D" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </md:Card>
        </Grid>
    </Grid>
</UserControl>
