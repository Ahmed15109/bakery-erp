<UserControl x:Class="Bakery.WPF.Views.WasteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Bakery.WPF.Converters"
             xmlns:auth="clr-namespace:Bakery.WPF.Authorization"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Summary card style -->
        <Style x:Key="SummaryCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" Opacity="0.06" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid header style -->
        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Foreground" Value="#6B7280"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24" Background="#F8F7F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Summary cards -->
            <RowDefinition Height="Auto"/>  <!-- Filters -->
            <RowDefinition Height="*"/>     <!-- Table -->
        </Grid.RowDefinitions>

        <!-- ══ 1. HEADER ══ -->
        <Border Grid.Row="0" Background="White" CornerRadius="16" Padding="24,18" Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Opacity="0.04" ShadowDepth="1"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="10" Background="#FEF2F2" Margin="0,0,12,0" VerticalAlignment="Center">
                            <md:PackIcon Kind="AlertDecagram" Foreground="#E53E3E" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="الهالك والتالف" FontSize="24" FontWeight="Black" Foreground="#1A202C"/>
                            <TextBlock Text="تسجيل الأصناف التالفة وخصمها من المخزون" FontSize="12" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding RefreshCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Foreground="#718096" ToolTip="تحديث" Margin="0,0,8,0">
                        <md:PackIcon Kind="Refresh" Width="22" Height="22"/>
                    </Button>

                    <Button Command="{Binding OpenNewEntryDialogCommand}"
                            Height="42" Padding="18,0"
                            auth:PermissionAssist.Required="Production.Waste">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                <Setter Property="Background" Value="#E53E3E"/>
                                <Setter Property="BorderBrush" Value="#C53030"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="md:ButtonAssist.CornerRadius" Value="10"/>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Plus" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="تسجيل هالك جديد" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ 2. SUMMARY CARDS ══ -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,20">
            <!-- عدد عمليات الهالك اليوم -->
            <Border Style="{StaticResource SummaryCard}" Background="White" BorderBrush="#FEE2E2" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Width="32" Height="32" CornerRadius="8" Background="#FEF2F2" Margin="0,0,10,0">
                            <md:PackIcon Kind="FileDocumentOutline" Foreground="#E53E3E" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="عمليات الهالك اليوم" FontSize="12" FontWeight="SemiBold" Foreground="#718096" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding TodayCount}" FontSize="28" FontWeight="Black" Foreground="#1A202C"/>
                    <TextBlock Text="عملية" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- إجمالي الكمية التالفة اليوم -->
            <Border Style="{StaticResource SummaryCard}" Background="White" BorderBrush="#FEEBC8" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Width="32" Height="32" CornerRadius="8" Background="#FFFBEB" Margin="0,0,10,0">
                            <md:PackIcon Kind="PackageVariantRemove" Foreground="#D97706" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="إجمالي الكمية التالفة" FontSize="12" FontWeight="SemiBold" Foreground="#718096" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding TodayQuantity, StringFormat='N2'}" FontSize="28" FontWeight="Black" Foreground="#92400E"/>
                    <TextBlock Text="وحدة" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- قيمة الهالك اليوم -->
            <Border Style="{StaticResource SummaryCard}" Background="White" BorderBrush="#E9D5FF" BorderThickness="1" Margin="0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Width="32" Height="32" CornerRadius="8" Background="#F5F3FF" Margin="0,0,10,0">
                            <md:PackIcon Kind="CurrencyUsd" Foreground="#7C3AED" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="قيمة الهالك اليوم" FontSize="12" FontWeight="SemiBold" Foreground="#718096" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding TodayCost, StringFormat='N2'}" FontSize="28" FontWeight="Black" Foreground="#5B21B6"/>
                    <TextBlock Text="ج.م" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ══ 3. FILTERS ══ -->
        <Border Grid.Row="2" Background="White" CornerRadius="14" Padding="18,14" Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" Opacity="0.04" ShadowDepth="1"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search by item name -->
                <TextBox Grid.Column="0" Margin="0,0,10,0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         md:HintAssist.Hint="بحث باسم الصنف..."
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         md:TextFieldAssist.HasClearButton="True"/>

                <!-- From Date -->
                <DatePicker Grid.Column="1" Margin="0,0,10,0"
                            SelectedDate="{Binding FromDate}"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                            md:HintAssist.Hint="من تاريخ"/>

                <!-- To Date -->
                <DatePicker Grid.Column="2" Margin="0,0,10,0"
                            SelectedDate="{Binding ToDate}"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                            md:HintAssist.Hint="إلى تاريخ"/>

                <!-- Reason filter -->
                <ComboBox Grid.Column="3" Margin="0,0,10,0"
                          ItemsSource="{Binding Reasons}"
                          SelectedItem="{Binding SelectedReason}"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          md:HintAssist.Hint="السبب"/>

                <!-- Apply filters -->
                <Button Grid.Column="4" Margin="0,0,8,0"
                        Command="{Binding ApplyFiltersCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="#4A5568" BorderBrush="#4A5568"
                        Padding="16,0" Height="50"
                        Content="تطبيق"/>

                <!-- Clear filters -->
                <Button Grid.Column="5"
                        Command="{Binding ClearFiltersCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Padding="12,0" Height="50"
                        Content="مسح الفلاتر"/>
            </Grid>
        </Border>

        <!-- ══ 4. WASTE RECORDS TABLE ══ -->
        <Border Grid.Row="3" Background="White" CornerRadius="16" Padding="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" Opacity="0.05" ShadowDepth="2"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DataGrid ItemsSource="{Binding Entries}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Background="Transparent"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F3F4F6"
                          RowHeight="40"
                          ColumnHeaderHeight="38"
                          CanUserAddRows="False"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          Style="{StaticResource MaterialDesignDataGrid}">

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                            <Style.Triggers>
                                <Trigger Property="AlternationIndex" Value="1">
                                    <Setter Property="Background" Value="#FAFAFA"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FFF5F5"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <!-- التاريخ والوقت -->
                        <DataGridTextColumn Header="التاريخ والوقت"
                                            Binding="{Binding CreatedAt, StringFormat='yyyy/MM/dd  HH:mm'}"
                                            Width="160">
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Foreground" Value="#718096"/>
                                    <Setter Property="FlowDirection" Value="LeftToRight"/>
                                    <Setter Property="Padding" Value="12,0"/>
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>

                        <!-- الصنف -->
                        <DataGridTextColumn Header="الصنف" Binding="{Binding ItemName}" Width="*">
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#1A202C"/>
                                    <Setter Property="Padding" Value="12,0"/>
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>

                        <!-- الوحدة -->
                        <DataGridTextColumn Header="الوحدة" Binding="{Binding UnitSymbol}" Width="80"/>

                        <!-- الكمية -->
                        <DataGridTemplateColumn Header="الكمية" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Quantity, StringFormat='N2'}"
                                               Foreground="#E53E3E" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FlowDirection="LeftToRight"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- السبب -->
                        <DataGridTemplateColumn Header="السبب" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="8,3" CornerRadius="6" HorizontalAlignment="Center" Background="#FEF2F2">
                                        <TextBlock Text="{Binding Reason}" FontSize="11" FontWeight="Bold" Foreground="#C53030"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- الملاحظات -->
                        <DataGridTextColumn Header="الملاحظات" Binding="{Binding Notes}" Width="160">
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                                    <Setter Property="Foreground" Value="#718096"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Padding" Value="12,0"/>
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>

                        <!-- الرصيد بعد الخصم -->
                        <DataGridTemplateColumn Header="الرصيد بعد الخصم" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StockAfter, StringFormat='N2'}"
                                               Foreground="#276749" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FlowDirection="LeftToRight" FontFamily="Consolas"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- المستخدم -->
                        <DataGridTextColumn Header="المستخدم" Binding="{Binding CreatedBy}" Width="100">
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                                    <Setter Property="Foreground" Value="#9CA3AF"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Padding" Value="12,0"/>
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
