<UserControl x:Class="Bakery.WPF.Views.ProductionHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:loc="clr-namespace:Bakery.Shared.Helpers;assembly=Bakery.Shared"
             Background="{StaticResource SurfaceBrush}"
             FlowDirection="RightToLeft">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Margin="0,0,0,32">
            <TextBlock Text="سجل الإنتاج" FontSize="32" FontWeight="Black" Foreground="{StaticResource SidebarBrush}"/>
            <TextBlock Text="استعراض العمليات السابقة وتحليل النتائج" FontSize="16" Foreground="#6B625D" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Filters -->
        <md:Card Grid.Row="1" UniformCornerRadius="16" Padding="24" Margin="0,0,0,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="بحث بالرقم أو المنتج" FontSize="12" FontWeight="Bold" Foreground="#6B625D" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Width="300" md:HintAssist.Hint="رقم العملية / اسم الصنف..."
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 md:TextFieldAssist.TextFieldCornerRadius="10"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" Command="{Binding RefreshCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Height="50" md:ButtonAssist.CornerRadius="10">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Refresh" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="تحديث البيانات" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </Grid>
        </md:Card>

        <!-- History Grid -->
        <md:Card Grid.Row="2" UniformCornerRadius="16" Padding="0">
            <DataGrid ItemsSource="{Binding Orders}"
                      SelectedItem="{Binding SelectedOrder}"
                      AutoGenerateColumns="False" CanUserAddRows="False"
                      Style="{StaticResource MaterialDesignDataGrid}"
                      Background="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم العملية" Binding="{Binding ProductionNumber}" Width="150" IsReadOnly="True"/>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding StartedAt, StringFormat='g'}" Width="180" IsReadOnly="True"/>
                    <DataGridTextColumn Header="الوصفة" Binding="{Binding Recipe.Name}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding Status, Converter={StaticResource EnumToLocConverter}}" Width="120" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Completed">
                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                        <Setter Property="Foreground" Value="#C62828"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource MaterialDesignIconButton}" Foreground="#8B5E4C">
                                    <md:PackIcon Kind="EyeOutline" />
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </md:Card>
    </Grid>
</UserControl>
