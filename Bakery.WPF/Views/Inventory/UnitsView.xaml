<UserControl x:Class="Bakery.WPF.Views.UnitsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:loc="clr-namespace:Bakery.Shared.Helpers;assembly=Bakery.Shared"
             xmlns:auth="clr-namespace:Bakery.WPF.Authorization"
             FlowDirection="RightToLeft">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,14">
            <Button DockPanel.Dock="Left" Command="{Binding BackCommand}"
                    Style="{StaticResource InventoryBackButtonStyle}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowRight" Width="18" Height="18" Margin="0,0,6,0" />
                    <TextBlock Text="رجوع" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock Text="{x:Static loc:Loc.Units}" Style="{StaticResource InventoryPageTitleStyle}" />
                <TextBlock Text="إدارة وحدات القياس المستخدمة في الأصناف"
                           Style="{StaticResource InventoryPageSubtitleStyle}" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Padding="16" Margin="0,0,14,0" Background="#FCFAF9"
                    BorderBrush="#EEE9E6" BorderThickness="1" CornerRadius="10"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="بيانات الوحدة" FontSize="15" FontWeight="SemiBold"
                               Foreground="#2F2A27" Margin="0,0,0,14" />
                    <TextBox Text="{Binding Name}" Style="{StaticResource InventoryFormTextBoxStyle}"
                             materialDesign:HintAssist.Hint="{x:Static loc:Loc.HintName}" Margin="0,0,0,10" />
                    <TextBox Text="{Binding Symbol}" Style="{StaticResource InventoryFormTextBoxStyle}"
                             materialDesign:HintAssist.Hint="{x:Static loc:Loc.HintSymbol}" Margin="0,0,0,10" />
                    <CheckBox Content="{x:Static loc:Loc.Active}" IsChecked="{Binding IsActive}"
                              Margin="2,2,2,14" />
                    <Button Command="{Binding SaveCommand}" Style="{StaticResource InventoryPrimaryButtonStyle}"
                            Content="{x:Static loc:Loc.SaveUnit}"
                            HorizontalContentAlignment="Center"
                            auth:PermissionAssist.Required="Products.Add,Products.Edit" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="White" BorderBrush="#EEE9E6"
                    BorderThickness="1" CornerRadius="10">
                <DataGrid ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedUnit}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          Style="{StaticResource InventoryDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{x:Static loc:Loc.ColName}" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="{x:Static loc:Loc.ColSymbol}" Binding="{Binding Symbol}" Width="120" />
                        <DataGridCheckBoxColumn Header="{x:Static loc:Loc.ColActive}" Binding="{Binding IsActive}" Width="90" />
                        <DataGridTemplateColumn Header="{x:Static loc:Loc.ColActions}" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                auth:PermissionAssist.Required="Products.Edit"
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                Width="32" Height="32" Padding="0" ToolTip="{x:Static loc:Loc.Edit}">
                                            <materialDesign:PackIcon Kind="PencilOutline" Width="18" Height="18" Foreground="#8B5E4C" />
                                        </Button>
                                        <Button Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                auth:PermissionAssist.Required="Products.Delete"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                Width="32" Height="32" Padding="0" Margin="4,0,0,0" ToolTip="حذف">
                                            <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18" Foreground="#C62828" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
