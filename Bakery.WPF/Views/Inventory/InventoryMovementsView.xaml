<UserControl x:Class="Bakery.WPF.Views.InventoryMovementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:loc="clr-namespace:Bakery.Shared.Helpers;assembly=Bakery.Shared"
             FlowDirection="RightToLeft">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,14">
            <Button DockPanel.Dock="Left" Command="{Binding BackCommand}"
                    Style="{StaticResource InventoryBackButtonStyle}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowRight" Width="18" Height="18" Margin="0,0,6,0" />
                    <TextBlock Text="رجوع" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock Text="{x:Static loc:Loc.Movements}" Style="{StaticResource InventoryPageTitleStyle}" />
                <TextBlock Text="استعراض حركة الأصناف خلال الفترة المحددة"
                           Style="{StaticResource InventoryPageSubtitleStyle}" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="#FCFAF9" BorderBrush="#EEE9E6"
                BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" MinWidth="170" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <DatePicker Grid.Column="0" SelectedDate="{Binding FromDate}"
                            Style="{StaticResource ReportFilterDatePickerStyle}"
                            materialDesign:HintAssist.Hint="من تاريخ" Margin="0,0,8,0" />
                <DatePicker Grid.Column="1" SelectedDate="{Binding ToDate}"
                            Style="{StaticResource ReportFilterDatePickerStyle}"
                            materialDesign:HintAssist.Hint="إلى تاريخ" Margin="0,0,8,0" />
                <ComboBox Grid.Column="2" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                          DisplayMemberPath="Name" Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          materialDesign:HintAssist.Hint="{x:Static loc:Loc.HintItem}"
                          Height="48" Margin="0,0,8,0" />
                <ComboBox Grid.Column="3" ItemsSource="{Binding MovementTypes}"
                          SelectedItem="{Binding SelectedMovementType}"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          materialDesign:HintAssist.Hint="{x:Static loc:Loc.HintType}"
                          Height="48" Margin="0,0,8,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumToLocConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="4" Command="{Binding LoadCommand}"
                        Style="{StaticResource InventoryPrimaryButtonStyle}"
                        Content="{x:Static loc:Loc.Filter}" Height="48" MinWidth="92" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#EEE9E6"
                BorderThickness="1" CornerRadius="10">
            <DataGrid ItemsSource="{Binding Movements}" AutoGenerateColumns="False" IsReadOnly="True"
                      Style="{StaticResource InventoryDataGridStyle}">
                <DataGrid.Resources>
                    <Style x:Key="NumericCellStyle" TargetType="DataGridCell"
                           BasedOn="{StaticResource InventoryDataGridCellStyle}">
                        <Setter Property="FontFamily" Value="Consolas" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="FlowDirection" Value="LeftToRight" />
                        <Setter Property="HorizontalAlignment" Value="Center" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{x:Static loc:Loc.ColDate}" Binding="{Binding Date, StringFormat='yyyy/MM/dd HH:mm'}" Width="150" />
                    <DataGridTextColumn Header="{x:Static loc:Loc.ColCode}" Binding="{Binding ItemCode}" Width="100" />
                    <DataGridTextColumn Header="{x:Static loc:Loc.ColItem}" Binding="{Binding ItemName}" Width="*" />
                    <DataGridTextColumn Header="{x:Static loc:Loc.ColMovType}" Binding="{Binding Type, Converter={StaticResource EnumToLocConverter}}" Width="130" />
                    <DataGridTextColumn Header="{x:Static loc:Loc.ColQty}" Binding="{Binding Quantity, StringFormat='N2'}" CellStyle="{StaticResource NumericCellStyle}" MinWidth="100" />
                    <DataGridTextColumn Header="{x:Static loc:Loc.ColRunBalance}" Binding="{Binding RunningBalance, StringFormat='N2'}" CellStyle="{StaticResource NumericCellStyle}" MinWidth="120" />
                    <DataGridTextColumn Header="{x:Static loc:Loc.ColNotes}" Binding="{Binding Notes}" Width="220" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
