<UserControl x:Class="Bakery.WPF.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:loc="clr-namespace:Bakery.Shared.Helpers;assembly=Bakery.Shared"
             xmlns:auth="clr-namespace:Bakery.WPF.Authorization"
             FlowDirection="RightToLeft">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Left" Command="{Binding BackCommand}"
                    Style="{StaticResource InventoryBackButtonStyle}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowRight" Width="18" Height="18" Margin="0,0,6,0" />
                    <TextBlock Text="رجوع" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock Text="{x:Static loc:Loc.Inventory}" Style="{StaticResource InventoryPageTitleStyle}" />
                <TextBlock Text="{Binding Valuation, StringFormat=التقييم الحالي: {0:0.00}}"
                           Style="{StaticResource InventoryPageSubtitleStyle}" />
            </StackPanel>
        </DockPanel>

        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Command="{Binding RefreshCommand}" Style="{StaticResource InventorySecondaryButtonStyle}"
                    Margin="0,0,8,8" Content="{x:Static loc:Loc.Refresh}" />
            <Button Command="{Binding ItemsCommand}" Style="{StaticResource InventorySecondaryButtonStyle}"
                    Margin="0,0,8,8" Content="{x:Static loc:Loc.Items}"
                    auth:PermissionAssist.Required="Products.View" />
            <Button Command="{Binding UnitsCommand}" Style="{StaticResource InventorySecondaryButtonStyle}"
                    Margin="0,0,8,8" Content="{x:Static loc:Loc.Units}"
                    auth:PermissionAssist.Required="Products.View" />
            <Button Command="{Binding StockCountCommand}" Style="{StaticResource InventorySecondaryButtonStyle}"
                    Margin="0,0,8,8" Content="{x:Static loc:Loc.StockCount}"
                    auth:PermissionAssist.Required="Inventory.Count" />
            <Button Command="{Binding MovementsCommand}" Style="{StaticResource InventorySecondaryButtonStyle}"
                    Margin="0,0,8,8" Content="{x:Static loc:Loc.Movements}"
                    auth:PermissionAssist.Required="Inventory.View" />
            <Button Command="{Binding AdjustCommand}" Style="{StaticResource InventoryPrimaryButtonStyle}"
                    Margin="0,0,0,8" auth:PermissionAssist.Required="Inventory.StockAdjustments">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="PlusMinusVariant" Width="18" Height="18" Margin="0,0,7,0" />
                    <TextBlock Text="{x:Static loc:Loc.Adjustment}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </WrapPanel>

        <Border Grid.Row="2" Background="White" BorderBrush="#EEE9E6"
                BorderThickness="1" CornerRadius="10">
            <DataGrid ItemsSource="{Binding Stock}" AutoGenerateColumns="False" IsReadOnly="True"
                      Style="{StaticResource InventoryDataGridStyle}">
                <DataGrid.Resources>
                    <Style x:Key="NumericCellStyle" TargetType="DataGridCell"
                           BasedOn="{StaticResource InventoryDataGridCellStyle}">
                        <Setter Property="FontFamily" Value="Consolas" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="FlowDirection" Value="LeftToRight" />
                        <Setter Property="HorizontalAlignment" Value="Center" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{x:Static loc:Loc.ColCode}" Binding="{Binding Code}" Width="100" />
                    <DataGridTextColumn Header="{x:Static loc:Loc.ColItem}" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="{x:Static loc:Loc.ColUnit}" Binding="{Binding Unit}" Width="80" />
                    <DataGridTextColumn Header="{x:Static loc:Loc.ColQty}" Binding="{Binding Quantity, StringFormat='N2'}" CellStyle="{StaticResource NumericCellStyle}" MinWidth="110" />
                    <DataGridTextColumn Header="{x:Static loc:Loc.ColMin}" Binding="{Binding MinStockLevel, StringFormat='N2'}" CellStyle="{StaticResource NumericCellStyle}" MinWidth="110" />
                    <DataGridTextColumn Header="{x:Static loc:Loc.ColUnitCost}" Binding="{Binding UnitCost, StringFormat='N2'}" CellStyle="{StaticResource NumericCellStyle}" MinWidth="120" />
                    <DataGridTextColumn Header="{x:Static loc:Loc.ColValue}" Binding="{Binding Value, StringFormat='N2'}" CellStyle="{StaticResource NumericCellStyle}" MinWidth="120" />
                    <DataGridCheckBoxColumn Header="{x:Static loc:Loc.ColOut}" Binding="{Binding IsOutOfStock}" Width="80" />
                    <DataGridCheckBoxColumn Header="{x:Static loc:Loc.ColLow}" Binding="{Binding IsBelowMinimum}" Width="80" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
