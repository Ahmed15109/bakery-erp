<UserControl x:Class="Bakery.WPF.Views.InventoryHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:loc="clr-namespace:Bakery.Shared.Helpers;assembly=Bakery.Shared"
             xmlns:auth="clr-namespace:Bakery.WPF.Authorization"
             FlowDirection="RightToLeft">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="{x:Static loc:Loc.Inventory}" Style="{StaticResource InventoryPageTitleStyle}" />
            <TextBlock Text="إدارة الأصناف والمخزون" Style="{StaticResource InventoryPageSubtitleStyle}" />
        </StackPanel>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Metrics}" Margin="-6,0,-6,12">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border MinHeight="108" Padding="16" Margin="6"
                            Background="White" BorderBrush="#EEE9E6" BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="8" Background="#F3E8DF"
                                    VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="{Binding IconKind}" Width="22" Height="22"
                                                         Foreground="#8B5E4C"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="12" Foreground="#6B625D" />
                                <TextBlock Text="{Binding Value}" FontSize="22" FontWeight="Bold"
                                           Foreground="#2F2A27" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="2" Padding="16" Background="White"
                BorderBrush="#EEE9E6" BorderThickness="1" CornerRadius="10"
                VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="{x:Static loc:Loc.QuickActions}" FontSize="16" FontWeight="SemiBold"
                           Foreground="#2F2A27" Margin="0,0,0,12" />
                <UniformGrid Columns="4" Rows="1">
                    <Button Margin="0,0,0,0" Style="{StaticResource InventorySecondaryButtonStyle}"
                            Command="{Binding OpenItemsCommand}" auth:PermissionAssist.Required="Products.View">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PackageVariant" Width="20" Height="20" Margin="0,0,8,0" />
                            <TextBlock Text="{x:Static loc:Loc.Items}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Margin="8,0,0,0" Style="{StaticResource InventorySecondaryButtonStyle}"
                            Command="{Binding OpenUnitsCommand}" auth:PermissionAssist.Required="Products.View">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Ruler" Width="20" Height="20" Margin="0,0,8,0" />
                            <TextBlock Text="{x:Static loc:Loc.Units}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Margin="8,0,0,0" Style="{StaticResource InventorySecondaryButtonStyle}"
                            Command="{Binding OpenMovementsCommand}" auth:PermissionAssist.Required="Inventory.View">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="SwapHorizontal" Width="20" Height="20" Margin="0,0,8,0" />
                            <TextBlock Text="{x:Static loc:Loc.Movements}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Margin="8,0,0,0" Style="{StaticResource InventorySecondaryButtonStyle}"
                            Command="{Binding OpenStockCountCommand}" auth:PermissionAssist.Required="Inventory.Count">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ClipboardCheck" Width="20" Height="20" Margin="0,0,8,0" />
                            <TextBlock Text="{x:Static loc:Loc.StockCount}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
