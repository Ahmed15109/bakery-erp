<UserControl x:Class="Bakery.WPF.Views.StockCountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:loc="clr-namespace:Bakery.Shared.Helpers;assembly=Bakery.Shared"
             FlowDirection="RightToLeft">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,14">
            <Button DockPanel.Dock="Left" Command="{Binding BackCommand}"
                    Style="{StaticResource InventoryBackButtonStyle}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowRight" Width="18" Height="18" Margin="0,0,6,0" />
                    <TextBlock Text="رجوع" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock Text="{x:Static loc:Loc.StockCount}" Style="{StaticResource InventoryPageTitleStyle}" />
                <TextBlock Text="مطابقة الكميات الفعلية مع أرصدة النظام"
                           Style="{StaticResource InventoryPageSubtitleStyle}" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="#FCFAF9" BorderBrush="#EEE9E6"
                BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding Notes}" Style="{StaticResource InventoryFormTextBoxStyle}"
                         materialDesign:HintAssist.Hint="{x:Static loc:Loc.HintNotes}"
                         MaxWidth="460" HorizontalAlignment="Stretch" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                    <Button Command="{Binding StartCommand}" Style="{StaticResource InventorySecondaryButtonStyle}"
                            Content="{x:Static loc:Loc.Start}" MinWidth="96" Margin="0,0,8,0" />
                    <Button Command="{Binding CompleteCommand}" Style="{StaticResource InventoryPrimaryButtonStyle}"
                            Content="{x:Static loc:Loc.Complete}" MinWidth="96" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#EEE9E6"
                BorderThickness="1" CornerRadius="10">
            <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False"
                      Style="{StaticResource InventoryDataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{x:Static loc:Loc.ColCode}" Binding="{Binding ItemCode}" IsReadOnly="True" Width="120" />
                    <DataGridTextColumn Header="{x:Static loc:Loc.ColItem}" Binding="{Binding ItemName}" IsReadOnly="True" Width="*" />
                    <DataGridTextColumn Header="{x:Static loc:Loc.ColUnit}" Binding="{Binding Unit}" IsReadOnly="True" Width="90" />
                    <DataGridTextColumn Header="{x:Static loc:Loc.ColSystem}" Binding="{Binding SystemQuantity}" IsReadOnly="True" Width="110" />
                    <DataGridTextColumn Header="{x:Static loc:Loc.ColPhysical}" Binding="{Binding PhysicalQuantity}" Width="120" />
                    <DataGridTextColumn Header="{x:Static loc:Loc.ColVariance}" Binding="{Binding VarianceQuantity}" IsReadOnly="True" Width="120" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
