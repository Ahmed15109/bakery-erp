<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:Bakery.WPF.Helpers"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!--  Color tokens -->
    <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="#6D4C41" />
    <SolidColorBrush x:Key="PrimaryHueDarkBrush" Color="#4E342E" />
    <SolidColorBrush x:Key="AccentColorBrush" Color="#D97706" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#2F2A27" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#F7F3EF" />

   
    <FontFamily x:Key="ArabicFont">Segoe UI, Arial Unicode MS</FontFamily>

    <!-- Sidebar button -->
    <Style x:Key="SidebarButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
        <Setter Property="Height" Value="50" />
        <Setter Property="Margin" Value="12,2" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="#D6C8BE" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="{StaticResource ArabicFont}" />
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="12" />
        <Style.Triggers>
            <!-- Parent item subtle active state when a sub-item is selected -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsSelected}" Value="False" />
                    <Condition Binding="{Binding IsSubItemSelected}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="#382C26" />
                <Setter Property="Foreground" Value="#F2E6DF" />
            </MultiDataTrigger>
            <!-- Directly selected main item -->
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="#8B5E4C" />
                <Setter Property="Foreground" Value="White" />
            </DataTrigger>
            <!-- Mouse hover -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsSelected}" Value="False" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="#42332C" />
                <Setter Property="Foreground" Value="White" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!--Sidebar Sub-item button -->
    <Style x:Key="SidebarSubItemButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
        <Setter Property="Height" Value="38" />
        <!-- Margin in RTL  -->
        <Setter Property="Margin" Value="38,2,12,2" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="#C0B2A8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontFamily" Value="{StaticResource ArabicFont}" />
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="10" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="#8B5E4C" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsSelected}" Value="False" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="#3D2F29" />
                <Setter Property="Foreground" Value="White" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- DataGrid column header -->
    <Style x:Key="RtlDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader"
           BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="FontFamily" Value="{StaticResource ArabicFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Global DataGrid -->
    <Style x:Key="RtlDataGridCellStyle" TargetType="DataGridCell"
           BasedOn="{StaticResource MaterialDesignDataGridCell}">
        <Setter Property="FontFamily" Value="{StaticResource ArabicFont}" />
    </Style>

    <!-- Inventory module styles -->
    <Style x:Key="InventoryPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ArabicFont}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#2F2A27" />
    </Style>

    <Style x:Key="InventoryPageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ArabicFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#6B625D" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <Style x:Key="InventoryPrimaryButtonStyle" TargetType="Button"
           BasedOn="{StaticResource MaterialDesignRaisedButton}">
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Background" Value="{StaticResource PrimaryHueMidBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryHueMidBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="{StaticResource ArabicFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8" />
    </Style>

    <Style x:Key="InventorySecondaryButtonStyle" TargetType="Button"
           BasedOn="{StaticResource MaterialDesignOutlinedButton}">
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryHueMidBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryHueMidBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource ArabicFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8" />
    </Style>

    <Style x:Key="InventoryBackButtonStyle" TargetType="Button"
           BasedOn="{StaticResource InventorySecondaryButtonStyle}">
        <Setter Property="MinWidth" Value="88" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <Style x:Key="InventoryFormTextBoxStyle" TargetType="TextBox"
           BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
        <Setter Property="Height" Value="48" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource ArabicFont}" />
    </Style>

    <Style x:Key="InventoryDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader"
           BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
        <Setter Property="Background" Value="#F7F4F2" />
        <Setter Property="Foreground" Value="#5F5752" />
        <Setter Property="FontFamily" Value="{StaticResource ArabicFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="BorderBrush" Value="#E9E4E1" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style x:Key="InventoryDataGridCellStyle" TargetType="DataGridCell"
           BasedOn="{StaticResource MaterialDesignDataGridCell}">
        <Setter Property="FontFamily" Value="{StaticResource ArabicFont}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="InventoryDataGridRowStyle" TargetType="DataGridRow"
           BasedOn="{StaticResource MaterialDesignDataGridRow}">
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                <Setter Property="Background" Value="#FCFAF9" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#F3EEEB" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="InventoryDataGridStyle" TargetType="DataGrid"
           BasedOn="{StaticResource MaterialDesignDataGrid}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="#EEE9E6" />
        <Setter Property="RowHeight" Value="42" />
        <Setter Property="ColumnHeaderHeight" Value="38" />
        <Setter Property="AlternationCount" Value="2" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource InventoryDataGridColumnHeaderStyle}" />
        <Setter Property="CellStyle" Value="{StaticResource InventoryDataGridCellStyle}" />
        <Setter Property="RowStyle" Value="{StaticResource InventoryDataGridRowStyle}" />
    </Style>

    <!--  High Contrast Filter Controls  -->
    <Style x:Key="HighContrastFilterTextBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
        <Setter Property="Foreground" Value="#2F2A27" />
    </Style>

    <Style x:Key="HighContrastFilterComboBox" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
        <Setter Property="Foreground" Value="#2F2A27" />
        <Style.Resources>
            <!-- Ensure editable text inherits Foreground -->
            <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
                <Setter Property="Foreground" Value="#2F2A27" />
            </Style>
        </Style.Resources>
    </Style>

    <Style x:Key="HighContrastFilterDatePicker" TargetType="DatePicker" BasedOn="{StaticResource MaterialDesignOutlinedDatePicker}">
        <Setter Property="Foreground" Value="#2F2A27" />
    </Style>

    <!-- Shared report date filter -->
    <Style x:Key="ReportFilterDatePickerStyle"
           TargetType="DatePicker"
           BasedOn="{StaticResource HighContrastFilterDatePicker}">
        <Style.Resources>
            <!-- The DatePicker template resolves this key for its internal DatePickerTextBox -->
            <Style x:Key="NestedTextBoxStyle"
                   TargetType="{x:Type DatePickerTextBox}"
                   BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                <Setter Property="Foreground" Value="#2F2A27" />
                <Setter Property="FontFamily" Value="{StaticResource ArabicFont}" />
                <Setter Property="FontSize" Value="13" />
                <!-- Keep the outer DatePicker RTL -->
                <Setter Property="FlowDirection" Value="LeftToRight" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="UseLayoutRounding" Value="True" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
                <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
                <Setter Property="materialDesign:HintAssist.HintOpacity" Value="0.72" />
                <Setter Property="materialDesign:HintAssist.Foreground" Value="#7A716C" />
                <Setter Property="materialDesign:TextFieldAssist.TextBoxViewMargin" Value="0" />
                <Setter Property="materialDesign:TextFieldAssist.TextBoxViewVerticalAlignment" Value="Center" />
            </Style>
        </Style.Resources>
        <Setter Property="Height" Value="48" />
        <!-- Left padding reserves the physical RTL -->
        <Setter Property="Padding" Value="30,10,12,10" />
        <Setter Property="Foreground" Value="#2F2A27" />
        <Setter Property="FontFamily" Value="{StaticResource ArabicFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FlowDirection" Value="RightToLeft" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
        <Setter Property="materialDesign:HintAssist.HintOpacity" Value="0.72" />
        <Setter Property="materialDesign:HintAssist.Foreground" Value="#7A716C" />
        <Setter Property="materialDesign:TextFieldAssist.TextBoxViewMargin" Value="0" />
        <Setter Property="materialDesign:TextFieldAssist.TextBoxViewVerticalAlignment" Value="Center" />
        <Setter Property="helpers:DatePickerHintAssist.ShowHintOnlyWhenEmpty" Value="True" />
    </Style>

</ResourceDictionary>
