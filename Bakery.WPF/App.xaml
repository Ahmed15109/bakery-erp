<Application x:Class="Bakery.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary xmlns:conv="clr-namespace:Bakery.WPF.Converters">
                    <conv:EnumToLocConverter x:Key="EnumToLocConverter" />
                    <conv:FileSizeConverter x:Key="FileSizeConverter" />
                    <conv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
                    <conv:AmountToBrushConverter x:Key="AmountToBrushConverter" />
                    <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
                    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
                    <conv:BooleanToStatusConverter x:Key="BooleanToStatusConverter" />
                    <conv:BooleanToActiveIconConverter x:Key="BooleanToActiveIconConverter" />
                    <conv:StringToInitialConverter x:Key="StringToInitialConverter" />
                    <conv:BalanceToBrushConverter x:Key="BalanceToBrushConverter" />
                    <conv:PartyBalanceToBrushConverter x:Key="PartyBalanceToBrushConverter" />
                    <conv:PartyTypeToBrushConverter x:Key="PartyTypeToBrushConverter" />
                    <conv:BalanceToStringConverter x:Key="BalanceToStringConverter" />
                    <conv:PartyBalanceToStringConverter x:Key="PartyBalanceToStringConverter" />
                    <conv:FlexibleDecimalConverter x:Key="FlexibleDecimalConverter" />
                    <conv:CurrencyConverter x:Key="CurrencyConverter" />
                    <conv:DateOnlyToDateTimeConverter x:Key="DateOnlyToDateTimeConverter" />
                </ResourceDictionary>

                <!-- Step 1: MaterialDesign color tokens (primary/secondary palette) -->
                <materialDesign:BundledTheme
                    BaseTheme="Light"
                    PrimaryColor="Brown"
                    SecondaryColor="Amber" />

                <!-- Step 2: MaterialDesign control styles (MaterialDesignRaisedButton, etc.) -->
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />

                <!-- Step 3: App-specific overrides — must come AFTER MD styles so BasedOn resolves -->
                <ResourceDictionary Source="/Bakery.WPF;component/Styles/AppTheme.xaml"/>

            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

</Application>
